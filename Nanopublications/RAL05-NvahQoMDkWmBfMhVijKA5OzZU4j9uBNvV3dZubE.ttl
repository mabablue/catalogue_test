@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAL05-NvahQoMDkWmBfMhVijKA5OzZU4j9uBNvV3dZubE/> .

<https://w3id.org/iadopt/variable/MorphologicalTransformation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Morphological transformation",
        "morphological transformation of cells" ;
    dcterms:description "the alteration of normal cell shape, structure, and growth pattern associated with cellular transformation." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:morphologicaltransformation .

