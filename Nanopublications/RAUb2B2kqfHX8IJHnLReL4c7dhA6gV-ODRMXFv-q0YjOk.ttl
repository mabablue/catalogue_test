@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAUb2B2kqfHX8IJHnLReL4c7dhA6gV-ODRMXFv-q0YjOk/> .

<https://w3id.org/iadopt/variable/MotorActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Motor Activity",
        "motor activity in exposed animal" ;
    dcterms:description "the measurement of spontaneous movement or locomotor behavior used to assess neurological function and neurotoxicity." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D009043> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:motorActivityLevel .

