@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAsuN78X6Q7oZ2TX4KCxewLwYj_HqIlg8THObsSxtyVbI/> .

<https://w3id.org/iadopt/variable/SoilPorewaterExposure> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Soil porewater exposure",
        "soil porewater exposure method" ;
    dcterms:description "the exposure to a substance via the aqueous phase present within soil pores." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:ExposureMethod .

