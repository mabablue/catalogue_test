@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAET5UkTJi_ZxYFw212eS_h8WUwixxoPkzPrakvb9Q_UU/> .

<https://w3id.org/iadopt/variable/UV–VisSpectrum> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "UV–Vis spectrum",
        "UV–Vis spectrum of substance" ;
    dcterms:description "A spectrum that contains wavelength values that correspond to ultraviolet (UV) and visible (VIS) light properties." ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:SpectralAbsorbance .

