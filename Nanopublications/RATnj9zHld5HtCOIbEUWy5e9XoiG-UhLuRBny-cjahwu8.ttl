@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATnj9zHld5HtCOIbEUWy5e9XoiG-UhLuRBny-cjahwu8/> .

<https://w3id.org/iadopt/variable/VolumeofDistribution> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Volume of distribution",
        "volume of distribution of test substance" ;
    dcterms:description "The amount of drug in the body divided by its concentration in the blood." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1524> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:volumeofdistribution .

