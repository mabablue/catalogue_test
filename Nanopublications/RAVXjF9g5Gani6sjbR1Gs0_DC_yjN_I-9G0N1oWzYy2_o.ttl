@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAVXjF9g5Gani6sjbR1Gs0_DC_yjN_I-9G0N1oWzYy2_o/> .

<https://w3id.org/iadopt/variable/Mortality> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Mortality",
        "mortality in exposed organisms" ;
    dcterms:description "Quantification of the number of deaths in a population." ;
    rdfs:seeAlso <http://www.ebi.ac.uk/efo/EFO_0004352> ;
    iop:hasObjectOfInterest sub:testorganism ;
    iop:hasProperty sub:mortality .

