sub:Ex3.Gr5 a iop:Variable ;
    rdfs:label "Dose range where chemical affects differentiation of neuroblastoma cells" ;
    dcterms:description "The dose range (low-high, mg/mL) over which a chemical affects cell differentiation of neuroblastoma cells" ;
