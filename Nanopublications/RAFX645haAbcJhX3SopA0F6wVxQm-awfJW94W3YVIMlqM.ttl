@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAFX645haAbcJhX3SopA0F6wVxQm-awfJW94W3YVIMlqM/> .

<https://w3id.org/iadopt/variable/ThermalStabilityWindow> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Thermal stability window" ;
    dcterms:description "the temperature range over which a material remains chemically and structurally stable without undergoing significant decomposition or irreversible chemical change." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:ThermalStabilityWindow .

