@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATnT1tzPCrLdGKsVBVyFD8zcr--jSVWl6_7M00EeFwKc/> .

<https://w3id.org/iadopt/variable/OrganWeights> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Organ weights",
        "organ weights in exposed animal" ;
    dcterms:description "the measured mass of specific organs collected from organisms following exposure to a substance, used to detect toxic effects." ;
    rdfs:seeAlso <http://sbmi.uth.tmc.edu/ontology/ochv#C0029218> ;
    iop:hasObjectOfInterest sub:organ ;
    iop:hasProperty sub:OrganWeight .

