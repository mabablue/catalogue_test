@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAUchlkiZcGrUWQ-1AYIISB9xXONrivD--7xyAEVaQZbc/> .

<https://w3id.org/iadopt/variable/MLSubset> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Machine learning subset" ;
    dcterms:description "Randomly dividing a dataset into training and test sets for predictive model development" ;
    iop:hasObjectOfInterest sub:Subset ;
    iop:hasProperty sub:MLSubset .

