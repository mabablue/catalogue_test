<https://w3id.org/iadopt/variable/ZeaMays> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Zea mays" ;
    dcterms:description "Zea species that are thought to be ancestors and probable progenitors to corn. A plant species of the family POACEAE. It is a tall grass grown for its EDIBLE GRAIN, corn, used as food and animal FODDER." ;
