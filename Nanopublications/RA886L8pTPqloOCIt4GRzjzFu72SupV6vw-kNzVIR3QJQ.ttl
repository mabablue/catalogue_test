<https://w3id.org/iadopt/variable/D50> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average first hex parameter of the shell atoms" ;
    dcterms:description "D50: The average first hex parameter of the shell atoms" ;
    iop:hasObjectOfInterest sub:Nanoparticle ;
    iop:hasProperty sub:FirstHexShell .

