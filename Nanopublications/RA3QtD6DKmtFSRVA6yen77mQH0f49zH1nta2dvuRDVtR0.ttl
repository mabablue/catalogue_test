<https://w3id.org/iadopt/variable/D48> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average first hex parameter of all atoms" ;
    dcterms:description "D48: The average first hex parameter of all atoms" ;
    iop:hasObjectOfInterest sub:Nanoparticle ;
    iop:hasProperty sub:FirstHex .

