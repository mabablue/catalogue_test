@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGrUDQFmScUYHPYNyAw7Gw9kCYPteAYhUsDqCqxmJ_wI/> .

<https://w3id.org/iadopt/variable/DataCompletenesScore> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Data completeness score" ;
    dcterms:description "A number or range of numeric values measuring performance, function, quality, or ability describing the degree to which all required measurements are known. Values may be designated as missing in order not to have empty cells, or missing values may be replaced with default or interpolated values. In the case of default or interpolated values, these must be flagged as such to distinguish them from actual measurements or observations. Missing, default, or interpolated values do not imply that the dataset has been made complete" ;
    iop:hasObjectOfInterest sub:Data ;
    iop:hasProperty <http://purl.obolibrary.org/obo/T4FS_0000191> .

