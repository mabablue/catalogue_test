<https://w3id.org/iadopt/variable/LepidiumSativum> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Lepidium sativum" ;
    dcterms:description "A plant species of the genus LEPIDIUM, family BRASSICACEAE that is a fast-growing, often weedy native of western Asia. It is widely grown, especially in its curl-leaved form, and used as a garnish" ;
