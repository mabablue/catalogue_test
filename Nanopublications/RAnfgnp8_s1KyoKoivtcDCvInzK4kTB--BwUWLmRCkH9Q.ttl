@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAnfgnp8_s1KyoKoivtcDCvInzK4kTB--BwUWLmRCkH9Q/> .

<https://w3id.org/iadopt/variable/DataGapFillingProcess> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Data gap filling process" ;
    iop:hasObjectOfInterest sub:Data ;
    iop:hasProperty sub:GapFillingProcess .

