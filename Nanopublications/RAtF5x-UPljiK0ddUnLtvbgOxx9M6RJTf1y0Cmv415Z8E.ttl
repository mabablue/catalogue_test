@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAtF5x-UPljiK0ddUnLtvbgOxx9M6RJTf1y0Cmv415Z8E/> .

<https://w3id.org/iadopt/variable/NetworkActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Network activity",
        "network activity in neuronal cultures" ;
    dcterms:description "the coordinated electrical signaling and functional connectivity among interconnected neuronal cells." ;
    iop:hasObjectOfInterest sub:neuronalNetwork ;
    iop:hasProperty sub:networkActivity .

