<https://w3id.org/iadopt/variable/Particle-inducedfibrosis> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Particle-induced fibrosis",
        "particle-induced fibrosis in exposed organism" ;
    dcterms:description "the formation of excess fibrous connective tissue in organs following exposure to particulate materials." ;
    iop:hasObjectOfInterest <https://w3id.org/np/RAK1mh65bW-iy3QDy8AZkt7_W7S84A2-2xqXPQgJWy8qQ/organism/tissue> ;
    iop:hasProperty sub:Particle-inducedfibrosisResponse .

