@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAcPCxIl6UYYAfxPeXgYcEOkDkY_cK6sLLCgvzK-rQ0Ec/> .

<https://w3id.org/iadopt/variable/GrainSize> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Grain size",
        "grain size of material" ;
    dcterms:description "the characteristic size of individual crystalline domains in a polycrystalline material." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:GrainSize .

