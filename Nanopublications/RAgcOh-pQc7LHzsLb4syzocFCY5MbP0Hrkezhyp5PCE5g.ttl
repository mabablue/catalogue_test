@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAgcOh-pQc7LHzsLb4syzocFCY5MbP0Hrkezhyp5PCE5g/> .

<https://w3id.org/iadopt/variable/Resorptions> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Resorptions",
        "resorptions in exposed animal" ;
    dcterms:description "the loss of implanted embryos or fetuses during pregnancy, indicated by resorbed implantation sites in the uterus." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C124637> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:resorptionIncidence .

