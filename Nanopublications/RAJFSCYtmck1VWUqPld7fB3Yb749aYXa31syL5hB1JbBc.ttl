@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAJFSCYtmck1VWUqPld7fB3Yb749aYXa31syL5hB1JbBc/> .

<https://w3id.org/iadopt/variable/MolecularWeight> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Molecular weight",
        "The weight of atoms in a molecule" ;
    dcterms:description "The sum of the weight of all the atoms in a molecule." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D008970> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:MolecularWeight .

