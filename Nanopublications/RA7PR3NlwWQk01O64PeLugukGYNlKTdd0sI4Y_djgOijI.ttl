@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA7PR3NlwWQk01O64PeLugukGYNlKTdd0sI4Y_djgOijI/> .

<https://w3id.org/iadopt/variable/Purity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Purity",
        "purity of substance" ;
    dcterms:description "A quantitative assessment of the homogeneity or uniformity of a mixture. Alternatively, purity refers to the degree of being free of contaminants or heterogeneous components." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C62352> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:purity .

