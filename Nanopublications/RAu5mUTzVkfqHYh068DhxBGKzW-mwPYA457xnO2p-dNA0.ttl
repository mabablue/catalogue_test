<https://w3id.org/iadopt/variable/SurfaceCoating> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Coating",
        "Surface coating" ;
    dcterms:description "A texture quality that exists through a liquid cover on the surface of the bearer" ;
    iop:hasObjectOfInterest sub:NP ;
    iop:hasProperty <http://purl.obolibrary.org/obo/PATO_0002012> .

