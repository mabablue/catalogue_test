@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAj6QqaANxf0gzpLbksw7bMKQyrkJDWnB3UQFuwlPkK0Q/> .

<https://w3id.org/iadopt/variable/ReadyBiodegradability> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Ready biodegradability",
        "ready biodegradability of substance" ;
    dcterms:description "a classification describing the extent and rate at which a chemical substance is readily degraded by microorganisms under standardized test conditions." ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:ReadyBiodegradability .

