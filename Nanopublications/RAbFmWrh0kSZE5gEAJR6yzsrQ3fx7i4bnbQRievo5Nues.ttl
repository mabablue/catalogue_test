@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbFmWrh0kSZE5gEAJR6yzsrQ3fx7i4bnbQRievo5Nues/> .

<https://w3id.org/iadopt/variable/MetalMetalloidNo> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Total number of metals and metalloids" ;
    dcterms:description "Pertaining to an entirety or whole, also constituting the full quantity or extent, of electropositive chemical elements that are not characterised by ductility, malleability, luster, and conductance of heat and electricity, in addition to chemical elements with properties between a metal and a non-metal , that are exerting influence or producing an effect" ;
    iop:hasObjectOfInterest sub:MetalMetalloid ;
    iop:hasProperty sub:Atoms .

