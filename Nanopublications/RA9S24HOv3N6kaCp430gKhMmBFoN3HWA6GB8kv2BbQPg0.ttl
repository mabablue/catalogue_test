@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA9S24HOv3N6kaCp430gKhMmBFoN3HWA6GB8kv2BbQPg0/> .

<https://w3id.org/iadopt/variable/ColloidalStabilityOverTime> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Colloidal stability over time",
        "colloidal stability of material over time" ;
    dcterms:description "the ability of a suspension to retain a stable particle distribution and avoid aggregation or sedimentation." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:ColloidalStability .

