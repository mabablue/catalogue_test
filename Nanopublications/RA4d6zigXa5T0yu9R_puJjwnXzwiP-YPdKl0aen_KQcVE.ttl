@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA4d6zigXa5T0yu9R_puJjwnXzwiP-YPdKl0aen_KQcVE/> .

<https://w3id.org/iadopt/variable/DNAsynthesis> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "DNA synthesis",
        "DNA synthesis rate in cells" ;
    dcterms:description "the replication of cellular DNA during the cell cycle, used as an indicator of cell proliferation." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C18125> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:DNASynthesisRate .

