@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RACF_320nCkFbmjlYMxLBe-DgjZgl2ZLQcCvYR1Y7JLic/> .

<https://w3id.org/iadopt/variable/Soilmoisture(θ)> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Soil moisture (θ)",
        "soil moisture of growing medium" ;
    dcterms:description "the amount of water contained in soil, typically expressed as volumetric or gravimetric water content" ;
    rdfs:seeAlso <http://purl.org/obo/owlEOL_0001814> ;
    iop:hasObjectOfInterest sub:soil ;
    iop:hasProperty sub:SoilWaterContent .

