@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA75OxnmIyOeCjGCdC-i2DdxGx499cF5Itlrgy6OVfn5A/> .

<https://w3id.org/iadopt/variable/AspectRatio> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Aspect ratio",
        "aspect ratio of material" ;
    dcterms:description "The ratio between the longest and shortest dimension of an object." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1365> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:AspectRatio .

