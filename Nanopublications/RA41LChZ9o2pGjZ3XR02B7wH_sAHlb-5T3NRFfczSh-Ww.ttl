@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA41LChZ9o2pGjZ3XR02B7wH_sAHlb-5T3NRFfczSh-Ww/> .

<https://w3id.org/iadopt/variable/ChromosomalAberrations> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Chromosomal aberrations",
        "chromosomal aberrations in plant cells" ;
    dcterms:description "Abnormal number or structure of chromosomes." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/MESH_D002869> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:ChromosomalAberrationFrequency .

