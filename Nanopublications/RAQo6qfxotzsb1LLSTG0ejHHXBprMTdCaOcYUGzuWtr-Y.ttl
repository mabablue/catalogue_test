@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAQo6qfxotzsb1LLSTG0ejHHXBprMTdCaOcYUGzuWtr-Y/> .

<https://w3id.org/iadopt/variable/Spleen/thymusWeight> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Spleen/thymus weight",
        "spleen/thymus weight in exposed animal" ;
    dcterms:description "the measured mass of the spleen and thymus, used as an indicator of immune system status and immunotoxic effects." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/CMO_0000147> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:lymphoidOrganWeight .

