@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAaMkzj9MX5gzSJNojgHCj4A79ylYvC5Vj8erOKRF_uUI/> .

<https://w3id.org/iadopt/variable/ProliferationIndex> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Proliferation index",
        "proliferation index of cells" ;
    dcterms:description "a quantitative measure of the rate or extent of cell division within a cell population." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/201106018896552229> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:proliferationindex .

