sub:assertion {
  <https://w3id.org/iadopt/variable/MordredDescriptors> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "Mordred descriptors are a set of 1,826 molecular descriptors generated by the Mordred Python library, which is widely used for cheminformatics and QSAR/QSPR modelling. Mordred descriptors are numerical values that encode a wide range of chemical and structural properties of molecules";
    rdfs:label "Mordred descriptors";
    rdfs:seeAlso <https://doi.org/10.1186/s13321-018-0258-y>;
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:Chemicals;
    <https://w3id.org/iadopt/ont/hasProperty> <https://mordred-descriptor.github.io/documentation/master/descriptors.html> .
}

