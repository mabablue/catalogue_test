@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAFRHhjqHcZJ41M0y7OHVFDy_0lrnPaqz5DzVRdxG9TDQ/> .

<https://w3id.org/iadopt/variable/IsoelectricPoint> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Isoelectric point",
        "isoelectric point of material" ;
    dcterms:description "The pH at which a particular molecule or surface carries no net electrical charge." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1204> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:IsoelectricPoint .

