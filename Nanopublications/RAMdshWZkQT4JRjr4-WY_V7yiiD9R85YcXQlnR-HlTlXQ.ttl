@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAMdshWZkQT4JRjr4-WY_V7yiiD9R85YcXQlnR-HlTlXQ#> .

<http://www.groupA.org/iadopt/challvar1> a iop:Variable ;
    rdfs:label "solar wind electron density" ;
    iop:hasConstraint sub:location ;
    iop:hasMatrix sub:solar_wind ;
    iop:hasObjectOfInterest sub:electron ;
    iop:hasProperty sub:number_density .

sub:location a iop:Constraint ;
    iop:constrains sub:solar_wind .

