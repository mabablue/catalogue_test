@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAf78HfaCPsGCUp-wbD2fZSu_Aveviql-ofsWBfYbTtcE/> .

<https://w3id.org/iadopt/variable/TranslocationFactor> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Translocation factor (TF)",
        "translocation factor of test substance" ;
    dcterms:description "the ratio of a substance’s concentration in the shoot to its concentration in the root" ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:TranslocationFactor .

