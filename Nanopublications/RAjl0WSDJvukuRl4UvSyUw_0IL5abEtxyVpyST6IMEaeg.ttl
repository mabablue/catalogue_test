@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAjl0WSDJvukuRl4UvSyUw_0IL5abEtxyVpyST6IMEaeg/> .

<https://w3id.org/iadopt/variable/VanderWaalsRadiusMetalloid> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Van der Waal radius of active metalloid" ;
    dcterms:description "Half of the equilibrium distance at the minimum of the van der Waals potential between two isolated atoms of chemical elements that are exerting influence or producing an effect and are elements with properties between a metal and a non-metal" ;
    iop:hasObjectOfInterest sub:Metalloid ;
    iop:hasProperty sub:VanderWaalsRadius .

