      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "the lowest temperature at which a material will ignite and sustain combustion in the absence of a spark or flame.";
    rdfs:label "Auto-ignition temperature", "auto-ignition temperature of substance";
    rdfs:seeAlso <https://www.sciencedirect.com/topics/chemistry/autoignition-temperature#:~:text=Autoignition%20temperature%20is%20defined%20as,of%20a%20spark%20or%20flame.&text=How%20useful%20is%20this%20definition?>;
