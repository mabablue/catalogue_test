    rdfs:label "The average second hex parameter of the core atoms" ;
    dcterms:description "D52: The average second hex parameter of the core atoms" ;
    iop:hasObjectOfInterest sub:Nanoparticle ;
    iop:hasProperty sub:SecondHexCore .

