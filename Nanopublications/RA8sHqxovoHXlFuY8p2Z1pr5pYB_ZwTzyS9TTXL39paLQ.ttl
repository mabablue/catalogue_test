@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA8sHqxovoHXlFuY8p2Z1pr5pYB_ZwTzyS9TTXL39paLQ/> .

<https://w3id.org/iadopt/variable/ErC₅₀> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "ErC₅₀ (growth rate)",
        "ErC₅₀ (growth rate) of plant" ;
    dcterms:description "the concentration of a substance that causes a 50% reduction in the growth rate of an organism compared to an untreated control." ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:growthrate .

