@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RALu3rnvMEaM1BZcEzcgbmAdTCfZBH9ReXfbRCZ5M4qPk/> .

<https://w3id.org/iadopt/variable/ImmuneCellSubsets> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Immune cell subsets",
        "immune cell subsets in exposed animal" ;
    dcterms:description "A classification of lymphocytes based on structurally or functionally different populations of cells" ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D016131> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:immunecellsubsetcomposition .

