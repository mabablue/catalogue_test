@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAP9nF3SErOXXgDfCOQj_piUUx33piIW5Qktyl2R4nPlA/> .

<https://w3id.org/iadopt/variable/PhysicalForm> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Physical form",
        "physical form of substance" ;
    dcterms:description "The overall appearance, configuration, or shape, derived from material characteristics and independent of intellectual content." ;
    rdfs:seeAlso <https://dictionary.archivists.org/entry/physical-form.html#:~:text=n.,and%20independent%20of%20intellectual%20content.> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:PhysicalForm .

