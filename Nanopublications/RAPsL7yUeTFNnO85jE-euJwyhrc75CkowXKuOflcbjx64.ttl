@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAPsL7yUeTFNnO85jE-euJwyhrc75CkowXKuOflcbjx64/> .

<https://w3id.org/iadopt/variable/pKb> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "pKb",
        "pKb of substance" ;
    dcterms:description "the negative base-10 logarithm of a solution's base dissociation constant (Kb)" ;
    rdfs:seeAlso <http://www.bioassayontology.org/bao#BAO_0190006> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:pKb .

