@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA1SQx4zUVYwFpnjQDRyUUpbkXwLgm1bPoU91VtMSp3Jo/> .

<https://w3id.org/iadopt/variable/AssayInterferenceCheck> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Assay interference check",
        "assay interference by test substance" ;
    dcterms:description "the assessment of substance effects on assay performance." ;
    iop:hasObjectOfInterest sub:assaySystem ;
    iop:hasProperty sub:assayInterference .

