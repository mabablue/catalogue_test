@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAuiodA0n1agB6c6GHpbcvtgoX_4Xk_blzm2zxHxn8_0w/> .

<https://w3id.org/iadopt/variable/ThermalConductivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Thermal conductivity" ;
    dcterms:description "the thermophysical property of a material that quantifies its ability to conduct heat." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty <http://materialsmine.org/ns/ThermalConductivity> .

