@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAo3iZlGUXxugpoSyngCpWNbDJwmCRHlbHlM13okd2TFs/> .

<https://w3id.org/iadopt/variable/Necrosis> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Necrosis",
        "necrosis level in cells" ;
    dcterms:description "an uncontrolled form of cell death characterized by loss of membrane integrity, cellular swelling, and release of intracellular contents." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D009336> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:necrosislevel .

