@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAMQLCGwvAg21SA9JLOQcS05iUCoUM3BPZwHC-2Zak9J0/> .

<https://w3id.org/iadopt/variable/SedimentationRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Sedimentation rate",
        "sedimentation rate of material" ;
    dcterms:description "the speed at which particles in a colloidal suspension or dispersion settle under the influence of gravity or centrifugal forces." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:SedimentationRate .

