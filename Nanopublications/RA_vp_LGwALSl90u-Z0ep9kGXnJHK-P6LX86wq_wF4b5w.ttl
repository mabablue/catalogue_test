@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA_vp_LGwALSl90u-Z0ep9kGXnJHK-P6LX86wq_wF4b5w/> .

<https://w3id.org/iadopt/variable/PhysicalStateAt20°C> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Physical state at 20°C",
        "physical state of substance" ;
    dcterms:description "The indication that a chemical form is solid, liquid, or gas at 20°C." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C73487> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:PhysicalState .

