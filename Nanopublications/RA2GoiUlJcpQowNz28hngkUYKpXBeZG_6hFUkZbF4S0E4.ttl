@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2GoiUlJcpQowNz28hngkUYKpXBeZG_6hFUkZbF4S0E4/> .

<https://w3id.org/iadopt/variable/Bioaccumulation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Bioaccumulation",
        "bioaccumulation of test substance" ;
    dcterms:description "the uptake and retention of a substance in an organism over time, resulting in higher internal concentrations than in the surrounding environment." ;
    iop:hasObjectOfInterest sub:organism ;
    iop:hasProperty sub:bioaccumulationFactor .

