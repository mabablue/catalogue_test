@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RACqb8f5xz_WajAhP3hJuIJgRFpdonV_Ghpk4cery4QLk/> .

<https://w3id.org/iadopt/variable/BodyWeight> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Body weight",
        "body weight in exposed invertebrate organism" ;
    dcterms:description "Body weight is the mass of an organism, used to assess growth, health status, and potential toxic effects on metabolism or development." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D001835> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:BodyWeight .

