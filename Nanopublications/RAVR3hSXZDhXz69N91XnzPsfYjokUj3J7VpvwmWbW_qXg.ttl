@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAVR3hSXZDhXz69N91XnzPsfYjokUj3J7VpvwmWbW_qXg/> .

<https://w3id.org/iadopt/variable/SizeUVVis> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Nanomaterial size measured with UV-Vis" ;
    iop:hasObjectOfInterest sub:Nanomaterial ;
    iop:hasProperty sub:Size .

