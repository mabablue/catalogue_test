@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RANQyi4cMbX4Igs5BwVWjXH_xFz6-eiqiW82QYObvuAkM/> .

<https://w3id.org/iadopt/variable/PhagocyticActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Phagocytic activity",
        "phagocytic activity in exposed invertebrate organism" ;
    dcterms:description "the ability of immune cells to engulf foreign particles." ;
    iop:hasObjectOfInterest sub:invertebrateorganism ;
    iop:hasProperty sub:PhagocyticActivity .

