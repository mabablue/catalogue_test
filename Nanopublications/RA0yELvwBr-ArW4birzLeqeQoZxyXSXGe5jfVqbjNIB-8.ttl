@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA0yELvwBr-ArW4birzLeqeQoZxyXSXGe5jfVqbjNIB-8/> .

<https://w3id.org/iadopt/variable/BALLDH> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "BAL LDH",
        "BAL LDH from exposed animal" ;
    dcterms:description "the lactate dehydrogenase activity in bronchoalveolar lavage fluid." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:LDHactivitinBAL .

