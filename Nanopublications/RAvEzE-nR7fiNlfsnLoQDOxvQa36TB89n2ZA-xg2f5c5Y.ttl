@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAvEzE-nR7fiNlfsnLoQDOxvQa36TB89n2ZA-xg2f5c5Y/> .

<https://w3id.org/iadopt/variable/Type> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Type" ;
    dcterms:description "Something distinguishable as an identifiable class based on common qualities." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25284> ;
    iop:hasObjectOfInterest sub:Type ;
    iop:hasProperty <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25284> .

