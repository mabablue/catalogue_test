@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAZ8Nw6J12USEKCNGExin0fqmqyci7xHzuhwS3xOzIYN0/> .

<https://w3id.org/iadopt/variable/MalformationIncidence> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Malformation incidence",
        "malformation incidence in offspring" ;
    dcterms:description "An abnormal formation, especially an abnormal developmental feature." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GSSO_000559> ;
    iop:hasObjectOfInterest sub:offspring ;
    iop:hasProperty sub:malformationIncidence .

