@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RArTB01x6lHXXOjZo8ljs11HLeGGe5a_F0zW_ZZ2-0aVc/> .

<https://w3id.org/iadopt/variable/OrganicCarbon> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Organic carbon (fOC)",
        "organic carbon fraction (fOC) of soil" ;
    dcterms:description "Carbon that is incorporated into organic compounds derived from living organisms, representing the foundation of biological molecules and ecosystem carbon pools." ;
    rdfs:seeAlso <https://w3id.org/bervo/BERVO_8000033> ;
    iop:hasObjectOfInterest sub:soil ;
    iop:hasProperty sub:OrganicCarbonContent .

