@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA4ekHtfVVlKHswHgt1nO7PofmU1Fav2-mzmOqvuL5oWI/> .

<https://w3id.org/iadopt/variable/TDAR> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "TDAR (antibody response)",
        "TDAR in exposed animal" ;
    dcterms:description "the production of antibodies against a T-cell–dependent antigen, used to assess functional immune competence." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:T-celldependentantibodyresponse .

