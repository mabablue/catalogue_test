@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAx-58SCxEFWM6H2ibiwslsbjIt8fIBeeFb1jn21oYHYE/> .

<https://w3id.org/iadopt/variable/SpecificHeatCapacity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Specific heat capacity" ;
    dcterms:description "the amount of heat required to raise the temperature of a unit mass of a material by one kelvin." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:SpecificHeatCapacity .

