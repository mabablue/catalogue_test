@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RALT0Q9zHBKiWCJ5-xntNjm5uA64y1Jr2mSH89eyKq2Bk/> .

<https://w3id.org/iadopt/variable/AcetylcholinesteraseActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Acetylcholinesterase (AChE) activity",
        "acetylcholinesterase (ache) activity in exposed invertebrate organism" ;
    dcterms:description "the enzymatic breakdown of acetylcholine, essential for normal nerve signal transmission." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0003990> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:AcetylcholinesteraseAcheActivity .

