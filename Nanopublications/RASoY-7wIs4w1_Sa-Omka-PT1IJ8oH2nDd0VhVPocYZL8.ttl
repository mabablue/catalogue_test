<https://w3id.org/iadopt/variable/GrossPathologyFindings> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Gross pathology findings",
        "gross pathology findings in exposed animal" ;
    dcterms:description "The outcome of a gross, or macroscopic, pathologic examination." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C125008> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:grossPathologicalFindings .

