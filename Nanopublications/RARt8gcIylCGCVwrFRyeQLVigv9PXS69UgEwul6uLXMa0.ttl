@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RARt8gcIylCGCVwrFRyeQLVigv9PXS69UgEwul6uLXMa0/> .

<https://w3id.org/iadopt/variable/UterotrophicResponse> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Uterotrophic response",
        "uterotrophic response in exposed animal" ;
    dcterms:description "the increase in uterine weight following exposure to estrogenic substances, used to assess estrogen receptor–mediated endocrine activity." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:uterotrophiceffect .

