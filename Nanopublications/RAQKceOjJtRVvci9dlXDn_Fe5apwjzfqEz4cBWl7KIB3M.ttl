@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAQKceOjJtRVvci9dlXDn_Fe5apwjzfqEz4cBWl7KIB3M/> .

<https://w3id.org/iadopt/variable/Glucose> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Glucose",
        "glucose concentration in blood" ;
    dcterms:description "the concentration of glucose in blood, used as an indicator of metabolic and endocrine function" ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:glucoseLevel .

