@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAMH3LBqFV5X_2WISh7gsqmDevYQUGqK6TSlOEipH5k4A/> .

<https://w3id.org/iadopt/variable/ProteinCarbonyls> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Protein carbonyls",
        "protein carbonyl content in cells" ;
    dcterms:description "are oxidatively modified proteins containing carbonyl groups formed as a result of oxidative damage." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:proteincarbonyllevel .

