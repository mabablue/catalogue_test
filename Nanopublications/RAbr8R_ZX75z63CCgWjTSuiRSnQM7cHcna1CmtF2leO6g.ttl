@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbr8R_ZX75z63CCgWjTSuiRSnQM7cHcna1CmtF2leO6g/> .

<https://w3id.org/iadopt/variable/CorrosionRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Corrosion rate",
        "corrosion rate of material" ;
    dcterms:description "the speed at which a metal or alloy deteriorates due to chemical or electrochemical reactions with its environment" ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:CorrosionRate .

