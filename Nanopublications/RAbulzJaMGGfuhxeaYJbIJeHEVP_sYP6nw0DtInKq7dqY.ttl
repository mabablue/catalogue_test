@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbulzJaMGGfuhxeaYJbIJeHEVP_sYP6nw0DtInKq7dqY/> .

<https://w3id.org/iadopt/variable/SolubilityInOrganicSolvent> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Solubility in organic solvent",
        "solubility of substance in organic solvent" ;
    dcterms:description "The ability of a chemical substance to dissolve in some organic molecules." ;
    rdfs:seeAlso <http://purl.enanomapper.org/onto/ENM_9000082> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:solubility .

