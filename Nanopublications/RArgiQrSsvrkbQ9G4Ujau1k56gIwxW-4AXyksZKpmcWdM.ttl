@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RArgiQrSsvrkbQ9G4Ujau1k56gIwxW-4AXyksZKpmcWdM/> .

<https://w3id.org/iadopt/variable/SoftwareComponentOutputs> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Software Component Output(s)" ;
    dcterms:description "The data or artifacts, files, parameters, reports, or signals produced by a software component as a result of its operation, typically passed to other components or returned to the caller." ;
    iop:hasObjectOfInterest sub:softwarecomponent ;
    iop:hasProperty sub:outputs .

