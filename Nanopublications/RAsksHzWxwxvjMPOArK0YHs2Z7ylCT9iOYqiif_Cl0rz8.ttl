<https://w3id.org/iadopt/variable/ParticleSize/Agglomeration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Particle size/agglomeration",
        "particle size/agglomeration in plant tissues" ;
    dcterms:description "the dimensions of individual nanoparticles and the extent to which they cluster or aggregate in a medium." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1694> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty <https://w3id.org/np/RAsksHzWxwxvjMPOArK0YHs2Z7ylCT9iOYqiif_Cl0rz8/ParticleSize/AgglomerationState> .

