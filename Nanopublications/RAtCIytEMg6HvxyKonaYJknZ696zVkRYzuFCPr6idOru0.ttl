@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAtCIytEMg6HvxyKonaYJknZ696zVkRYzuFCPr6idOru0/> .

<https://w3id.org/iadopt/variable/RootToshootConcentrationRatio> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Root:shoot concentration ratio",
        "root:shoot concentration ratio of test substance" ;
    dcterms:description "the concentration of a substance in roots relative to shoots." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:DistributionPattern .

