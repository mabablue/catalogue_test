@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAb2CeMiiTPBoqVj6d4jWJrLkwvKYhaYM3EdvxRvssxpw/> .

<https://w3id.org/iadopt/variable/Depression-likeBehavior> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Depression-like behavior",
        "depression-like behavior in exposed animal" ;
    dcterms:description "the behavioral response of organisms indicating reduced motivation, behavioral despair, or anhedonia, assessed using standardized behavioral tests." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:depression-likeBehavior .

