@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAtRCjD1x1Lu0T3DmiOnuStNs-WFW2pK1xh0JiAZ-tBRE/> .

<https://w3id.org/iadopt/variable/UnitCellDimensionsBibliographic> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Unit cell dimensions (bibliographic, i.e., retrieved from libraries)" ;
    dcterms:description "Lengths of the three unit cell axes (a, b, c) retrieved from crystallography libraries" ;
    iop:hasObjectOfInterest sub:UnitCell ;
    iop:hasProperty sub:UnitCellDimensionsBibliographic .

