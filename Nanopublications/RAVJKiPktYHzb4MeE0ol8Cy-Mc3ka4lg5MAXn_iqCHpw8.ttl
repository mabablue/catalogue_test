@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAVJKiPktYHzb4MeE0ol8Cy-Mc3ka4lg5MAXn_iqCHpw8/> .

<https://w3id.org/iadopt/variable/oxygenConsumptionRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Oxygen consumption rate",
        "oxygen consumption rate of cells" ;
    dcterms:description "The rate at which oxygen is used" ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D010101> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:oxygenConsumptionRate .

