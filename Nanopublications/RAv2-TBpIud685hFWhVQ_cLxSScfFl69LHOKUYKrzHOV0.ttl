@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAv2-TBpIud685hFWhVQ_cLxSScfFl69LHOKUYKrzHOV0/> .

<https://w3id.org/iadopt/variable/ProteinCoronaComposition> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Protein corona composition",
        "protein corona composition on particles" ;
    dcterms:description "the set of proteins bound to a material surface in biological media." ;
    iop:hasObjectOfInterest sub:nanoparticle ;
    iop:hasProperty sub:ProteinCoronaComposition .

