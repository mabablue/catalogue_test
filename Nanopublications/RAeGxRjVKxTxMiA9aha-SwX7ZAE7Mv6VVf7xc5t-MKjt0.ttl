@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAeGxRjVKxTxMiA9aha-SwX7ZAE7Mv6VVf7xc5t-MKjt0/> .

<https://w3id.org/iadopt/variable/Colour> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Colour" ;
    dcterms:description "the appearance of something as a result of the way in which it reflects light." ;
    iop:hasObjectOfInterest sub:Chemicals ;
    iop:hasProperty <http://www.co-ode.org/ontologies/galen#Colour> .

