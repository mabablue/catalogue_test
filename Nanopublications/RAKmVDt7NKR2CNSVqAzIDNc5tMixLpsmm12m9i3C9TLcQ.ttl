@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAKmVDt7NKR2CNSVqAzIDNc5tMixLpsmm12m9i3C9TLcQ/> .

<https://w3id.org/iadopt/variable/SizeDistributionUVVis> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Nanomaterial size distribution measured with UV-Vis" ;
    iop:hasObjectOfInterest sub:Nanomaterial ;
    iop:hasProperty sub:SizeDistribution .

