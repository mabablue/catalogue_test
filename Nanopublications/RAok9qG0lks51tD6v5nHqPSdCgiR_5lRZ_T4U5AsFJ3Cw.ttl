@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAok9qG0lks51tD6v5nHqPSdCgiR_5lRZ_T4U5AsFJ3Cw/> .

<https://w3id.org/iadopt/variable/AtomicWeightActiveMetalMetalloid> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Total atomic weight of active metals and metalloids" ;
    dcterms:description "Pertaining to an entirety or whole, also constituting the full quantity or extent, of he relative atomic mass (of elements from natural, stable, terrestrial sources) there are, attributable to electropositive chemical elements that are not characterised by ductility, malleability, luster, and conductance of heat and electricity, in addition to chemical elements with properties between a metal and a non-metal , that are exerting influence or producing an effect" ;
    iop:hasObjectOfInterest sub:MetalMetalloid ;
    iop:hasProperty sub:AtomicWeight .

