@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAhVvFgjgP0WuKoKKx14CYMecXgbKqTXKFRFGTNA7tdJw/> .

<https://w3id.org/iadopt/variable/FatSolubility> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Fat solubility",
        "fat solubility of substance" ;
    dcterms:description "the ability of a substance to dissolve in lipids, fats, or non-polar organic solvents." ;
    rdfs:seeAlso <https://www.dictionary.com/browse/fat-soluble> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:FatSolubility .

