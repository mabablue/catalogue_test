@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATT6dmenQIQtU9WeaiuhO1_sfbJQsGhs9pfVPGUlaSyo/> .

<https://w3id.org/iadopt/variable/RootSurfaceAdsorptionVSInternalization> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Root surface adsorption vs internalization",
        "root surface adsorption vs internalization of test substance" ;
    dcterms:description "distinguishes between nanoparticles adhering to the root exterior and nanoparticles that are taken up into root tissues." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:UptakePathway .

