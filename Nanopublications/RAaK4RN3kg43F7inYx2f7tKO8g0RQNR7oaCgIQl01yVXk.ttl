@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAaK4RN3kg43F7inYx2f7tKO8g0RQNR7oaCgIQl01yVXk/> .

<https://w3id.org/iadopt/variable/SoftwareComponentStructure> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Software Component Structure" ;
    dcterms:description "The organization of a software into components/modules and their relationships (e.g., layers, packages, services, plugins, dependencies, and how these interact)." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:ComponentStructure .

