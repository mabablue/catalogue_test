@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGT0-hxWkybeYWjhXviF-UlE_gtAcG6dQtGFtk1wCHj8/> .

<https://w3id.org/iadopt/variable/CellCount> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Cell count",
        "cell count in culture" ;
    dcterms:description "the total number of cells present in a sample at a given time point." ;
    iop:hasObjectOfInterest sub:cellCulture ;
    iop:hasProperty sub:cellNumber .

