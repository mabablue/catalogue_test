@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA_2SZ319FqKswxV1CxtnZS4ygmRsqc565r4M-NIXm2q8/> .

<https://w3id.org/iadopt/variable/p62/SQSTM1level> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "p62/SQSTM1 level",
        "p62/SQSTM1 level in cells" ;
    dcterms:description "the amount of the autophagy adaptor protein p62, which accumulates when autophagy is impaired and decreases when autophagy is active." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty <https://w3id.org/np/RA_2SZ319FqKswxV1CxtnZS4ygmRsqc565r4M-NIXm2q8/p62/SQSTM1level> .

