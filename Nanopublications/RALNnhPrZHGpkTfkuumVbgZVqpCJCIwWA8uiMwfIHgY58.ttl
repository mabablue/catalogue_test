@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RALNnhPrZHGpkTfkuumVbgZVqpCJCIwWA8uiMwfIHgY58/> .

<https://w3id.org/iadopt/variable/MassDensity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Mass density" ;
    dcterms:description "A physical quality which inheres in a bearer by virtue of some influence is exerted by the bearer's mass per unit size" ;
    iop:hasObjectOfInterest sub:NP ;
    iop:hasProperty <http://purl.obolibrary.org/obo/PATO_0001019> .

