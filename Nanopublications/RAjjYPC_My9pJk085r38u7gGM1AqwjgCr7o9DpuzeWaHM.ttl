@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAjjYPC_My9pJk085r38u7gGM1AqwjgCr7o9DpuzeWaHM/> .

<https://w3id.org/iadopt/variable/SeedLotID&Viability> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Seed lot ID & viability",
        "seed lot ID & viability" ;
    dcterms:description "the identification of the seed batch used in a study and the proportion of seeds capable of germination under defined conditions." ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:seedIdentityAndQuality .

