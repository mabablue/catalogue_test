@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA5ORncZyYZ6y9MBo5wSYPj41FPRi7omCLT7ibXcZ92-k/> .

<https://w3id.org/iadopt/variable/AuNP> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Au nanoparticle",
        "Gold nanoparticle" ;
    iop:hasObjectOfInterest sub:AuNP ;
    iop:hasProperty <http://purl.bioontology.org/ontology/npo#NPO_401> .

