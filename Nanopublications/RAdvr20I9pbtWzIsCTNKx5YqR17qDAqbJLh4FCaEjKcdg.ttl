@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAdvr20I9pbtWzIsCTNKx5YqR17qDAqbJLh4FCaEjKcdg/> .

<https://w3id.org/iadopt/variable/EnergyBandGap> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Energy band gap",
        "energy band gap of material" ;
    dcterms:description "the energy difference between the top of the valence band and the bottom of the conduction band in a semiconductor or insulator." ;
    rdfs:seeAlso <http://semanticscience.org/resource/CHEMINF_000487> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:EnergyBandGap .

