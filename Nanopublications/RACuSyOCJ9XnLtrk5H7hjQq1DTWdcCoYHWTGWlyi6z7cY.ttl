@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/iadopt/variable/Hyperplasia/dysplasia> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Hyperplasia/dysplasia",
        "hyperplasia/dysplasia in tissue" ;
    dcterms:description "An increase in the number of cells in a tissue or organ without tumor formation. It differs from HYPERTROPHY, which is an increase in bulk without an increase in the number of cells." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D006965> ;
    iop:hasObjectOfInterest <https://w3id.org/np/RACuSyOCJ9XnLtrk5H7hjQq1DTWdcCoYHWTGWlyi6z7cY/organ/tissue> ;
    iop:hasProperty <https://w3id.org/np/RACuSyOCJ9XnLtrk5H7hjQq1DTWdcCoYHWTGWlyi6z7cY/hyperplasia/dysplasiaoccurrence> .

