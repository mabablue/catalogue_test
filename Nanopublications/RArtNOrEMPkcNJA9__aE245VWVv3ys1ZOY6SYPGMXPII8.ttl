@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RArtNOrEMPkcNJA9__aE245VWVv3ys1ZOY6SYPGMXPII8/> .

<https://w3id.org/iadopt/variable/PopulationGrowthRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Population growth rate (r)",
        "population growth rate (r) in exposed invertebrate population" ;
    dcterms:description "the rate of increase in population size over time" ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/PATO_0040045> ;
    iop:hasObjectOfInterest sub:invertebratePopulation ;
    iop:hasProperty sub:PopulationGrowthRateR .

