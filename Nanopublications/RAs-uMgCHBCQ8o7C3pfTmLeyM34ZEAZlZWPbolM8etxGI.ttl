@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAs-uMgCHBCQ8o7C3pfTmLeyM34ZEAZlZWPbolM8etxGI/> .

<https://w3id.org/iadopt/variable/CellViability> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Cell viability",
        "cell viability in vitro" ;
    dcterms:description "yhe proportion of living, metabolically active cells in a sample after exposure to a substance." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1343> ;
    iop:hasObjectOfInterest sub:CellCulture ;
    iop:hasProperty sub:CellViability .

