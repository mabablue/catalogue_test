@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA3diYwhJ9fkI1_Hw2O2_8WUca8qUZgzJ28-0S9ptCGFo/> .

<https://w3id.org/iadopt/variable/RhizosphereSoil> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Rhizosphere soil",
        "rhizosphere soil of plant" ;
    dcterms:description "the soil directly surrounding and influenced by plant roots, characterized by root exudates and microbial activity." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/201006001828862638> ;
    iop:hasObjectOfInterest sub:soil ;
    iop:hasProperty sub:SoilCompartment .

