@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAzZs4DNHb8sA-rhN_vIiHdA2E5NxsAEKKh5Ii_-9tvII/> .

<https://w3id.org/iadopt/variable/LateApoptosis> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Late apoptosis",
        "late apoptosis level in cells" ;
    dcterms:description "the advanced stage of programmed cell death characterized by loss of membrane integrity and progression toward cellular fragmentation." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:LateApoptosisLevel .

