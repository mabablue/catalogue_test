@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAp6Ri0xr-etcgPqFEV6x_Bge0dSrqnsdQQmR9ghFcEF4/> .

<https://w3id.org/iadopt/variable/Temperature> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Temperature (day/night)",
        "temperature  of growth environment" ;
    dcterms:description "the environmental temperature maintained during the light and dark phases of a daily cycle." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D013696> ;
    iop:hasObjectOfInterest sub:GrowthEnvironment ;
    iop:hasProperty sub:temperature .

