@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA_Orh35RJ9owwg221PyRFgO75BvRsQRl_XLTH0lXoqyI/> .

<https://w3id.org/iadopt/variable/TissueDistribution> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Tissue distribution",
        "tissue distribution in exposed invertebrate organism tissue" ;
    dcterms:description "the location and concentration of substances across tissues." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D014018> ;
    iop:hasObjectOfInterest sub:invertebrateOrganismTissue ;
    iop:hasProperty sub:TissueDistribution .

