@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbRVKdLdUJqRyzd9_D-8TnZE8VGbvxGpjOmmDDYshY7I/> .

<https://w3id.org/iadopt/variable/Reflectance> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Reflectance",
        "reflectance of material" ;
    dcterms:description "the fraction of incident electromagnetic radiation that is reflected by a surface or material." ;
    rdfs:seeAlso <http://vocabs.lter-europe.net/EnvThes/21580> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:reflectance .

