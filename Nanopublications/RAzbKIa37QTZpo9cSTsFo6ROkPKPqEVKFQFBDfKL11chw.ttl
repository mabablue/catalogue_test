@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAzbKIa37QTZpo9cSTsFo6ROkPKPqEVKFQFBDfKL11chw/> .

<https://w3id.org/iadopt/variable/ProteinCorona> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Protein corona",
        "protein corona of material" ;
    dcterms:description "the layer of proteins that spontaneously adsorbs onto the surface of a nanoparticle when it is exposed to a biological medium" ;
    iop:hasObjectOfInterest sub:material ;
    iop:hasProperty sub:proteinCoronaFormation .

