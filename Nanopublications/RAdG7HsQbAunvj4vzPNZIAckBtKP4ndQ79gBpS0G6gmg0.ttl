@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAdG7HsQbAunvj4vzPNZIAckBtKP4ndQ79gBpS0G6gmg0/> .

<https://w3id.org/iadopt/variable/HistoneModificationChanges> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Histone modification changes",
        "histone modification changes in cells" ;
    dcterms:description "Post-translational processing of amino acids within a histone protein." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C129422> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:HistoneModificationChanges .

