@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAo-hQopWD9EWdfK1ymoB59pV2gayTE2PD8LBg4YmlF_0/> .

<https://w3id.org/iadopt/variable/AvoidanceBehaviour> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Avoidance behaviour",
        "avoidance behaviour in exposed invertebrate organism" ;
    dcterms:description "the movement of organisms away from contaminated environments." ;
    rdfs:seeAlso <http://humanbehaviourchange.org/ontology/BCIO_036073> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:AvoidanceBehaviour .

