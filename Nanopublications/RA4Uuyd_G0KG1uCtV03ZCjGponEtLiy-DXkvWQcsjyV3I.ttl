@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA4Uuyd_G0KG1uCtV03ZCjGponEtLiy-DXkvWQcsjyV3I/> .

<https://w3id.org/iadopt/variable/Additives> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Additives",
        "additive/stabilizer content of substance" ;
    dcterms:description "A substance that is added to a system or compound to improve its characteristics." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C63495> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty <https://w3id.org/np/RA4Uuyd_G0KG1uCtV03ZCjGponEtLiy-DXkvWQcsjyV3I/additive/stabilizerContent> .

