@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RALrxtUpI9XOaNjr7KosQ62agsOs7r0pDcjqM6wWfIFII/> .

<https://w3id.org/iadopt/variable/CellularUptakeMass> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Cellular uptake mass",
        "cellular uptake mass of test substance" ;
    dcterms:description "the total mass of a substance internalized by cells after exposure." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:CellularUptakeMass .

