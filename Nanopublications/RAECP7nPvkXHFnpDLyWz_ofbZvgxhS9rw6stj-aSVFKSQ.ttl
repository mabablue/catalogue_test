@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAECP7nPvkXHFnpDLyWz_ofbZvgxhS9rw6stj-aSVFKSQ/> .

<https://w3id.org/iadopt/variable/SphericalNP> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Granural nanoparticle",
        "Spherical nanoparticle" ;
    dcterms:description "A nanoparticle with spherical morphology" ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1551> ;
    iop:hasObjectOfInterest sub:Nanoparticle ;
    iop:hasProperty <http://purl.bioontology.org/ontology/npo#NPO_1551> .

