@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RALWLPe6jZgvYhWmnKoNym2QrvirbKZHoClVAEcIhmDhs/> .

<https://w3id.org/iadopt/variable/D10> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average coordination parameter of the core atoms" ;
    dcterms:description "D10: The average coordination parameter of the nanoparticle core atoms" ;
    iop:hasObjectOfInterest sub:NPCoreAtomCoordination ;
    iop:hasProperty sub:D10 .

