@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAIBTYmZ75cyxlIf2ZAzgnveFO-rSihpIFMMW7ekqRdYI#> .

sub:IADOPT.DustPCB52Concentration a iop:Variable ;
    rdfs:label "Concentration of PCB52 in a settled dust sample" ;
    dcterms:description "Concentration of PCB52 measured in a settled dust sample taken from a household" ;
    rdfs:seeAlso <https://inquire-he.eu/datamodel> ;
    iop:hasConstraint <https://inquire-he.eu/datamodel#Settled> ;
    iop:hasContextObject <https://inquire-he.eu/datamodel#HouseHold> ;
    iop:hasMatrix <https://inquire-he.eu/datamodel#Dust> ;
    iop:hasObjectOfInterest <https://inquire-he.eu/datamodel#PCB52> ;
    iop:hasProperty <https://inquire-he.eu/datamodel#MassPerVolumeConcentration> .

