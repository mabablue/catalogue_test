sub:assertion {
  sub:variable7 a <https://w3id.org/iadopt/ont/Variable>;
    dct:description "Trunk char height is a measure of the extent of fire height above ground which is measured from the base to the highest point of fire occurrence on the tree trunk. Maximum char height is measured at the community level using a 360° sweep at each sampling location.";
    rdfs:label "Maximum trunk char height";
    <https://w3id.org/iadopt/ont/hasMatrix> <http://purl.jp/bio/4/id/200906090403689217>;
