sub:assertion {
  <https://w3id.org/iadopt/variable/MetalMetalloidNo> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "Pertaining to an entirety or whole, also constituting the full quantity or extent, of electropositive chemical elements that are not characterised by ductility, malleability, luster, and conductance of heat and electricity, in addition to chemical elements with properties between a metal and a non-metal , that are exerting influence or producing an effect";
    rdfs:label "Total number of metals and metalloids";
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:MetalMetalloid;
    <https://w3id.org/iadopt/ont/hasProperty> sub:Atoms .
}

