@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA06CPgTx7cWWx8FspIOQuRaAfZV33LtYEPYQJysnYw6A/> .

<https://w3id.org/iadopt/variable/MagneticSusceptibility> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Magnetic susceptibility",
        "magnetic susceptibility of material" ;
    dcterms:description "a property that measures how easily a material can be magnetized in the presence of an external magnetic field" ;
    rdfs:seeAlso <http://dicom.nema.org/resources/ontology/DCM/126396> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:MagneticSusceptibility .

