@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAT1mVLsLMggVvynxQL5w50imjgBUpQFKWkEONtuLm1lE/> .

<https://w3id.org/iadopt/variable/FlowRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Flow rate" ;
    dcterms:description "The speed of movement of a liquid" ;
    iop:hasObjectOfInterest sub:Liquid ;
    iop:hasProperty <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C82554> .

