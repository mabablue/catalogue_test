@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA_Pzq5xrGnJ1qF_JrHir3Ij6SgHaj1hOgM2wNUNFlzaY/> .

<https://w3id.org/iadopt/variable/Caspase3/7activity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Caspase 3/7 activity",
        "caspase 3/7 activity in cells" ;
    dcterms:description "the enzymatic activity of executioner caspases 3 and 7, which mediate the cleavage of cellular substrates during apoptosis" ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/HINO_0024388> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:caspaseactivity .

