@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAso0vjHbsSJL2iRxVBbM5YUrNCKnRkn1yNtM4rn-3Qno/> .

<https://w3id.org/iadopt/variable/DissolutionRateInMedia> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Dissolution rate in media",
        "dissolution rate in exposure media" ;
    dcterms:description "the rate at which a material releases dissolved species, such as ions or molecules, into the surrounding medium over time." ;
    rdfs:seeAlso <http://purl.enanomapper.org/onto/ENM_1200001> ;
    iop:hasObjectOfInterest sub:exposureMedium ;
    iop:hasProperty sub:dissolutionRate .

