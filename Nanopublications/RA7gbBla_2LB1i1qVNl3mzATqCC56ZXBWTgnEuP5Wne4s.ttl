@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA7gbBla_2LB1i1qVNl3mzATqCC56ZXBWTgnEuP5Wne4s/> .

<https://w3id.org/iadopt/variable/EyC₅₀> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "EyC₅₀ (yield)",
        "EyC₅₀ (yield) of plant" ;
    dcterms:description "the concentration of a substance that causes a 50% reduction in biomass yield compared to an untreated control over a defined exposure period" ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:yieldEC50 .

