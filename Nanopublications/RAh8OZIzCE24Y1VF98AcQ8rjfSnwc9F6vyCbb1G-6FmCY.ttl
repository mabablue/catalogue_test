@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAh8OZIzCE24Y1VF98AcQ8rjfSnwc9F6vyCbb1G-6FmCY/> .

<https://w3id.org/iadopt/variable/MitochondrialMass> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Mitochondrial mass",
        "mitochondrial mass in cells" ;
    dcterms:description "the total amount or abundance of mitochondria present within a cell." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:MitochondrialMass .

