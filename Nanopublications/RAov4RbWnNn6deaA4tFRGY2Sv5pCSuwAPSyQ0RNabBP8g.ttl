@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAov4RbWnNn6deaA4tFRGY2Sv5pCSuwAPSyQ0RNabBP8g/> .

<https://w3id.org/iadopt/variable/Classification> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Class",
        "Classification" ;
    dcterms:description "Supervised machine learning methods used for categorical, discrete dependent variables" ;
    iop:hasObjectOfInterest sub:Classification ;
    iop:hasProperty <http://bigdatau.org/dseo#classification> .

