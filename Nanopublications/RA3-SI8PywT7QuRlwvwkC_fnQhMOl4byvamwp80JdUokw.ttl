<https://w3id.org/iadopt/variable/D49> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average first hex parameter of the core atoms" ;
    dcterms:description "D49: The average first hex parameter of the core atoms" ;
    iop:hasObjectOfInterest sub:Nanoparticle ;
    iop:hasProperty sub:FirstHexCore .

