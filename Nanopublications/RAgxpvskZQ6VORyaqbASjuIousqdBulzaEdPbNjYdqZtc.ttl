@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAgxpvskZQ6VORyaqbASjuIousqdBulzaEdPbNjYdqZtc/> .

<https://w3id.org/iadopt/variable/MembraneIntegrity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Membrane integrity",
        "membrane integrity of cells" ;
    dcterms:description "the structural and functional intactness of the cell membrane, indicating whether the membrane remains undamaged after exposure." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:MembraneIntegrity .

