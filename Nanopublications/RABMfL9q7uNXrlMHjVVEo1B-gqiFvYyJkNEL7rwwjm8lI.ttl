@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RABMfL9q7uNXrlMHjVVEo1B-gqiFvYyJkNEL7rwwjm8lI/> .

<https://w3id.org/iadopt/variable/IonChannelActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "ion channel activity",
        "ion channel activity in cells" ;
    dcterms:description "the movement of ions across cell membranes through ion channel proteins, reflecting their functional state." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0005216> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:ionchannelactivity .

