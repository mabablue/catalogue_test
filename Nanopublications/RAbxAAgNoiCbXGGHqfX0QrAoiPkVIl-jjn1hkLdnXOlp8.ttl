@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbxAAgNoiCbXGGHqfX0QrAoiPkVIl-jjn1hkLdnXOlp8/> .

<https://w3id.org/iadopt/variable/MetamorphosisSuccess> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Metamorphosis success",
        "metamorphosis success in exposed invertebrate organism" ;
    dcterms:description "the proportion of organisms that successfully complete transformation to the next developmental stage." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0007552> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:MetamorphosisSuccess .

