@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAWbJ3274FK4641G2f-kF7GkX1vxBbSwpW2W-qYyTWA_o/> .

<https://w3id.org/iadopt/variable/ImpurityProfile> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Impurity profile",
        "impurity composition of substance" ;
    dcterms:description "A set of analytical information describing the identity, amount, and distribution of impurities present in a material" ;
    rdfs:seeAlso <https://database.ich.org/sites/default/files/Q3A%28R2%29%20Guideline.pdf> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:impuritycomposition .

