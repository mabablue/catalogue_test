@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA0OJ2rWNsuzFoDLnVmSTtv_cgI7RDeht1Q_NRn25kN4U/> .

<https://w3id.org/iadopt/variable/Flammability> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Flammability",
        "flammability of substance" ;
    dcterms:description "the ease with which a material is ignited" ;
    rdfs:seeAlso <http://www.co-ode.org/ontologies/galen#Flammability> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:flammability .

