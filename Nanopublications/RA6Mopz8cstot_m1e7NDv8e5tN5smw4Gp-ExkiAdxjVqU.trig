    rdfs:seeAlso <http://purl.jp/bio/4/id/200906005131446800>;
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:substance;
    <https://w3id.org/iadopt/ont/hasProperty> sub:DecompositionTemperature .
}

