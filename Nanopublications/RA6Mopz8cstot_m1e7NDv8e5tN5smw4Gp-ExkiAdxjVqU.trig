sub:assertion {
  <https://w3id.org/iadopt/variable/DecompositionTemperature> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "the temperature at which a molecule begins to break up and decompose, and it is influenced by factors such as molecular structure, activation energy, aggregated state, and crosslink density of organic materials.";
