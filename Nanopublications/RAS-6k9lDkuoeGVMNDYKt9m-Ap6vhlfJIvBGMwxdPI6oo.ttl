@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAS-6k9lDkuoeGVMNDYKt9m-Ap6vhlfJIvBGMwxdPI6oo/> .

<https://w3id.org/iadopt/variable/DeploymentType> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Deployment Type" ;
    dcterms:description "The category of how the software is deployed or delivered for use (e.g., local/desktop, web application, cloud/SaaS, on-prem service, containerized deployment, mobile app, library/package, HPC/batch workflow)." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:deploymenttype .

