@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA7J3crwVb8zZ_BcWvUKeBQyk2iT7Joek0i4vDbXspNhk/> .

<https://w3id.org/iadopt/variable/Hardness> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Hardness",
        "hardness of material" ;
    dcterms:description "the resistance of a material to permanent deformation under an applied force." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D006244> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:Hardness .

