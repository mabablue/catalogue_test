<https://w3id.org/iadopt/variable/D04> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average potential energy of all atoms in eV" ;
    dcterms:description "D4: The average potential energy of all nanoparticle atoms in eV" ;
    iop:hasObjectOfInterest sub:NPAtomEnergy ;
    iop:hasProperty sub:D04 .

