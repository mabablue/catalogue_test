@prefix sub: <https://w3id.org/np/RAVdlRCbyx5ulcwqvaIFQVJN9EknYzMF7HPaifSbgP3PU#> .

sub:variable11 a iop:Variable ;
    rdfs:label "Strike of bedding" ;
    dcterms:description "Geographic azimuth (relative to true north) at a point observation location, of a horizontal line contained in a sedimentary rock bedding surface. The bedding surface must not be horizontal; the azimuth is reported such that the dip direction of the inclined bedding is to the right when facing in the azimuth direction." ;
    iop:hasMatrix <https://terra-vocabulary.org/ncl/FAIR-Incubator/earthfeaturetype/c_f0be2da5> ;
    iop:hasObjectOfInterest <http://www.yso.fi/onto/afo/p3498> ;
    iop:hasProperty <https://w3id.org/ozcar-theia/c_1e8e28cd> .

