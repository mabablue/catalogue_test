@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAeEX0WUHoftNNCb3K9ge867juTYxr0PN4l14etw1tCso/> .

<https://w3id.org/iadopt/variable/SedimentBioturbationActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Sediment bioturbation activity",
        "sediment bioturbation activity in exposed invertebrate organism" ;
    dcterms:description "sediment mixing caused by organisms." ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:SedimentBioturbationActivity .

