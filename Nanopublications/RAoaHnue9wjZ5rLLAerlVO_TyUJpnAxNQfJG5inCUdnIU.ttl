@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAoaHnue9wjZ5rLLAerlVO_TyUJpnAxNQfJG5inCUdnIU/> .

<https://w3id.org/iadopt/variable/Clearance> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Clearance",
        "clearance rate of test substance" ;
    dcterms:description "The ratio of excretion is or measure of the speed at which a constituent is lost from the body." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/MI_2122> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:clearancerate .

