@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAlEz7sSl91MSf8oF_a7KB3mUQCaC3bi9Qe96UyEDDab8/> .

<https://w3id.org/iadopt/variable/FlashPoint> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Flash point",
        "flash point of substance" ;
    dcterms:description "The flash point of a substance at a given pressure is the minimum temperature at which a mixture of the substance with air can be ignited, within its explosive range." ;
    rdfs:seeAlso <http://semanticscience.org/resource/CHEMINF_000417> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:FlashPoint .

