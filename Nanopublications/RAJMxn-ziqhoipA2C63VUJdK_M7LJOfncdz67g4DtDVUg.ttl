@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAJMxn-ziqhoipA2C63VUJdK_M7LJOfncdz67g4DtDVUg/> .

<https://w3id.org/iadopt/variable/SkinIrritationScore> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Skin irritation score",
        "skin irritation score in exposed animal" ;
    dcterms:description "a graded assessment of redness, swelling, or other signs of irritation in skin following exposure to a substance." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:skinIrritationSeverity .

