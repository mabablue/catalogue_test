<https://w3id.org/iadopt/variable/Core–shellStructurePresence> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Core–shell structure presence",
        "core–shell structure presence of material" ;
    dcterms:description "the indication that a material or particle exhibits a core region surrounded by a distinct shell layer." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty <https://w3id.org/np/RABbbDkw7nFkBDJQ8PnAPPw8n5p3jABWvfnk_SeVyoUKc/Core–shellStructurePresence> .

