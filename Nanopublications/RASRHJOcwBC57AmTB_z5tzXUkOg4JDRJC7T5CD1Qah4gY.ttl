<https://w3id.org/iadopt/variable/NOEC/LOEC> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "NOEC / LOEC (growth)",
        "NOEC/LOEC of plant" ;
    dcterms:description "NOEC is the highest concentration with no significant growth effect; LOEC is the lowest concentration with a significant growth effect." ;
