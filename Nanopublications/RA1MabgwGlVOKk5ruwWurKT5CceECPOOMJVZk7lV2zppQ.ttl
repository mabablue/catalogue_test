@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA1MabgwGlVOKk5ruwWurKT5CceECPOOMJVZk7lV2zppQ/> .

<https://w3id.org/iadopt/variable/Sulphur> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Sulphur (S)" ;
    dcterms:description "An element that is a member of the chalcogen family. It has an atomic symbol S, atomic number 16, and atomic weight [32.059; 32.076]. It is found in the amino acids cysteine and methionine" ;
    iop:hasObjectOfInterest sub:ChemicalElement ;
    iop:hasProperty <http://purl.bioontology.org/ontology/MESH/D013455> .

