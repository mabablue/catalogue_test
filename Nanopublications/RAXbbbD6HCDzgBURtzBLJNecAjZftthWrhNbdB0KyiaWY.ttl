@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAXbbbD6HCDzgBURtzBLJNecAjZftthWrhNbdB0KyiaWY/> .

<https://w3id.org/iadopt/variable/InherentBiodegradability> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Inherent biodegradability",
        "inherent biodegradability of substance" ;
    dcterms:description "the property of a substance indicating it can be degraded by microorganisms under suitable laboratory conditions." ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:InherentBiodegradability .

