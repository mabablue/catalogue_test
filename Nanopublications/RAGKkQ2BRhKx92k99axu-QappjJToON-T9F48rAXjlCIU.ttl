@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGKkQ2BRhKx92k99axu-QappjJToON-T9F48rAXjlCIU/> .

<https://w3id.org/iadopt/variable/QuantumYield> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Quantum yield",
        "quantum yield of material" ;
    dcterms:description "the efficiency of photon emission following optical excitation." ;
    rdfs:seeAlso <https://www.sciencedirect.com/topics/engineering/quantum-yield#:~:text=Quantum%20yield%20is%20defined%20as,value%20between%200%20and%201.&text=How%20useful%20is%20this%20definition?> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:QuantumYield .

