@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAu6-bjuIHID3D74zIPRh_Pq_yVaq5glrSsFGG21TR44w/> .

<https://w3id.org/iadopt/variable/Fecundity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Fecundity",
        "fecundity in exposed invertebrate organism" ;
    dcterms:description "the total reproductive capacity of an organism, measured as the number of eggs or offspring produced." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/PATO_0000273> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:Fecundity .

