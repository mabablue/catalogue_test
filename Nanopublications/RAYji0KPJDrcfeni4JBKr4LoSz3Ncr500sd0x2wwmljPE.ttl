@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAYji0KPJDrcfeni4JBKr4LoSz3Ncr500sd0x2wwmljPE/> .

<https://w3id.org/iadopt/variable/Structuralisomerism> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Structural isomerism" ;
    dcterms:description "The phenomenon whereby certain chemical compounds have structures that are different although the compounds possess the same elemental composition." ;
    iop:hasObjectOfInterest sub:Chemicals ;
    iop:hasProperty <http://purl.bioontology.org/ontology/MESH/D007536> .

