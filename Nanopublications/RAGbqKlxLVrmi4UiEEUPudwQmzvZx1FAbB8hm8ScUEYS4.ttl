@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGbqKlxLVrmi4UiEEUPudwQmzvZx1FAbB8hm8ScUEYS4/> .

<https://w3id.org/iadopt/variable/ActiveMetalElectrons> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Quantity of active metal electrons" ;
    dcterms:description "How many fundamental particles with a negative charge there are, that are attributable to electropositive chemical elements characterised by ductility, malleability, luster, and conductance of heat and electricity hat are exerting influence or producing an effect" ;
    iop:hasObjectOfInterest sub:Metal ;
    iop:hasProperty sub:ActiveMetalElectrons .

