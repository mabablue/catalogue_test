@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAVP3H35qCFh3CTVOdUyj0FcatpHP4P27YYllSTsfxX3g/> .

<https://w3id.org/iadopt/variable/ElectrolyteLeakage> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Electrolyte leakage",
        "electrolyte leakage from plant cells" ;
    dcterms:description "the loss of ions from plant cells due to damage to cell membranes." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/201106096290509213> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:ElectrolyteLeakage .

