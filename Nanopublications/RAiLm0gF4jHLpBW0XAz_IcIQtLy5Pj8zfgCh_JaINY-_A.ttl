@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAiLm0gF4jHLpBW0XAz_IcIQtLy5Pj8zfgCh_JaINY-_A/> .

<https://w3id.org/iadopt/variable/SizeDistributionXRD> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Nanomaterial size distribution measured with XRD" ;
    iop:hasObjectOfInterest sub:Nanomaterial ;
    iop:hasProperty sub:SizeDistribution .

