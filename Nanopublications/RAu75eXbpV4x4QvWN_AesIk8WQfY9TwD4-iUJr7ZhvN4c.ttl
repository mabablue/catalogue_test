@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAu75eXbpV4x4QvWN_AesIk8WQfY9TwD4-iUJr7ZhvN4c/> .

<https://w3id.org/iadopt/variable/NonMetalNo> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Number of non-metal atoms" ;
    dcterms:description "The amount  of electronegative chemical elements that are not characterised by ductility, malleability, luster, and conductance of heat and electricity. They can replace the hydrogen of an acid and form bases with hydroxyl radicals" ;
    iop:hasObjectOfInterest sub:NonMetal ;
    iop:hasProperty sub:Atoms .

