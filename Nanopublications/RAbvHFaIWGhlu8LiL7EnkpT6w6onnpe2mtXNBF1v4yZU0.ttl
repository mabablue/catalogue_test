@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbvHFaIWGhlu8LiL7EnkpT6w6onnpe2mtXNBF1v4yZU0/> .

<https://w3id.org/iadopt/variable/NonMetalNeutrons> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Quantity of active non-metal neutrons" ;
    dcterms:description "How many elementary particles  with 0 charge and a mass about equal to that of a proton there are, that are attributable materials that are exerting influence or producing an effect and are  not electropositive chemical elements characterised by ductility, malleability, luster, and conductance of heat and electricity" ;
    iop:hasObjectOfInterest sub:NonMetal ;
    iop:hasProperty sub:Neutrons .

