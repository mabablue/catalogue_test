@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RABE4CafFnpMAd-XEssyJsBEqDpAh-Xn49k0m3RbQkDXA/> .

<https://w3id.org/iadopt/variable/TumorIncidence> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Tumor incidence",
        "tumor incidence in exposed animal" ;
    dcterms:description "abnormal mass of tissue that results from uncontrolled proliferation of cells." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1573> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:tumorincidence .

