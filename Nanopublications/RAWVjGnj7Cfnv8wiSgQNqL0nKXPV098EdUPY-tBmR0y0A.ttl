@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAWVjGnj7Cfnv8wiSgQNqL0nKXPV098EdUPY-tBmR0y0A/> .

<https://w3id.org/iadopt/variable/GestationLength> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Gestation length",
        "gestation length in exposed animal" ;
    dcterms:description "Duration of pregnancy from time of fertilization of the oocyte until birth." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/CMO_0000467> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:gestationDuration .

