@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAFbjnBsTpDrGo89qFB7sCl9Yr72pUI5S4Uyj-L__PINg/> .

<https://w3id.org/iadopt/variable/NightTemperature> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Night temperature" ;
    dcterms:description "The temperature during the night" ;
    iop:hasObjectOfInterest sub:Temperature ;
    iop:hasProperty sub:NightTemperature .

