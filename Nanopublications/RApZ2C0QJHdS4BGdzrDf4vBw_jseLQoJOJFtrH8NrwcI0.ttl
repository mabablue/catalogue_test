@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RApZ2C0QJHdS4BGdzrDf4vBw_jseLQoJOJFtrH8NrwcI0/> .

<https://w3id.org/iadopt/variable/MACCSKeys> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "MACCS keys",
        "Molecular Access System (MACCS) keys" ;
    dcterms:description "MACCS keys (Molecular ACCess System keys) are a set of predefined structural keys (binary fingerprints) used to represent chemical structures in a way that facilitates fast searching, similarity comparisons, and clustering in cheminformatics" ;
    iop:hasObjectOfInterest sub:Chemicals ;
    iop:hasProperty sub:MACCSKeys .

