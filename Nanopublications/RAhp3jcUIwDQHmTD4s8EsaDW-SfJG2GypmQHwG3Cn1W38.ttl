<https://w3id.org/iadopt/variable/ThyroidHormones> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Thyroid hormones",
        "thyroid hormones in blood of exposed animal" ;
    dcterms:description "Natural hormones secreted by the THYROID GLAND, such as THYROXINE, and their synthetic analogs." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D013963> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:thyroidhormonelevel .

