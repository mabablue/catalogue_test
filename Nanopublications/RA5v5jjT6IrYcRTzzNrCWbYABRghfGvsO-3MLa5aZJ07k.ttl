@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA5v5jjT6IrYcRTzzNrCWbYABRghfGvsO-3MLa5aZJ07k/> .

<https://w3id.org/iadopt/variable/DNAstrandBreaks> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "DNA strand break frequency in cells",
        "DNA strand breaks" ;
    dcterms:description "interruptions in the phosphodiester backbone of DNA, occurring as single- or double-strand breaks due to genotoxic stress." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25830> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:DNAstrandBreaks .

