@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAhzUBSMVSAn6EuBqug5PkuMFH5zVgnTjiaWSAuFLyyVk/> .

<https://w3id.org/iadopt/variable/SkinModelViability> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Skin model viability",
        "viability of reconstructed skin model" ;
    dcterms:description "the percentage of viable cells in a reconstructed skin model." ;
    iop:hasObjectOfInterest sub:inVitroSkinModel ;
    iop:hasProperty sub:skinModelViability .

