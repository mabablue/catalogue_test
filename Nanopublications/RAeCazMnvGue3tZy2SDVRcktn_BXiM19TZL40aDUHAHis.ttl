<https://w3id.org/iadopt/variable/LogKoc> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Log Koc",
        "Log Koc of substance" ;
    dcterms:description "the logarithm (base 10) of the organic-carbon-normalized soil–water partition coefficient of a substance, describes the tendency of a substance to adsorb to soil organic carbon relative to remaining in the aqueous phase." ;
    rdfs:seeAlso <https://www.oecd.org/content/dam/oecd/en/publications/reports/2001/01/test-no-121-estimation-of-the-adsorption-coefficient-koc-on-soil-and-on-sewage-sludge-using-high-performance-liquid-chromatography-hplc_g1gh28ef/9789264069909-en.pdf?utm_source=chatgpt.com> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:LogKoc .

