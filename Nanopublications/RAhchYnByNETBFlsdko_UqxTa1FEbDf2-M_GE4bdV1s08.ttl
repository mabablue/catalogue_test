@prefix sub: <https://w3id.org/np/RAhchYnByNETBFlsdko_UqxTa1FEbDf2-M_GE4bdV1s08/> .

<https://w3id.org/iadopt/variable/LC3-II/Iratio> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "LC3-II/I ratio",
        "LC3-II/I ratio in cells" ;
    dcterms:description "the ratio of lipidated LC3-II to cytosolic LC3-I, used as an indicator of autophagosome formation and autophagy activity." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty <https://w3id.org/np/RAhchYnByNETBFlsdko_UqxTa1FEbDf2-M_GE4bdV1s08/LC3-II/Iratio> .

