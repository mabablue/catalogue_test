@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAwl8hTlgtNA1BAuDLBTUY1bDprmCMvpZX0SuYxYc9LqM/> .

<https://w3id.org/iadopt/variable/BALprotein> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "BAL protein",
        "BAL protein from exposed animal" ;
    dcterms:description "the concentration of total protein in bronchoalveolar lavage fluid, used as an indicator of lung epithelial barrier damage and inflammation." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:proteinConcentrationInBAL .

