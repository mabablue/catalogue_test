@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2epmkX5MRgGIbDUQXh1Fp0-HqofVktGxnSSI0abuA4c/> .

<https://w3id.org/iadopt/variable/CognitiveTests> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Cognitive tests",
        "cognitive test performance in exposed animal" ;
    dcterms:description "behavioral assessments used to evaluate learning, memory, and other higher neurological functions following exposure to a substance." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:cognitiveFunction .

