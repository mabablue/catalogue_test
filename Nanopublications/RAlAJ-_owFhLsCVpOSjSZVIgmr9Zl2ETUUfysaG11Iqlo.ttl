@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAlAJ-_owFhLsCVpOSjSZVIgmr9Zl2ETUUfysaG11Iqlo/> .

<https://w3id.org/iadopt/variable/UnitCell> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Unit cell" ;
    dcterms:description "The smallest, regularly repeating material portion of a crystalline lattice" ;
    iop:hasObjectOfInterest sub:UnitCell ;
    iop:hasProperty <http://purl.obolibrary.org/obo/PROCO_0000120> .

