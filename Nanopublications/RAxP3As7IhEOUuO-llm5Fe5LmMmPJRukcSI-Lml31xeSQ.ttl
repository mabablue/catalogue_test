@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAxP3As7IhEOUuO-llm5Fe5LmMmPJRukcSI-Lml31xeSQ/> .

<https://w3id.org/iadopt/variable/HydrodynamicDiameter> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Hydrodynamic diameter",
        "Hydrodynamic size" ;
    dcterms:description "The hydrodynamic size which is the diameter of a particle or molecule (approximated as a sphere) in an aqueous solution" ;
    iop:hasObjectOfInterest sub:NP ;
    iop:hasProperty <http://purl.bioontology.org/ontology/npo#NPO_1915> .

