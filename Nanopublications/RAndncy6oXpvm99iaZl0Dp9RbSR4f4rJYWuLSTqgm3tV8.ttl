@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAndncy6oXpvm99iaZl0Dp9RbSR4f4rJYWuLSTqgm3tV8/> .

<https://w3id.org/iadopt/variable/Henry’sLawConstant> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Henry’s law constant",
        "Henry’s law constant of substance" ;
    dcterms:description "the ratio of a gas’s partial pressure to its equilibrium concentration in a liquid, expressed in Pa·m³/mol." ;
    rdfs:seeAlso <http://semanticscience.org/resource/CHEMINF_000433> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:constant .

