<https://w3id.org/iadopt/variable/D19> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average coordination parameter (4Ang) of all atoms" ;
    dcterms:description "The average coordination parameter (4Ang) of all nanoparticle atoms" ;
    iop:hasObjectOfInterest sub:NPAtomAverageCoordination ;
    iop:hasProperty sub:Coordination4Ang .

