@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAF845wkI0Qxak5nvuU7zby6BmXwCiJORkqYgjbjbyBCE/> .

<https://w3id.org/iadopt/variable/Dispersibility> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Dispersibility",
        "dispersibility of material" ;
    dcterms:description "the ability of a substance, typically solid particles, to be distributed uniformly throughout a liquid or gas medium, often involving the de-agglomeration of particles." ;
    rdfs:seeAlso <https://www.sciencedirect.com/topics/engineering/dispersibility#:~:text=Dispersibility%2C%20generally%20defined%20as%20a,index%2C%20a%20measure%20of%20dispersibility.> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:dispersibility .

