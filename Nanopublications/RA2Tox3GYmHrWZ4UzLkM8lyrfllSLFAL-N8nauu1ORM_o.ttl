@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2Tox3GYmHrWZ4UzLkM8lyrfllSLFAL-N8nauu1ORM_o#> .

sub:numberNervousityFeelings a iop:Variable ;
    rdfs:label "Number of nervosity feelings in past 30 days",
        "Number of times or how often one had nervosity feelings in past 30 days" ;
    dcterms:description "Number of nervosity feelings counted in the unit of number per past 30 days. Nervousness is a quality of feeling anxious, worried, or alarmed." ;
    rdfs:seeAlso <https://www.vocabulary.com/dictionary/nervousness> ;
    iop:hasConstraint <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C74532> ;
    iop:hasContextObject <http://purl.obolibrary.org/obo/NCBITaxon_9606> ;
    iop:hasObjectOfInterest <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C77965> ;
    iop:hasProperty <http://vocab.nerc.ac.uk/collection/P21/current/MS7073/> .

<http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C74532> a iop:Constraint ;
    iop:constrains <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C77965> .

