@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAAt08BMMHCWYyNz-Vtkn5Bz8P-ffGpSyps12znbeiN_8/> .

<https://w3id.org/iadopt/variable/SurfaceRoughness> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Surface roughness",
        "surface roughness of material" ;
    dcterms:description "the measure of the deviations of a surface from flatness, representing the micro- or nanoscale texture." ;
    rdfs:seeAlso <https://w3id.org/pmd/co/Roughness> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:SurfaceRoughness .

