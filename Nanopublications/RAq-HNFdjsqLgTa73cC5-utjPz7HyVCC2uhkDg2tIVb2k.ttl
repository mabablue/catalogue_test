@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAq-HNFdjsqLgTa73cC5-utjPz7HyVCC2uhkDg2tIVb2k/> .

<https://w3id.org/iadopt/variable/MatingIndex> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Mating index",
        "mating index in exposed animals" ;
    dcterms:description "the proportion of mating pairs that successfully mate during a defined breeding period." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:matingSuccess .

