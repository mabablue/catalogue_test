@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RADKt6BLM6e72blj0pXpF92AtHVAia-ObDx523K7xZS3U/> .

<https://w3id.org/iadopt/variable/SumMetalIonisationPotentialEnergy> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Sum of metal ionization potential energy" ;
    dcterms:description "The final aggregate amount of the potential energy that binds an electron to a electropositive chemical element that is characterised by ductility, malleability, luster, and conductance of heat and electricity. They can replace the hydrogen of an acid and form bases with hydroxyl radicals" ;
    iop:hasObjectOfInterest sub:Metal ;
    iop:hasProperty sub:SumMetalIonisationPotentialEnergy .

