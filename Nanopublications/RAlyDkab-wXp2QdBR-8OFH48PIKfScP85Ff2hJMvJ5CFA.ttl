@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAlyDkab-wXp2QdBR-8OFH48PIKfScP85Ff2hJMvJ5CFA/> .

<https://w3id.org/iadopt/variable/MordredDescriptors> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Mordred descriptors" ;
    dcterms:description "Mordred descriptors are a set of 1,826 molecular descriptors generated by the Mordred Python library, which is widely used for cheminformatics and QSAR/QSPR modelling. Mordred descriptors are numerical values that encode a wide range of chemical and structural properties of molecules" ;
    rdfs:seeAlso <https://doi.org/10.1186/s13321-018-0258-y> ;
    iop:hasObjectOfInterest sub:Chemicals ;
    iop:hasProperty <https://mordred-descriptor.github.io/documentation/master/descriptors.html> .

