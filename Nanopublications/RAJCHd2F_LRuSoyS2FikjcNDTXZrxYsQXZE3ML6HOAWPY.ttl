@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAJCHd2F_LRuSoyS2FikjcNDTXZrxYsQXZE3ML6HOAWPY/> .

<https://w3id.org/iadopt/variable/AgglomerationInExposureMedia> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Agglomeration in exposure media",
        "agglomeration state in exposure media" ;
    dcterms:description "the clustering of nanoparticles into larger assemblies within the exposure medium." ;
    iop:hasObjectOfInterest sub:exposureMedium ;
    iop:hasProperty sub:agglomerationState .

