@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAX_h5xQiHbS-2JI3L8WQ7GYH_FWf-i20UDNtowBb-20Y/> .

<https://w3id.org/iadopt/variable/RootHairDensity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Root hair density",
        "root hair density/length of plant" ;
    dcterms:description "A root morphology trait which is the number of root hairs in a given surface area of a root." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/TO_0001051> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:RootHairDensity .

