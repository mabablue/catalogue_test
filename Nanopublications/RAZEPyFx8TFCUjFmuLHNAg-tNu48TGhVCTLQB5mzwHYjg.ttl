@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAZEPyFx8TFCUjFmuLHNAg-tNu48TGhVCTLQB5mzwHYjg#> .

sub:IADOPT.MaternalEducationLevel a iop:Variable ;
    rdfs:label "Education level of the mother of the study participant (ISCED)" ;
    dcterms:description "Education level of the mother of the study participant (ISCED)" ;
    rdfs:seeAlso <https://hbm.vito.be/tools/data-harmonization> ;
    iop:hasConstraint <https://hbm.vito.be/tools/data-harmonization#OfTheMother>,
        <https://hbm.vito.be/tools/data-harmonization#StudyParticipant> ;
    iop:hasObjectOfInterest sub:Person ;
    iop:hasProperty <https://hbm.vito.be/tools/data-harmonization#EducationLevel> .

