@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RArn_yqyQGJf-HxPdp8YyCfz7Ic-bJRcYn_rsgtfwLq7Y/> .

<https://w3id.org/iadopt/variable/GerminationOfProducedSeeds> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Germination of produced seeds",
        "germination rate of produced seeds" ;
    dcterms:description "the ability of seeds formed by a plant to germinate and initiate seedling growth." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:SeedViability .

