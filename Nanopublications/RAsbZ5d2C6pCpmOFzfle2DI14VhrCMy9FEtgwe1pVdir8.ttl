@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAsbZ5d2C6pCpmOFzfle2DI14VhrCMy9FEtgwe1pVdir8/> .

<https://w3id.org/iadopt/variable/IonisationPotentialEnergyActiveMetals> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Ionisation potential energy of active metals" ;
    dcterms:description "The potential energy that binds an electron to an atom or molecule, in this instance attributable to electropositive chemical elements characterised by ductility, malleability, luster, and conductance of heat and electricity  that are exerting influence or producing an effect" ;
    iop:hasObjectOfInterest sub:Metal ;
    iop:hasProperty sub:IonisationPotentialEnergy .

