@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATEmyP6YTlN17RANL7MlY8m4dvSz9NgJyp3HXJEw7E08/> .

<https://w3id.org/iadopt/variable/ClinicalSigns> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Clinical signs",
        "clinical signs in exposed animal" ;
    dcterms:description "observable physiological or behavioral abnormalities in organisms following exposure to a substance." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:clinicalsignseverity .

