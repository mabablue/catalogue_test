@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA9KWpjc0ar9CQAwaRQjD9PeK69lMcNqKrawsliPFbK9M/> .

<https://w3id.org/iadopt/variable/CrystallizationTemperature> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Crystallization temperature" ;
    dcterms:description "the temperature at which a polymer crystallizes from the melt or amorphous state upon cooling." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:CrystallizationTemperature .

