@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAsH6lXr3s5GLyEU3BD5G08OZuZVVJwjBY2Aklntmkkuo/> .

<https://w3id.org/iadopt/variable/PhotocatalyticActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Photocatalytic activity",
        "photocatalytic activity of material" ;
    dcterms:description "the rate at which a material accelerates a light-driven chemical reaction." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/200906083550451645> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:PhotocatalyticActivity .

