    <https://w3id.org/iadopt/ont/hasConstraint> "Antibacterial applications", "Carbon-based",
      "Measured by BET";
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> "Nanomaterials";
    <https://w3id.org/iadopt/ont/hasProperty> "Specific surface area" .
}

