@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGVfnPw-6Pl52YWE8nJGnsnHJGhdYaKptr8P2OiaqP8g/> .

<https://w3id.org/iadopt/variable/EarlyApoptosis> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Early apoptosis",
        "early apoptosis level in cells" ;
    dcterms:description "the initial phase of programmed cell death characterized by membrane phosphatidylserine externalization while membrane integrity is still preserved." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:EarlyApoptosisLevel .

