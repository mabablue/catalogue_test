@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAzqWI_Sz4aw_tI2n-iklAAAxkvZBxsKzUaqEaEZfGDpk/> .

<https://w3id.org/iadopt/variable/Photoperiod> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Light cycle",
        "Photoperiod" ;
    dcterms:description "The time period of daily exposure that an organism receives from daylight or artificial light. It is believed that photoperiodic responses may affect the control of energy balance and thermoregulation" ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D017440> ;
    iop:hasObjectOfInterest sub:LightCycle ;
    iop:hasProperty <http://purl.bioontology.org/ontology/MESH/D017440> .

