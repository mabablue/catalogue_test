@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA7bmNqeAYqNN6EnSuCABgzhbDGLgJgOIFk4yMtUTg-DU/> .

<https://w3id.org/iadopt/variable/UnitCellDimensionsExperimental> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Unit cell dimensions (experimental, e.g., using Rietveld refinement)" ;
    dcterms:description "Experimentally derived, e.g., from XRD data using Rietveld refinement, lengths of the three unit cell axes (a, b, c)" ;
    iop:hasObjectOfInterest sub:UnitCell ;
    iop:hasProperty sub:UnitCellDimensionsExperimental .

