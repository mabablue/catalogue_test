@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAc1_rRnugz8843Wz50sANm6dHj5hKLdZUBQt9pFwCNSA/> .

<https://w3id.org/iadopt/variable/Odour> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Odour",
        "odour of substance" ;
    dcterms:description "the property of a substance that gives it a characteristic scent or smell." ;
    rdfs:seeAlso <http://www.co-ode.org/ontologies/galen#Odour> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:odour .

