@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAZeRmbCZg7Ok-NM7Fdvhvlfkto_fC5hfbUNZWL0fs1bs/> .

<https://w3id.org/iadopt/variable/ActiveMetalloidNeutrons> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Quantity of Active Metalloid neutrons" ;
    dcterms:description "How many elementary particles with 0 charge and a mass about equal to that of a proton there are, that are attributable materials that are exerting influence or producing an effect and are from elements with properties between a metal and a non-metal" ;
    iop:hasObjectOfInterest sub:Metalloid ;
    iop:hasProperty sub:ActiveMetalloidNeutrons .

