@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RABvTjprQlJqhylBr4C-ZtKKZKnP0wryygtnj-gELcHto#> .

sub:variable18 a iop:Variable ;
    rdfs:label "Biological sex",
        "Biological sex [female | male | intersex | unknown]" ;
    iop:hasContextObject <http://purl.bioontology.org/ontology/PMR.owl#Female>,
        <http://purl.bioontology.org/ontology/PMR.owl#Male>,
        <http://purl.org/doves/doves-ontology#Unknown> ;
    iop:hasMatrix <http://purl.bioontology.org/ontology/PMR.owl#Finding_related_to_biological_sex> ;
    iop:hasObjectOfInterest <http://www.owl-ontologies.com/BiodiversityOntologyFull.owl#BioticEntity> ;
    iop:hasProperty <http://www.owl-ontologies.com/BiodiversityOntologyFull.owl#Sex> .

