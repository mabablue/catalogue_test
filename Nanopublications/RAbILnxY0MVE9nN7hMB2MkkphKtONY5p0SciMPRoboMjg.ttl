@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbILnxY0MVE9nN7hMB2MkkphKtONY5p0SciMPRoboMjg/> .

<https://w3id.org/iadopt/variable/SuperoxideDismutaseActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Superoxide dismutase (SOD) activity",
        "superoxide dismutase activity in exposed invertebrate organism" ;
    dcterms:description "the enzymatic neutralisation of superoxide radicals." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0004784> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:SuperoxideDismutaseSodActivity .

