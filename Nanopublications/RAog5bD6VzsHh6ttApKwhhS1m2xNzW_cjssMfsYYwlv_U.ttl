@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAog5bD6VzsHh6ttApKwhhS1m2xNzW_cjssMfsYYwlv_U/> .

<https://w3id.org/iadopt/variable/DataQualityScore> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Data quality score" ;
    dcterms:description "A number or range of numeric values measuring performance, function, quality, or ability pertaining to the condition of information that describes its credibility, authenticity, and appropriateness for its function. Important aspects include source recognition, accuracy, innovativeness, and information on changes to the data" ;
    iop:hasObjectOfInterest sub:Data ;
    iop:hasProperty sub:QualityScore .

