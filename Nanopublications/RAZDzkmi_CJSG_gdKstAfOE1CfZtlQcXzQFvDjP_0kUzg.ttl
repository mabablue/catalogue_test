@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAZDzkmi_CJSG_gdKstAfOE1CfZtlQcXzQFvDjP_0kUzg/> .

<https://w3id.org/iadopt/variable/AtomicCoordinates> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Atomic coordinates" ;
    dcterms:description "The spatial positions of atoms within a molecule or crystal structure, typically represented using Cartesian or fractional coordinates" ;
    iop:hasObjectOfInterest sub:UnitCell ;
    iop:hasProperty sub:AtomicCoordinates .

