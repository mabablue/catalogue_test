@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RArL4JrkhEHQz6KG0dONjvbOoo47ymp5gyK1Okx2YuDQ0/> .

<https://w3id.org/iadopt/variable/FatigueLife> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Fatigue life",
        "fatigue life of material" ;
    dcterms:description "the number of stress cycles a material can endure before failure under cyclic loading." ;
    rdfs:seeAlso <https://www.sciencedirect.com/topics/engineering/fatigue-life> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:FatigueLife .

