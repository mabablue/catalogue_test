@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAXklnOf1wY3oDtApbq83Alk3QhTzHgJXgPT_k22hLFx4/> .

<https://w3id.org/iadopt/variable/SynthesisRoute> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Synthesis route",
        "synthesis route of material" ;
    dcterms:description "the sequence of chemical reactions and processing steps used to create a target molecule." ;
    iop:hasObjectOfInterest sub:Material ;
    iop:hasProperty sub:SynthesisMethod .

