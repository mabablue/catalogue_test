@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAd0eYVg58_z-RA-VBEGeCNIkbDuiV7Aech1qiFqWb8Jw/> .

<https://w3id.org/iadopt/variable/BulkDensity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Bulk density",
        "bulk density of substance" ;
    dcterms:description "Mass per unit volume." ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:BulkDensity .

