<https://w3id.org/iadopt/variable/GlutathioneS-transferaseActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Glutathione S-transferase (GST) activity",
        "glutathione s-transferase activity in exposed invertebrate organism" ;
    dcterms:description "the enzymatic detoxification of harmful compounds, protecting neural tissues." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C16641> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:GlutathioneSTransferaseGstActivity .

