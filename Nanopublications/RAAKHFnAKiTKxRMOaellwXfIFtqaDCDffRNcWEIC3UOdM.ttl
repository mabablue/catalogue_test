@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAAKHFnAKiTKxRMOaellwXfIFtqaDCDffRNcWEIC3UOdM/> .

<https://w3id.org/iadopt/variable/IL-1βSecretion> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "IL-1β secretion",
        "IL-1β secretion from cells" ;
    dcterms:description "the release of the pro-inflammatory cytokine interleukin-1 beta by cells in response to stimuli or stress." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:IL-1βSecretionRate .

