@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAtOcsiMroT2mjTGQfR-N6RnVRMQ80kQJ-_Dww9aj9uCY#> .

sub:IAdoptChallenge26 a iop:Variable ;
    rdfs:label "Sheet resistance of layer of gold" ;
    dcterms:description "The sheet resistance of a 5-nanometer-thick layer of gold." ;
    iop:hasConstraint sub:layer,
        sub:sheet ;
    iop:hasObjectOfInterest <http://vocab.nerc.ac.uk/collection/S27/current/CS003313/> ;
    iop:hasProperty <https://w3id.org/ozcar-theia/c_6d042bb4> .

sub:layer a iop:Constraint ;
    iop:constrains <http://vocab.nerc.ac.uk/collection/S27/current/CS003313/> .

sub:sheet a iop:Constraint ;
    iop:constrains <https://w3id.org/ozcar-theia/c_6d042bb4> .

