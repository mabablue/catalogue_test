@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAsdFmpQcJlE6A3hp8jfxxY1A0qQf6g-pVaPAMV3_rl_I/> .

<https://w3id.org/iadopt/variable/CoagulationInterference> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Coagulation interference",
        "interference with coagulation in vitro" ;
    dcterms:description "the alteration of normal blood clotting processes caused by interaction with a substance." ;
    iop:hasObjectOfInterest sub:coagulationSystem ;
    iop:hasProperty sub:coagulationInterference .

