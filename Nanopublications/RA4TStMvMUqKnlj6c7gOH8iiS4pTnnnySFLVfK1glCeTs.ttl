<https://w3id.org/iadopt/variable/GlutathionePeroxidaseActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Glutathione peroxidase (GPx) activity",
        "glutathione peroxidase (gpx) activity in exposed invertebrate organism" ;
    dcterms:description "the enzymatic reduction of peroxides to protect cells." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0004602> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:GlutathionePeroxidaseGpxActivity .

