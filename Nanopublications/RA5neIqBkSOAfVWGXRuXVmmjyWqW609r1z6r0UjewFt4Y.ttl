@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA5neIqBkSOAfVWGXRuXVmmjyWqW609r1z6r0UjewFt4Y/> .

<https://w3id.org/iadopt/variable/DielectricLoss> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Dielectric loss",
        "dielectric loss of material" ;
    dcterms:description "a measure of energy dissipated as heat in a dielectric material under an alternating electric field." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:DielectricLoss .

