@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RASNauYxodN-CvxH3KvC5ZAe2c8uhbP_la_vuZfsquWuE/> .

<https://w3id.org/iadopt/variable/ShootLength> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Shoot length",
        "shoot length of plant" ;
    dcterms:description "the measured length of the aboveground shoot of a plant" ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/FLOPO_0019017> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:ShootLength .

