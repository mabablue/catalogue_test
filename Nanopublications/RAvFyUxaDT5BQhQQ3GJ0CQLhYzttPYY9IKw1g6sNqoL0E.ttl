@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAvFyUxaDT5BQhQQ3GJ0CQLhYzttPYY9IKw1g6sNqoL0E#> .

sub:ex1.gr5 a iop:Variable ;
    rdfs:label "Mass concentration of Aldrin in air" ;
    dcterms:description "Mass concentration of Aldrin in air (passive sampler PUF, ng per sampler)" ;
    iop:hasConstraint sub:unit_per_sampler ;
    iop:hasMatrix sub:air ;
    iop:hasObjectOfInterest sub:Aldrin ;
    iop:hasProperty sub:mass_concentration .

