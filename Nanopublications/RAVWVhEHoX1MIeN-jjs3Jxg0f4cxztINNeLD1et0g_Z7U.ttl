@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAVWVhEHoX1MIeN-jjs3Jxg0f4cxztINNeLD1et0g_Z7U/> .

<https://w3id.org/iadopt/variable/MoltingFrequency> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Molting frequency",
        "molting frequency in exposed invertebrate organism" ;
    dcterms:description "the number of molting events occurring over a given period." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D018978> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:MoltingFrequency .

