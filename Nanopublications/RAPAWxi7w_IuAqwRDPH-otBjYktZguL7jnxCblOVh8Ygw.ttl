@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAPAWxi7w_IuAqwRDPH-otBjYktZguL7jnxCblOVh8Ygw/> .

<https://w3id.org/iadopt/variable/WaterSolubility> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Water solubility",
        "water solubility of substance" ;
    dcterms:description "the ability of a certain amount of solid, liquid or gaseous chemical substance to dissolve in a certain volume of water solvent." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_500> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:waterSolubility .

