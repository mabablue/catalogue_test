<https://w3id.org/iadopt/variable/OxidativeDNADamage> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Oxidative DNA damage",
        "oxidative DNA damage in cells" ;
    dcterms:description "DNA modification caused by reactive oxygen species." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C198713> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:OxidativeDNADamage .

