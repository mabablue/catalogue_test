<https://w3id.org/iadopt/variable/ArCom1> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Ar-Component 1 (Com1)" ;
    dcterms:description "Atomic mass (Ar) of the first nanoparticle component 1 (Com1). E.g., for TiO2, Com1(Ti) = 47.87." ;
    iop:hasObjectOfInterest sub:Com1 ;
    iop:hasProperty sub:ArCom1 .

