<https://w3id.org/iadopt/variable/ResidualCatalyst/Surfactant> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Residual catalyst",
        "residual catalyst/surfactant content of material" ;
    dcterms:description "the concentration of catalyst or surfactant remaining in a material after synthesis and purification." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty <https://w3id.org/np/RAdVOQMsdNOUyF0SHoFbUtsQVS_xbgBpiCBuHYUOK1EJY/ResidualCatalyst/SurfactantContent> .

