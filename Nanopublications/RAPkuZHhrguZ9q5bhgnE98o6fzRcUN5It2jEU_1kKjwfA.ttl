@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAPkuZHhrguZ9q5bhgnE98o6fzRcUN5It2jEU_1kKjwfA/> .

<https://w3id.org/iadopt/variable/SoftwareSustainabilityPlan> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Software Sustainability Plan",
        "The sustainability plan of a software" ;
    dcterms:description "A documented plan describing how the software will be maintained, supported, governed, and resourced over time (e.g., maintenance responsibilities, funding model, community strategy, release/support policy, and succession/archiving plans)." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:SustainabilityPlan .

