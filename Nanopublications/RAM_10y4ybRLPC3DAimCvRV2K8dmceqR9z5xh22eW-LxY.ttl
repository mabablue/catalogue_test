@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAM_10y4ybRLPC3DAimCvRV2K8dmceqR9z5xh22eW-LxY/> .

<https://w3id.org/iadopt/variable/EffectiveQuantumYield> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Effective quantum yield (ΦPSII)",
        "effective quantum yield of plant" ;
    dcterms:description "the efficiency of photosystem II in converting light energy to chemical energy under light-adapted conditions." ;
    rdfs:seeAlso <https://www.frontiersin.org/journals/plant-science/articles/10.3389/fpls.2025.1478346/full> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:EffectiveQuantumYield .

