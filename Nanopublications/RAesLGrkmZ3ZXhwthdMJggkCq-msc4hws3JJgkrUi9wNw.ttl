@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAesLGrkmZ3ZXhwthdMJggkCq-msc4hws3JJgkrUi9wNw#> .

sub:TOC a iop:Variable ;
    rdfs:label "Percentage of total organic carbon in sediment" ;
    dcterms:description "It is the measure of total organic carbon(TOC) in sediment" ;
    iop:hasMatrix sub:sediment ;
    iop:hasObjectOfInterest sub:totalorganiccarbon ;
    iop:hasProperty sub:Percentage .

