@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA50Q_CeCTmNrhw0GqqxxWEEoiglQzqfVFXBFVeOG_E30/> .

<https://w3id.org/iadopt/variable/VanderWaalsRadiusMetals> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Van der Waals radius of active metals" ;
    dcterms:description "Half of the equilibrium distance at the minimum of the van der Waals potential between two isolated atoms of chemical elements that are exerting influence or producing an effect and are electropositive chemical elements characterised by ductility, malleability, luster, and conductance of heat and electricity" ;
    iop:hasObjectOfInterest sub:Metal ;
    iop:hasProperty sub:VanderWaalsRadius .

