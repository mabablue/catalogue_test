<https://w3id.org/iadopt/variable/Localization(tissue/cellular)> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Localization (tissue/cellular)",
        "localization of test substance" ;
    dcterms:description "he spatial distribution of a substance within plant tissues or cells" ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0051641> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:SpatialDistribution .

