@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAcM7cyWMp3RPW31VmtisAdyQ3I0cAdW0t26WIDi_jI30/> .

<https://w3id.org/iadopt/variable/RadicalFormationPotential> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Radical formation potential",
        "radical formation potential of substance" ;
    dcterms:description "the propensity of a substance or material to generate free radicals under specific conditions." ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:RadicalFormationPotential .

