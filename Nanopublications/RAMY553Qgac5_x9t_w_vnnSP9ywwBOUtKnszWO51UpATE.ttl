@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAMY553Qgac5_x9t_w_vnnSP9ywwBOUtKnszWO51UpATE/> .

<https://w3id.org/iadopt/variable/Permeability> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Permeability (Papp)",
        "apparent permeability across barrier" ;
    dcterms:description "A rate measure of how quickly a compound crosses a biological or artificial membrane, expressed in centimeters per second (cm/s), calculated from the transport rate normalized to membrane area and donor concentration." ;
    rdfs:seeAlso <http://www.bioassayontology.org/bao#BAO_0002808> ;
    iop:hasObjectOfInterest sub:BarrierModel ;
    iop:hasProperty sub:ApparentPermeability .

