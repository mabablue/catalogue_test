@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2tBwvYniHVfrGVqZtbzK5NNmc7ly1jgBfU2okeUbpAM/> .

<https://w3id.org/iadopt/variable/Assimilation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Gas exchange – assimilation (A)",
        "gas exchange assimilation of plant" ;
    dcterms:description "the rate at which a plant leaf fixes carbon dioxide during photosynthesis." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:PhotosyntheticAssimilationRate .

