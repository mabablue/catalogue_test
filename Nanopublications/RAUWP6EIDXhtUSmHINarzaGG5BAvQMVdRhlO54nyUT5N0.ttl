@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAUWP6EIDXhtUSmHINarzaGG5BAvQMVdRhlO54nyUT5N0/> .

<https://w3id.org/iadopt/variable/HydrolysisRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Hydrolysis rate",
        "hydrolysis rate of substance" ;
    dcterms:description "the rate at which a substance reacts with water resulting in chemical bond cleavage." ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:HydrolysisRate .

