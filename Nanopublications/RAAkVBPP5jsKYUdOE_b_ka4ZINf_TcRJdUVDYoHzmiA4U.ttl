@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAAkVBPP5jsKYUdOE_b_ka4ZINf_TcRJdUVDYoHzmiA4U/> .

<https://w3id.org/iadopt/variable/Platelets> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Platelets",
        "platelet count in blood" ;
    dcterms:description "Non-nucleated disk-shaped cells formed in the megakaryocyte and found in the blood of all mammals. They are mainly involved in blood coagulation." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D001792> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:plateletcount .

