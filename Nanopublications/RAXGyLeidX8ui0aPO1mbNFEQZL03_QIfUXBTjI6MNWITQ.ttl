@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAXGyLeidX8ui0aPO1mbNFEQZL03_QIfUXBTjI6MNWITQ/> .

<https://w3id.org/iadopt/variable/ParticleDissolution> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Particle dissolution",
        "particle dissolution in plant" ;
    dcterms:description "the process by which nanoparticles or nanomaterials dissolve in a medium, releasing ions or molecular species." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:particledissolution .

