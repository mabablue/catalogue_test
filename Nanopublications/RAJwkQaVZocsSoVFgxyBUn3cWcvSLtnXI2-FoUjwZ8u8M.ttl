@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAJwkQaVZocsSoVFgxyBUn3cWcvSLtnXI2-FoUjwZ8u8M/> .

<https://w3id.org/iadopt/variable/Multi-generationReproduction> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Multi-generation reproduction",
        "multi-generation reproduction in exposed invertebrate organism" ;
    dcterms:description "reproductive performance across generations" ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:MultiGenerationReproduction .

