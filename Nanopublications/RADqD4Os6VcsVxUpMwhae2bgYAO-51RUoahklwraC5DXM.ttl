@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RADqD4Os6VcsVxUpMwhae2bgYAO-51RUoahklwraC5DXM/> .

<https://w3id.org/iadopt/variable/TransformationInRhizosphere> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Transformation in rhizosphere",
        "transformation of test substance in rhizosphere" ;
    dcterms:description "the alteration of a substance within the root-influenced soil zone." ;
    iop:hasObjectOfInterest sub:soil ;
    iop:hasProperty sub:ChemicalTransformation .

