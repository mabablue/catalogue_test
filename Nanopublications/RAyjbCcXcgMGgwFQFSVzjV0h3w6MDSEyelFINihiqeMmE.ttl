@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAyjbCcXcgMGgwFQFSVzjV0h3w6MDSEyelFINihiqeMmE/> .

<https://w3id.org/iadopt/variable/SeparationMethod> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Separation method" ;
    dcterms:description "A method that results in the separation of two or more components according to some property" ;
    iop:hasObjectOfInterest sub:Sample ;
    iop:hasProperty <http://purl.obolibrary.org/obo/CHMO_0000999> .

