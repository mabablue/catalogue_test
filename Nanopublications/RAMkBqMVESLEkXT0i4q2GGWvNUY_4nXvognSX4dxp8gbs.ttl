@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAMkBqMVESLEkXT0i4q2GGWvNUY_4nXvognSX4dxp8gbs/> .

<https://w3id.org/iadopt/variable/AgNPCitratePretreated> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Citrate-pretreated Silver nanoparticle",
        "Citric acid-pretreated Silver nanoparticle" ;
    iop:hasObjectOfInterest sub:AgNP ;
    iop:hasProperty sub:AgNPCitratePretreated .

