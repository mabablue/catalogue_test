@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGnncIFVlhYKrE4wD2--7ebJvSSr64N27OnMvxehd5HI/> .

<https://w3id.org/iadopt/variable/PhenoloxidaseActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Phenoloxidase activity",
        "phenoloxidase activity in exposed invertebrate organism" ;
    dcterms:description "the ability of immune cells to engulf foreign particles." ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:PhenoloxidaseActivity .

