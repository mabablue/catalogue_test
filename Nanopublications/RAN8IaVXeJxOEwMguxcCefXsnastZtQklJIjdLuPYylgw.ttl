@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAN8IaVXeJxOEwMguxcCefXsnastZtQklJIjdLuPYylgw/> .

<https://w3id.org/iadopt/variable/Cmax> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Cmax",
        "maximum plasma concentration (Cmax) of test substance" ;
    dcterms:description "the highest concentration of a substance measured in blood, plasma, or tissue following administration." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:maximumconcentration .

