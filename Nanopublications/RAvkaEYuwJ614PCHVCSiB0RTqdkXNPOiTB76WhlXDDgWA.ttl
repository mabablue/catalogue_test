@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAvkaEYuwJ614PCHVCSiB0RTqdkXNPOiTB76WhlXDDgWA/> .

<https://w3id.org/iadopt/variable/IonReleaseProfile> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Ion release profile",
        "ion release profile of material" ;
    dcterms:description "the rate and amount of ions that are released from a material over time" ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:IonReleaseProfile .

