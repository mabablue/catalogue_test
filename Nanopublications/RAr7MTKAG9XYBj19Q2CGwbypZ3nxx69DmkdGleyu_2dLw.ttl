@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAr7MTKAG9XYBj19Q2CGwbypZ3nxx69DmkdGleyu_2dLw/> .

<https://w3id.org/iadopt/variable/SizeDistributionAFM> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Nanomaterial size distribution measured with AFM" ;
    iop:hasObjectOfInterest sub:Nanomaterial ;
    iop:hasProperty sub:SizeDistribution .

