@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAUkv8DmuOvl0F1MNf1cjkf7Z__9oPFViOKDONSV1LfGI/> .

<https://w3id.org/iadopt/variable/GlassTransitionTemperature> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Glass transition temperature" ;
    dcterms:description "the temperature region where the polymer transitions from a hard, glassy material to a soft, rubbery material." ;
    iop:hasObjectOfInterest sub:Chemicals ;
    iop:hasProperty <http://materialsmine.org/ns/GlassTransitionTemperature> .

