@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAXqD6Fy6QE2Nl3fHHTvHYQ1vrmdS0vkO632XN1yxcEwA/> .

<https://w3id.org/iadopt/variable/PhotodegradationRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Photodegradation rate",
        "photodegradation rate of substance" ;
    dcterms:description "the rate at which a substance undergoes chemical transformation or breakdown as a result of exposure to light" ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:PhotodegradationRate .

