@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATbw6ZwAQzw_cONOKcn1OU3MBtcdGNc8WM-H6QY8laDk/> .

<https://w3id.org/iadopt/variable/MeltingPoint> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Melting point" ;
    dcterms:description "the temperature at which a chemical substance undergoes the transition from solid to liquid state under standard conditions." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty <http://semanticscience.org/resource/CHEMINF_000256> .

