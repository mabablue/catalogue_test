@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAUFOtLIDEmW0nRmIfy40Bj5sXi586nh4n68hZQuox2zw/> .

<https://w3id.org/iadopt/variable/SizeAFM> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Nanomaterial size measured with AFM" ;
    iop:hasObjectOfInterest sub:Nanomaterial ;
    iop:hasProperty sub:Size .

