@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAcpnKatIV7iyjgmiF0LyEKXcp4TeMFhpLIPmF_R73PpE/> .

<https://w3id.org/iadopt/variable/TEER> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "TEER",
        "TEER of barrier model" ;
    dcterms:description "the electrical resistance measured across a cell layer, used to assess the integrity and permeability of biological barriers." ;
    iop:hasObjectOfInterest sub:BarrierModel ;
    iop:hasProperty sub:TransepithelialElectricalResistance .

