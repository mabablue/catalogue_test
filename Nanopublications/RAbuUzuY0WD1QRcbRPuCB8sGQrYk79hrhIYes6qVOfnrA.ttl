@prefix sub: <https://w3id.org/np/RAbuUzuY0WD1QRcbRPuCB8sGQrYk79hrhIYes6qVOfnrA/> .

<https://w3id.org/iadopt/variable/D39> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Lattice energy of NP divided by the NP diameter in eV/A" ;
    dcterms:description "D39: Lattice energy of the nanoparticle divided by the nanoparticle diameter in eV/A" ;
    iop:hasObjectOfInterest sub:Nanoparticle ;
    iop:hasProperty sub:NormalisedLatticeEnergy .

