@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGlsMBV_SFE8lBgIo_JBJZCJKtcl5hJ-phFXhPaWjLME/> .

<https://w3id.org/iadopt/variable/LipidPeroxidation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Lipid peroxidation",
        "lipid peroxidation level in cells" ;
    dcterms:description "the oxidative degradation of membrane lipids caused by reactive oxygen or nitrogen species." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D015227> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:lipidperoxidationlevel .

