@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAXgaQAYWh-L66GwXbpOlXnjx8W-oHqZFhqD8Wm38kSJ0/> .

<https://w3id.org/iadopt/variable/RelativeGrowthRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Relative growth rate (RGR)",
        "relative growth rate of plant" ;
    dcterms:description "A vigor trait that is the increase in aboveground biomass in a defined period of time." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/TO_0000515> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:RelativeGrowthRate .

