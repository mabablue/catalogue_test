@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAPHDAbKwlI3pW_4Wec5DBxO5ya5idQt9BcGJ91CN9cCM/> .

<https://w3id.org/iadopt/variable/TSETDQM> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Overall Total Survey Error or Total Data Quality score" ;
    iop:hasObjectOfInterest sub:Data ;
    iop:hasProperty sub:QualityScore .

