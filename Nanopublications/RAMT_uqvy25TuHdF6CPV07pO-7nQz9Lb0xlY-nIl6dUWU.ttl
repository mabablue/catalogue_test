@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAMT_uqvy25TuHdF6CPV07pO-7nQz9Lb0xlY-nIl6dUWU/> .

<https://w3id.org/iadopt/variable/Fecundity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Seed set / fecundity",
        "seed set/fecundity of plant" ;
    dcterms:description "The process by which flowers develop into mature seeds following successful pollination and fertilization, representing a critical reproductive stage" ;
    rdfs:seeAlso <https://w3id.org/bervo/BERVO_8000159> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:SeedProduction .

