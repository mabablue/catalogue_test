@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAx81uvkLeaecyLReCRHrsqaWw4wjDtATWuNGQ29sKaSI/> .

<https://w3id.org/iadopt/variable/StomatalDensity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Stomatal density",
        "stomatal density of plant leaves" ;
    dcterms:description "the number of stomata per unit area of leaf surface." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/201006031671698959> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:StomatalDensity .

