@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAJ3kyroLbkO7iTQyiomJgYxpGnLwzv4e-R4CgZpRMqvM/> .

<https://w3id.org/iadopt/variable/HLBvalue> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "HLB value",
        "HLB value of substance" ;
    dcterms:description "a dimensionless measure of the relative hydrophilic and lipophilic character of a surfactant." ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:HLBvalue .

