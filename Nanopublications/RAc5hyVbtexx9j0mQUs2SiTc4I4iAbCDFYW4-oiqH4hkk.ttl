@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAc5hyVbtexx9j0mQUs2SiTc4I4iAbCDFYW4-oiqH4hkk/> .

<https://w3id.org/iadopt/variable/Whole-bodyConcentration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Whole-body concentration",
        "whole-body concentration in exposed invertebrate organism" ;
    dcterms:description "the total amount of a substance present within an entire organism, expressed per unit of whole-body mass" ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:WholeBodyConcentration .

