@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAp7wcUrapbzBGK-Y80-wOMpzJTvRTPT8wWTT8JV-mizQ/> .

<https://w3id.org/iadopt/variable/GrowthStageAtExposure> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Growth stage at exposure",
        "growth stage at exposure of plant" ;
    dcterms:description "the developmental stage of the plant at the time when exposure to a substance begins." ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:developmentalStage .

