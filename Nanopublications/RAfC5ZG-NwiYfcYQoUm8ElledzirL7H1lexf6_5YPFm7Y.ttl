@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAfC5ZG-NwiYfcYQoUm8ElledzirL7H1lexf6_5YPFm7Y/> .

<https://w3id.org/iadopt/variable/HershbergerEndpoints> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Hershberger endpoints",
        "Hershberger endpoints in exposed animal" ;
    dcterms:description "measurements of androgen-responsive tissue weights in male rodents used to assess androgenic or anti-androgenic activity." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:HershbergerAssayEndpoints .

