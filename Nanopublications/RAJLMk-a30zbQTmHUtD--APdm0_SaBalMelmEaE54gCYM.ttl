<https://w3id.org/iadopt/variable/ReferenceEndTimePoint> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Reference end time point" ;
    dcterms:description "The description or date and/or time of a time point that acts as a fixed reference for characterizing the end of an observation" ;
