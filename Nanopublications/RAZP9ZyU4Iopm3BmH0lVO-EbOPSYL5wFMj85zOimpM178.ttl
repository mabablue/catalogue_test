@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAZP9ZyU4Iopm3BmH0lVO-EbOPSYL5wFMj85zOimpM178/> .

<https://w3id.org/iadopt/variable/MetalNo> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Number of metal atoms" ;
    dcterms:description "Number of metal atoms" ;
    iop:hasObjectOfInterest sub:Metal ;
    iop:hasProperty sub:MetalNumber .

