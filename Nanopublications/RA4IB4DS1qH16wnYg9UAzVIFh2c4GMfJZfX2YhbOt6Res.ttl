@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA4IB4DS1qH16wnYg9UAzVIFh2c4GMfJZfX2YhbOt6Res/> .

<https://w3id.org/iadopt/variable/Time-courseClearance> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Time-course clearance",
        "time-course clearance of test substance" ;
    dcterms:description "the rate and extent of removal of a substance from tissues or the body over time following exposure." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:clearancekinetics .

