@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA9bcYDArjiJ0bfCz5Cn-O9nmtmQQTrM1sNbraaVNbbVQ/> .

<https://w3id.org/iadopt/variable/SoftwareTRL> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Software TRL",
        "Software Technology Readiness Level (TRL)" ;
    dcterms:description "The assessed maturity level of the software on a defined Technology Readiness Level scale (e.g., TRL 1–9), indicating how close it is to operational use and deployment." ;
    rdfs:seeAlso <http://sweetontology.net/humanTechReadiness/TechnologyReadinessLevel> ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:TRL .

