@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAglncnFE0wHNZwYgxpu5UlUM8eyAaB4VAHojNK_b81mI/> .

<https://w3id.org/iadopt/variable/1Dshape> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "1D shape",
        "1D-shape" ;
    dcterms:description "A one dimensional shape" ;
    iop:hasObjectOfInterest sub:Shape ;
    iop:hasProperty sub:1DShape .

