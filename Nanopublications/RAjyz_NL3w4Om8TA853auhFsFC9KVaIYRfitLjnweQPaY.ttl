@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAjyz_NL3w4Om8TA853auhFsFC9KVaIYRfitLjnweQPaY/> .

<https://w3id.org/iadopt/variable/CarbideNo> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Number of carbon atoms" ;
    dcterms:description "Number of carbon atoms" ;
    iop:hasObjectOfInterest sub:Carbon ;
    iop:hasProperty sub:CarbonNo .

