@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA0S5tIyjXKvllzLy82c8ecu8RtFyKqCg0D4AdM-oVXqc/> .

<https://w3id.org/iadopt/variable/ValenceBand> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Valence band",
        "valence band of material" ;
    dcterms:description "the highest energy band in a solid that is fully occupied by electrons under equilibrium conditions." ;
    rdfs:seeAlso <https://www.sciencedirect.com/topics/chemistry/valance-band#:~:text=The%20valence%20band%20(VB)%20is,capacity%20and%20light%20absorption%20characteristics.&text=How%20useful%20is%20this%20definition?> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:ValenceBandEnergy .

