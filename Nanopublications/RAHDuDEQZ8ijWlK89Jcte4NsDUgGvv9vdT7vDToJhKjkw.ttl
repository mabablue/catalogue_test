@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAHDuDEQZ8ijWlK89Jcte4NsDUgGvv9vdT7vDToJhKjkw/> .

<https://w3id.org/iadopt/variable/SpeciationOfAccumulatedElements> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Speciation of accumulated elements",
        "speciation of accumulated elements in plant" ;
    dcterms:description "the chemical form or oxidation state of a substance present in plant tissues after uptake." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:ElementSpeciation .

