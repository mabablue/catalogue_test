@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RARtseD4Tm6ybuH8qRQmxQy435Nn2ReQeml4DuLp-K9iw/> .

<https://w3id.org/iadopt/variable/PolymorphIdentity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Polymorph identity",
        "polymorph identity of material" ;
    dcterms:description "the identification of a specific crystalline form of a substance." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:PolymorphIdentity .

