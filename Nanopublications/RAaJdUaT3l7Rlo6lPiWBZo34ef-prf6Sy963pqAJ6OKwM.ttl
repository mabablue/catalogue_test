@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAaJdUaT3l7Rlo6lPiWBZo34ef-prf6Sy963pqAJ6OKwM/> .

<https://w3id.org/iadopt/variable/MorganFingerprints> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Morgan fingerprints",
        "Morgan keys" ;
    dcterms:description "Morgan fingerprints are a type of molecular fingerprint used in cheminformatics and drug discovery to represent molecules as binary vectors (lists of 0s and 1s). These fingerprints encode information about the presence and connectivity of atoms and functional groups within a defined radius around each atom in a molecule" ;
    iop:hasObjectOfInterest sub:Chemicals ;
    iop:hasProperty sub:MorganFingerprints .

