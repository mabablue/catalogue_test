@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAqQBu4X46j7tmhUlKl15MITzBLfvKVUF0ryUr1Vaos6M/> .

<https://w3id.org/iadopt/variable/ElementalComposition> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Elemental composition",
        "elemental composition of material" ;
    dcterms:description "the qualitative and/or quantitative description of the chemical elements present in a substance or material." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:ElementalComposition .

