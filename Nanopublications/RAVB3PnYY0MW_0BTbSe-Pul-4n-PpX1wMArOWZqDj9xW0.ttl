@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAVB3PnYY0MW_0BTbSe-Pul-4n-PpX1wMArOWZqDj9xW0#> .

sub:Variable28 a iop:Variable ;
    rdfs:label "Overnight stays in 3-star hotel near the sea shore" ;
    dcterms:description "Number of nights in a 3-star hotel near the sea shore" ;
    iop:hasConstraint <https://w3id.org/italia/onto/ACCO/AccommodationStarRating> ;
    iop:hasContextObject <http://purl.obolibrary.org/obo/ENVO_03501347> ;
    iop:hasMatrix <http://vocabs.lter-europe.net/EnvThes/30372> ;
    iop:hasObjectOfInterest sub:stay ;
    iop:hasProperty <http://purl.obolibrary.org/obo/NCIT_C65019> .

<https://w3id.org/italia/onto/ACCO/AccommodationStarRating> a iop:Constraint ;
    iop:constrains <http://schema.org/Hotel> .

