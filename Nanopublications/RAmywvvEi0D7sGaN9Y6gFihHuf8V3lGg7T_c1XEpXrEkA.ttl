@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAmywvvEi0D7sGaN9Y6gFihHuf8V3lGg7T_c1XEpXrEkA/> .

<https://w3id.org/iadopt/variable/RedoxPotential> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Redox potential",
        "redox potential of substance" ;
    dcterms:description "The electron activity or oxidation-reduction potential of a solution,indicating the tendency of substances to be oxidized or reduced." ;
    rdfs:seeAlso <https://w3id.org/bervo/BERVO_8000349> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:redoxPotential .

