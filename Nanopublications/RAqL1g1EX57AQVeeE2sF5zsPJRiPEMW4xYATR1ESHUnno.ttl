@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAqL1g1EX57AQVeeE2sF5zsPJRiPEMW4xYATR1ESHUnno/> .

<https://w3id.org/iadopt/variable/LightingConditions> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Lighting conditions" ;
    dcterms:description "Experimental condition in which the intensity, wavelength, and/or duration of illumination is (are) different from the one in controlled conditions" ;
    iop:hasObjectOfInterest sub:Experiment ;
    iop:hasProperty <http://purl.obolibrary.org/obo/ZECO_0000146> .

