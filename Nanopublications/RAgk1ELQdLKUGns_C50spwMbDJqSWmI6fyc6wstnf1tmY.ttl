@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAgk1ELQdLKUGns_C50spwMbDJqSWmI6fyc6wstnf1tmY/> .

<https://w3id.org/iadopt/variable/CationExchangecapacity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Cation exchange capacity (CEC)",
        "cation exchange capacity of soil" ;
    dcterms:description "A physical quality which inheres in an environmental material by virtue of the material's ability to adsorb exchangeable cations. In soils, these materials include clay and organic matter particles. Soil CEC is measured in millequivalents per 100 grams of soil (meq/100g)." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_06105240> ;
    iop:hasObjectOfInterest sub:soil ;
    iop:hasProperty sub:CationExchangeCapacity .

