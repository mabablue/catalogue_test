@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAu94OPLNSZeSTulSqpzfEYWezM2AI76qbdD4A5d5CNIE/> .

<https://w3id.org/iadopt/variable/CO₂Concentration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "CO₂ concentration",
        "CO₂ concentration of growth environment" ;
    dcterms:description "the amount of carbon dioxide present in the air of an experimental or environmental system." ;
    iop:hasObjectOfInterest sub:GrowthEnvironment ;
    iop:hasProperty <https://w3id.org/np/RAu94OPLNSZeSTulSqpzfEYWezM2AI76qbdD4A5d5CNIE/CO₂concentration> .

