@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAWIW2VmjLjZL_r-E1z1SgN-JoHa8uSOQjsVqnV9h4wS0/> .

<https://w3id.org/iadopt/variable/CarbonFixation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Carbon fixation",
        "Carbon fixation pathway" ;
    dcterms:description "Carbon fixation is a process found in autotrophs, usually driven by photosynthesis, whereby carbon dioxide (CO(2)) is converted into organic compounds. There are three types of carbon fixation pathways: i) C3 acid cycle; ii) C4 acid cycle; iii) CAM pathway" ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/UPa_UPA00515> ;
    iop:hasObjectOfInterest sub:Carbon ;
    iop:hasProperty <http://purl.obolibrary.org/obo/UPa_UPA00515> .

