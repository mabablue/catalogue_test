@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RACveLTSxRwCl4YGPrUzbmaetiYknmkFh9-JHGt5JQ3YI/> .

<https://w3id.org/iadopt/variable/EyeIrritationScore> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Eye irritation score",
        "eye irritation score in exposed animal" ;
    dcterms:description "a graded assessment of ocular damage, including redness, swelling, and corneal opacity, following exposure to a substance." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:eyeIrritationSeverity .

