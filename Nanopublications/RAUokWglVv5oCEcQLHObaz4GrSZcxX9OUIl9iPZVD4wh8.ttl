@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAUokWglVv5oCEcQLHObaz4GrSZcxX9OUIl9iPZVD4wh8/> .

<https://w3id.org/iadopt/variable/AtomicMass> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Atomic mass" ;
    dcterms:description "The sum of the relative atomic masses of the constituent atoms of a molecule" ;
    iop:hasObjectOfInterest sub:NP ;
    iop:hasProperty <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C28272> .

