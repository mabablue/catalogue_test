@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA9aqVNeq9O94ef9Bic5sfpj2JHXeFa334o82IKwhWCSY#> .

sub:TOC a iop:Variable ;
    rdfs:label "Percentage of total organic carbon in sediment" ;
    dcterms:description "Percentage of total organic carbon in sediment" ;
    iop:hasMatrix sub:sediment ;
    iop:hasObjectOfInterest sub:total_organic_carbon ;
    iop:hasProperty sub:Percentage .

