@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAp2decN3uagOZKrUTF1PrI-CU4RsVt5c8ANtSchHZ1Rw/> .

<https://w3id.org/iadopt/variable/SteroidogenesisAlteration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Steroidogenesis alteration",
        "alteration of steroidogenesis in cells" ;
    dcterms:description "a change in the synthesis or production of steroid hormones caused by exposure to a substance." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:steroidogenesisAlteration .

