<https://w3id.org/iadopt/variable/SteroidHormones> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Steroid hormones",
        "steroid hormones in blood of exposed animal" ;
    dcterms:description "Active steroid hormones are produced from the precursor cholesterol." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/HINO_0026059> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:steroidHormoneLevel .

