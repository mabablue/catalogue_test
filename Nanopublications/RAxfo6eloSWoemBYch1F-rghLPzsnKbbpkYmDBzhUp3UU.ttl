@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAxfo6eloSWoemBYch1F-rghLPzsnKbbpkYmDBzhUp3UU/> .

<https://w3id.org/iadopt/variable/RespirationRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Respiration rate",
        "respiration rate in exposed invertebrate organism" ;
    dcterms:description "oxygen consumption reflecting metabolic activity." ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:RespirationRate .

