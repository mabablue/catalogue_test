<https://w3id.org/iadopt/variable/Urea/BUN> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Urea/BUN",
        "urea/BUN concentration in blood" ;
    dcterms:description "the concentration of urea or blood urea nitrogen in blood, used as an indicator of kidney function and protein metabolism." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty <https://w3id.org/np/RADe7ZszLaMwaE62TywwivlKfGE6LhApMX4capvaodfyQ/urea/bloodUreaNitrogen> .

