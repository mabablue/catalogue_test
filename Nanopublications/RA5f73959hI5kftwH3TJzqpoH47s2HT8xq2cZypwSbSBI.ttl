@prefix sub: <https://w3id.org/np/RA5f73959hI5kftwH3TJzqpoH47s2HT8xq2cZypwSbSBI#> .

sub:Variable8 a iop:Variable ;
    rdfs:label "Coarse woody debris abundance",
        "Coarse woody debris abundance per hectare" ;
    dcterms:description "CWD abundance per hectare (m2/hectare) is the abundance of CWD measured from all the plots/transects scaled to a hectare (100 x 100 m). They are calculated using the formula (see https://www.sciencedirect.com/science/article/pii/S037811270900783X)" ;
    iop:hasObjectOfInterest <https://lod.nal.usda.gov/nalt/en/page/104904> ;
    iop:hasProperty <http://vocab.nerc.ac.uk/collection/S06/current/S0600002/> .

