@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RACZU49x7DppxyGLtMrz8Oqu1dTaC0I8HBLp9jl_vTLLg/> .

<https://w3id.org/iadopt/variable/EnthalpyOfVaporization> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Enthalpy of vaporization",
        "enthalpy of vaporization of substance" ;
    dcterms:description "A descriptor of the energy taken in by a chemical substance on vaporization at a given temperature and pressure." ;
    rdfs:seeAlso <http://semanticscience.org/resource/CHEMINF_000418> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:EnthalpyOfVaporization .

