@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAz11nFuceC43TXP1KcKvfzYjPTK8-KasN3F85dIV3034/> .

<https://w3id.org/iadopt/variable/AtomicRadius> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Atomic radius" ;
    dcterms:description "Atomic radius is the 1D extent of the electron cloud surrounding the atom" ;
    iop:hasObjectOfInterest sub:Atom ;
    iop:hasProperty <http://semanticscience.org/resource/CHEMINF_000125> .

