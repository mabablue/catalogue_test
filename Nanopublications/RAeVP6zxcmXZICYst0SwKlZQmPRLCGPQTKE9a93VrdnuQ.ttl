@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAeVP6zxcmXZICYst0SwKlZQmPRLCGPQTKE9a93VrdnuQ/> .

<https://w3id.org/iadopt/variable/Carotenoids> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Carotenoids",
        "carotenoid content of plant tissue" ;
    dcterms:description "a group of fat-soluble pigments found in green, yellow, and leafy vegetables, and yellow fruits. They are aliphatic hydrocarbons containing 4 terpene subunits." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D002338> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:CarotenoidContent .

