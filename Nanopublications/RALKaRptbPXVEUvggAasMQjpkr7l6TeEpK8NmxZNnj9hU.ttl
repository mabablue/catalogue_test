<https://w3id.org/iadopt/variable/D11> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average coordination parameter of the shell atoms" ;
    dcterms:description "D11: The average coordination parameter of the nanoparticle shell atoms" ;
    iop:hasObjectOfInterest sub:NPShellAtomCoordination ;
    iop:hasProperty sub:D11 .

