@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAn6SQqn1BBk9G1nJl_FhWHHNs_OIDCQQUdLt6Hh_cEZo/> .

<https://w3id.org/iadopt/variable/AtomicWeightActiveMetals> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Atomic weight of active metals" ;
    dcterms:description "The relative atomic mass (of elements from natural, stable, terrestrial sources) that are attributable to electropositive chemical elements characterised by ductility, malleability, luster, and conductance of heat and electricity. that are exerting influence or producing an effect" ;
    iop:hasObjectOfInterest sub:Metal ;
    iop:hasProperty sub:AtomicWeight .

