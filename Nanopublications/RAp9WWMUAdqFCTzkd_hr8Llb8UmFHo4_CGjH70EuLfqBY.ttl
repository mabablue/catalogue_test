@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAp9WWMUAdqFCTzkd_hr8Llb8UmFHo4_CGjH70EuLfqBY/> .

<https://w3id.org/iadopt/variable/AmorphousFraction> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Amorphous fraction",
        "amorphous fraction of material" ;
    dcterms:description "the proportion of a material that is present in a non-crystalline (amorphous) form." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:AmorphousFraction .

