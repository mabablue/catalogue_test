@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA9PWgYdGZOvABKiXq3QBG2ueGH94FQXlV-4MceMQOT7Y/> .

<https://w3id.org/iadopt/variable/PlantMassNormalizedDose> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Plant mass-normalized dose",
        "plant mass-normalized dose of test substance" ;
    dcterms:description "the amount of a substance applied or absorbed per unit mass of plant tissue." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:mass-normalizedDose .

