@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAS4kEgtZmoNeZ6Suf7Bl6SBu8o9LBycwFRtYYUFCEHVE/> .

<https://w3id.org/iadopt/variable/D24> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average coordination parameter (5Ang) of all atoms" ;
    dcterms:description "D24: The average coordination parameter (5Ang) of all nanoparticle atoms" ;
    iop:hasObjectOfInterest sub:NPAtomAverageCoordination ;
    iop:hasProperty sub:Coordination5Ang .

