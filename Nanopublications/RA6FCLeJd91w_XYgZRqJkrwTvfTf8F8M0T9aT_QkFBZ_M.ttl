@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA6FCLeJd91w_XYgZRqJkrwTvfTf8F8M0T9aT_QkFBZ_M/> .

<https://w3id.org/iadopt/variable/Transmittance> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Transmittance",
        "transmittance of material" ;
    dcterms:description "the fraction of incident electromagnetic radiation that passes through a material." ;
    rdfs:seeAlso <http://www.bioassayontology.org/bao#BAO_0000071> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:transmittance .

