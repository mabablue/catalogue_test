@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/iadopt/variable/AcuteDermalToxicity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Acute dermal toxicity" ;
    dcterms:description "A toxicity disposition that inheres in a substance that is capable of causing harm to or killing organisms quickly when exposed to the skin" ;
    iop:hasObjectOfInterest <http://purl.obolibrary.org/obo/OAE_0009088> ;
    iop:hasProperty <http://purl.enanomapper.org/onto/ENM_0000026> .

