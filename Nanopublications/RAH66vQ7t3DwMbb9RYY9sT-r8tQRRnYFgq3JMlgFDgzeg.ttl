@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAH66vQ7t3DwMbb9RYY9sT-r8tQRRnYFgq3JMlgFDgzeg/> .

<https://w3id.org/iadopt/variable/Age> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Age" ;
    dcterms:description "A temporal measurement of the time period elapsed since an identifiable point in the life cycle of an organism. If a developmental stage is specified, the identifiable point would be the beginning of that stage. Otherwise the identifiable point must be specified such as planting (e.g. 3 days post planting)." ;
    rdfs:seeAlso <http://www.ebi.ac.uk/efo/EFO_0000246> ;
    iop:hasObjectOfInterest sub:Age ;
    iop:hasProperty <http://www.ebi.ac.uk/efo/EFO_0000246> .

