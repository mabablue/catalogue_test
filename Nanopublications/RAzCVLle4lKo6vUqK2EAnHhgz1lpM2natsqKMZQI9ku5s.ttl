@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAzCVLle4lKo6vUqK2EAnHhgz1lpM2natsqKMZQI9ku5s/> .

<https://w3id.org/iadopt/variable/SoftwareIntendedUse> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Software Intended Use",
        "The intended use of a software" ;
    dcterms:description "The purpose or application the software is designed for, as stated by its developers or documentation (e.g., data analysis, image segmentation, molecular dynamics simulation, workflow management)." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:IntendedUse .

