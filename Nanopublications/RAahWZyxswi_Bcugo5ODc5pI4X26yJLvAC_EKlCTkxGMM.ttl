@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAahWZyxswi_Bcugo5ODc5pI4X26yJLvAC_EKlCTkxGMM/> .

<https://w3id.org/iadopt/variable/SublimationPoint> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Sublimation point",
        "sublimation point of substance" ;
    dcterms:description "The direct transition of a solid to a vapour without passing through a liquid phase." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/REX_0000180> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:SublimationPoint .

