@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAEqp1hLrmhlZEC0Tdybf8J6ATS8yccqXsXTogPoJUWQ4/> .

<https://w3id.org/iadopt/variable/ALP> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "ALP",
        "ALP activity in blood" ;
    dcterms:description "An enzyme that catalyzes the conversion of an orthophosphoric monoester and water to an alcohol and orthophosphate. EC 3.1.3.1." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D000469> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:alkalinePhosphatase .

