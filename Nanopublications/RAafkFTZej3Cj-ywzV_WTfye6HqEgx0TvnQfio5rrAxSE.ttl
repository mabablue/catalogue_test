@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAafkFTZej3Cj-ywzV_WTfye6HqEgx0TvnQfio5rrAxSE/> .

<https://w3id.org/iadopt/variable/WorkFunction> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Work function",
        "work function of material" ;
    dcterms:description "the amount of energy required to remove an electron from the surface of a material to a point just outside its surface" ;
    rdfs:seeAlso <https://www.sciencedirect.com/topics/materials-science/electronic-work-function#:~:text=Electronic%20work%20function%20is%20defined,affecting%20the%20work%20function%20values.> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:WorkFunction .

