@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAL7aPiMROOrDqUJEatJOHnGTdqr8BzXOEFTPt_KNqm1E/> .

<https://w3id.org/iadopt/variable/AbnormalSeedlings> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Abnormal seedlings",
        "abnormal seedlings of plant" ;
    dcterms:description "seedlings that germinate but show morphological or developmental defects that prevent normal growth." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:SeedlingAbnormality .

