@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAXuC_xENw5IfQSzDgJK0IApWI6XAnsLvFz91jWwdssQA/> .

<https://w3id.org/iadopt/variable/CatalaseActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Catalase (CAT) activity",
        "catalase activity in exposed invertebrate organism" ;
    dcterms:description "the breakdown of hydrogen peroxide to prevent oxidative damage." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0004096> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:CatalaseCatActivity .

