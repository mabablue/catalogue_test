@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAW5PN8fkG1e7bD5uLkywdjsRG9j_hQUS_5dAZaRzS3cw/> .

<https://w3id.org/iadopt/variable/AuthenticationScheme> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Authentication Scheme" ;
    dcterms:description "The method(s) the software supports or requires to authenticate users or systems (e.g., none, basic auth, API keys, OAuth2/OIDC, SAML, LDAP, SSH keys, token-based authentication)." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:AuthenticationScheme .

