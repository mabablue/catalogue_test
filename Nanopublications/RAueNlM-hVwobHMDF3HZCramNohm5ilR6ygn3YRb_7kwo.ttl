@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAueNlM-hVwobHMDF3HZCramNohm5ilR6ygn3YRb_7kwo/> .

<https://w3id.org/iadopt/variable/ActiveMetalloidElectrons> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Quantity of Active Metalloid electrons" ;
    dcterms:description "How many fundamental particle with a negative charge there are from elements with properties between a metal and a non-metal" ;
    iop:hasObjectOfInterest sub:Metalloid ;
    iop:hasProperty sub:ActiveMetalloidElectrons .

