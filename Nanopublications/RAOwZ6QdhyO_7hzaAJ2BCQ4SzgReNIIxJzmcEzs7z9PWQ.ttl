@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAOwZ6QdhyO_7hzaAJ2BCQ4SzgReNIIxJzmcEzs7z9PWQ/> .

<https://w3id.org/iadopt/variable/Normalisation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Normalisation" ;
    dcterms:description "Normalisation is a data transformation process which aims at making data seem roughly normally distributied by applying a mathematical function, which is most of time a continuous function. This is a row operation that is applied to the data from each sample and comprises methods to make the data from all samples directly comparable with each other. A common use is to remove or minimise the effects of variable dilution of the samples" ;
    iop:hasObjectOfInterest sub:Data ;
    iop:hasProperty <http://nmrML.org/nmrCV#NMR:1400064> .

