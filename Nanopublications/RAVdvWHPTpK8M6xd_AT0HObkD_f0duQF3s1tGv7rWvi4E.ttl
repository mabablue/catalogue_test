@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAVdvWHPTpK8M6xd_AT0HObkD_f0duQF3s1tGv7rWvi4E/> .

<https://w3id.org/iadopt/variable/LogKow> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Log Kow",
        "Log Kow of substance" ;
    dcterms:description "the base-10 logarithm of the equilibrium partition coefficient of a substance between n-octanol and water, a relative indicator of the tendency of an organic compound to adsorb to soil and living organism." ;
    rdfs:seeAlso <https://www.chemsafetypro.com/Topics/CRA/n_Octanol_Water_Partition_Coefficient_Kow.html> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:LogKow .

