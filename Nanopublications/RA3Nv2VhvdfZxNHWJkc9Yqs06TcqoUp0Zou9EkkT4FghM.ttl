@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA3Nv2VhvdfZxNHWJkc9Yqs06TcqoUp0Zou9EkkT4FghM/> .

<https://w3id.org/iadopt/variable/DielectricConstant> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Dielectric constant",
        "dielectric constant of material" ;
    dcterms:description "A measure of the electric polarizability of a dielectric material." ;
    rdfs:seeAlso <http://materialsmine.org/ns/DC_DielectricConstant> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:DielectricConstant .

