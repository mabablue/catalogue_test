@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAgFyeXVKsEUOPpktExpDrO3vilh2keteuafXASRG9OhA/> .

<https://w3id.org/iadopt/variable/Photoperiod> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Photoperiod",
        "photoperiod of growth environment" ;
    dcterms:description "The time period of daily exposure that an organism receives from daylight or artificial light." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D017440> ;
    iop:hasObjectOfInterest sub:GrowthEnvironment ;
    iop:hasProperty sub:photoperiod .

