@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RANUQ7NgbP543iDkIenqGgeRZyzjQqlFynEYeRmjSQYqo/> .

<https://w3id.org/iadopt/variable/LeafWaterPotential> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Leaf water potential (Ψleaf)",
        "leaf water potential of plant" ;
    dcterms:description "the water status of a leaf expressed as potential energy." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/TO_0000131> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:LeafWaterPotential .

