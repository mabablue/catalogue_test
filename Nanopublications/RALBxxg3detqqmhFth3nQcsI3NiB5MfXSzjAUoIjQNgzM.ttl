<https://w3id.org/iadopt/variable/GranulomaFormation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Granuloma formation",
        "granuloma formation in exposed organism" ;
    dcterms:description "the development of localized aggregates of immune and inflammatory cells around persistent particles or foreign materials in tissues." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0002432> ;
    iop:hasObjectOfInterest <https://w3id.org/np/RALBxxg3detqqmhFth3nQcsI3NiB5MfXSzjAUoIjQNgzM/organ/tissue> ;
    iop:hasProperty sub:granulomaformation .

