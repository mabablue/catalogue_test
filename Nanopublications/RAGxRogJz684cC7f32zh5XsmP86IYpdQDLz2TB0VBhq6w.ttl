<https://w3id.org/iadopt/variable/ThermalStabilityClass> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Thermal stability class",
        "thermal stability class of substance" ;
    dcterms:description "a categorical classification of a substance or material based on its resistance to thermal degradation." ;
    rdfs:seeAlso <https://www.sciencedirect.com/topics/materials-science/thermal-stability#:~:text=4.2%20Thermal%20stability-,Thermal%20stability%20is%20defined%20as%20the%20ability%20of%20a%20material,and%20properties%20of%20the%20material.> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:ThermalStabilityClass .

