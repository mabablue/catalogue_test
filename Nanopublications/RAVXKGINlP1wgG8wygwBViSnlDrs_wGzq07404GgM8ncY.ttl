@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/iadopt/variable/Skin> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Skin" ;
    dcterms:description "An organ that constitutes the external surface of the body. It consists of the epidermis, dermis, and skin appendages" ;
    iop:hasObjectOfInterest <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12470> ;
    iop:hasProperty <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12470> .

