@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RABd8stXOFnFw8uEaIbNhun7hf9K8Px1RKRXF3_Rp5ylw/> .

<https://w3id.org/iadopt/variable/EnthalpyOfFusion> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Enthalpy of fusion",
        "enthalpy of fusion of substance" ;
    dcterms:description "is a quantification of the amount of energy (enthalpy) that must be added to a solid substance, to transform a quantity of that substance into a liquid." ;
    rdfs:seeAlso <http://purl.allotrope.org/ontologies/result#AFR_0002163> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:EnthalpyOfFusion .

