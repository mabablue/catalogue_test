@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA6KmQ4jnq1cRZhOs6dC8sEq_s9UExp5yn2UbtSsIB0hA/> .

<https://w3id.org/iadopt/variable/SaturationMagnetisation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Saturation magnetisation",
        "saturation magnetisation of material" ;
    dcterms:description "the maximum magnetisation achieved by a material under an applied magnetic field." ;
    rdfs:seeAlso <https://www.sciencedirect.com/topics/physics-and-astronomy/saturation-magnetization> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:SaturationMagnetisation .

