@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA_BuYvH45KtcOSEnZtgBRys_KZQ3I0PhgE1KyX-7hmpw/> .

<https://w3id.org/iadopt/variable/EliminationRateConstant> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Elimination rate constant",
        "elimination rate constant in exposed invertebrate organism" ;
    dcterms:description "how quickly a substance is removed from an organism." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1526> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:EliminationRateConstant .

