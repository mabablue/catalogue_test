@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA5qdGjJKXZSlYnF3G1994ANZFntqX0-IP2GcJZT-WmZ4/> .

<https://w3id.org/iadopt/variable/PhotoluminescenceSpectrum> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Photoluminescence spectrum",
        "photoluminescence spectrum of material" ;
    dcterms:description "A plot of intensity vs. wavelength obtained by measuring the intensity of radiation emitted by a sample through photoluminescence, against the frequency/wavelength of the incident radiation." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/CHMO_0000865> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:photoluminescence .

