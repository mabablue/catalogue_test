@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAwu6F2JYfAcB61VmWZ7L5fMapD3TyR-qOR6Esf1a9JvY/> .

<https://w3id.org/iadopt/variable/Anxiety-likeBehavior> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Anxiety-like behavior",
        "anxiety-like behavior in exposed animal" ;
    dcterms:description "the behavioral response of organisms indicating increased anxiety, typically assessed using standardized behavioral tests." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:anxiety-likeBehavior .

