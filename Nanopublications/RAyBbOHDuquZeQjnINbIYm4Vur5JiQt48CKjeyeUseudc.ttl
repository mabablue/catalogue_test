@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAyBbOHDuquZeQjnINbIYm4Vur5JiQt48CKjeyeUseudc/> .

<https://w3id.org/iadopt/variable/OxidisingProperties> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Oxidising properties",
        "oxidising properties of substance" ;
    dcterms:description "the physicochemical characteristics of a substance or mixture that determine its ability to oxidise other materials and thereby initiate or enhance combustion." ;
    rdfs:seeAlso <https://www.chemsafetypro.com/Topics/CRA/Oxidising_Properties.html> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:OxidisingProperties .

