@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAXcpyGgwsoNf-CIjPXzdDGensCgtoW7MDwpZQX9OW9vM/> .

<https://w3id.org/iadopt/variable/ERstressMarkers> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "ER stress marker level in cells",
        "ER stress markers" ;
    dcterms:description "indicators of endoplasmic reticulum stress response." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:ERstressmarkerlevel .

