@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATLZG5G8wT4MerfCnXEP9Yt89DTng6yRlcdwv6IeYoAE/> .

<https://w3id.org/iadopt/variable/SurfaceCapping> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Surface capping" ;
    iop:hasObjectOfInterest sub:NPSurface ;
    iop:hasProperty sub:Capping .

