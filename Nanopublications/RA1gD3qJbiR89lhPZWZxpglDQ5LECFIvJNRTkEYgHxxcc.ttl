@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA1gD3qJbiR89lhPZWZxpglDQ5LECFIvJNRTkEYgHxxcc/> .

<https://w3id.org/iadopt/variable/MSspectrum> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "MS spectrum",
        "MS spectrum of substance" ;
    dcterms:description "A plot of the relative abundance of a beam or other collection of ions as a function of the mass-to-charge ratio (m/z)." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/MS_1000294> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:MassFragmentationPattern .

