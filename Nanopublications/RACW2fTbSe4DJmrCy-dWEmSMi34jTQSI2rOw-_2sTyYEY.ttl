<https://w3id.org/iadopt/variable/PhaseIIEnzymeModulation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Phase II enzyme modulation",
        "Phase II enzyme modulation in cells" ;
    dcterms:description "the alteration of the expression or activity of conjugation enzymes involved in detoxification of xenobiotics." ;
