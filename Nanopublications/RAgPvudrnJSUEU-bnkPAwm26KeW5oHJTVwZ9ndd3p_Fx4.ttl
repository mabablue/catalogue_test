<https://w3id.org/iadopt/variable/LysosomalMembraneStability> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Lysosomal membrane stability",
        "lysosomal membrane stability in exposed invertebrate organism" ;
    dcterms:description "reflects cellular integrity and immune cell health." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0005765> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:LysosomalMembraneStability .

