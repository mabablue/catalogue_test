sub:assertion {
  <https://w3id.org/iadopt/variable/Dispersibility> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "the ability of a substance, typically solid particles, to be distributed uniformly throughout a liquid or gas medium, often involving the de-agglomeration of particles.";
    rdfs:label "Dispersibility", "dispersibility of material";
    rdfs:seeAlso <https://www.sciencedirect.com/topics/engineering/dispersibility#:~:text=Dispersibility%2C%20generally%20defined%20as%20a,index%2C%20a%20measure%20of%20dispersibility.>;
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:Materials;
    <https://w3id.org/iadopt/ont/hasProperty> sub:dispersibility .
}

