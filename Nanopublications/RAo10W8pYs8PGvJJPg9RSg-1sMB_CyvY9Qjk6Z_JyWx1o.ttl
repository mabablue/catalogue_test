@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAo10W8pYs8PGvJJPg9RSg-1sMB_CyvY9Qjk6Z_JyWx1o/> .

<https://w3id.org/iadopt/variable/WBCcount> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "WBC count",
        "WBC count in blood" ;
    dcterms:description "The number of white blood cells in a specified volume of blood." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/CMO_0000027> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:whitebloodcellcount .

