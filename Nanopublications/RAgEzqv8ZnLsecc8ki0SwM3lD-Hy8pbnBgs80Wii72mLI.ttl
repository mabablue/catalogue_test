sub:Variable13 a iop:Variable ;
    rdfs:label "Distance to nearest neighbour EUNIS habitat patch" ;
    dcterms:description "The distance to the nearest neighbour is a metric used to measure the degree of connection of EUNIS habitats within a landscape, in terms of their spatial distribution." ;
    rdfs:seeAlso <https://github.com/EuropaBON/EBV-Descriptions/wiki/Terrestrial-Connectivity-of-terrestrial-ecosystem-habitat-types> ;
