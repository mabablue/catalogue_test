@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAjnElqzOnM2q61TGx7k_mrCIFIm4Duuw-3upn_CUFdBo/> .

<https://w3id.org/iadopt/variable/RNSgeneration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "RNS generation",
        "RNS generation in cells" ;
    dcterms:description "the production of reactive nitrogen species within cells following exposure to a substance." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:RNSlevel .

