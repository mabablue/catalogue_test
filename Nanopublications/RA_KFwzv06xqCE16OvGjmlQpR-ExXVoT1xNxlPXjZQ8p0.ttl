@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA_KFwzv06xqCE16OvGjmlQpR-ExXVoT1xNxlPXjZQ8p0/> .

<https://w3id.org/iadopt/variable/SourceCodeHostingPlatform> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Source Code Hosting Platform",
        "Source Code Repository" ;
    dcterms:description "The repository hosting service on which the source code of a software is published or maintained (e.g., GitHub, GitLab, Bitbucket)." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:SourceCodeHostingPlatform .

