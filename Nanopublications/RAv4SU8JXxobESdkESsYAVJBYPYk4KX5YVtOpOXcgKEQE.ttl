@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAv4SU8JXxobESdkESsYAVJBYPYk4KX5YVtOpOXcgKEQE/> .

<https://w3id.org/iadopt/variable/ZnONP> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Zinc oxide nanoparticle",
        "ZnO-NP" ;
    dcterms:description "An inorganic nanoparticle consisting of ZnO." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1542> ;
    iop:hasObjectOfInterest sub:ZnO ;
    iop:hasProperty <http://purl.bioontology.org/ontology/npo#NPO_1542> .

