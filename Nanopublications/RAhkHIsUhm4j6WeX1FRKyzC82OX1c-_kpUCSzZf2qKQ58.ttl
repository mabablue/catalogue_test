@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAhkHIsUhm4j6WeX1FRKyzC82OX1c-_kpUCSzZf2qKQ58/> .

<https://w3id.org/iadopt/variable/RBCcount> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "RBC count",
        "RBC count in blood" ;
    dcterms:description "The number of red blood cells in a specified volume of blood most commonly 1 cubic millimeter (i.e. 1 microliter) of peripheral venous blood." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/CMO_0000025> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:redbloodcellcount .

