@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAEkS8yZpqajorWpE-tjO6O6jCEhhZqMVwisnueb5Rogg/> .

<https://w3id.org/iadopt/variable/Length> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Length",
        "length of material" ;
    dcterms:description "The linear extent in space from one end of something to the other end." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25334> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:length .

