@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix iopp: <https://w3id.org/iadopt/pattern/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAnyBSXQpv2z950M2WMfgjHLLvGveD-gyU7xkfT5vXHOQ#> .

<https://w3id.org/iadopt/variable/CH2_1> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Electron density in the solar wind" ;
    dcterms:description "Density (particle per cm3) of electrons measured in the Solar Wind." ;
    iop:hasConstraint sub:volume ;
    iop:hasMatrix sub:solarWind ;
    iop:hasObjectOfInterest sub:electron ;
    iop:hasProperty sub:number ;
    iopp:usesConstraint sub:quantitiyType ;
    iopp:usesMatrix sub:medium ;
    iopp:usesObjectOfInterest sub:countableEntity ;
    iopp:usesProperty sub:number .

sub:quantitiyType a iopp:Constraint ;
    iopp:perUnit sub:volume .

sub:volume a iop:Constraint ;
    iop:constrains sub:number .

