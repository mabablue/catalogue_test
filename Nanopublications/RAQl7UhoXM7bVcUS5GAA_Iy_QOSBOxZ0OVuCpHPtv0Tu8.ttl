@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAQl7UhoXM7bVcUS5GAA_Iy_QOSBOxZ0OVuCpHPtv0Tu8/> .

<https://w3id.org/iadopt/variable/Porosity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Porosity",
        "porosity of material" ;
    dcterms:description "A measure of the void spaces in a material." ;
    rdfs:seeAlso <http://materialsmine.org/ns/Porosity> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:porosity .

