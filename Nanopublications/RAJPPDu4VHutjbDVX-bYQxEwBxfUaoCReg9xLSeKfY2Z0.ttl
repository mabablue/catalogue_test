@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAJPPDu4VHutjbDVX-bYQxEwBxfUaoCReg9xLSeKfY2Z0/> .

<https://w3id.org/iadopt/variable/QuantityActiveMetalNeutrons> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Quantity of active metal neutrons" ;
    dcterms:description "How many elementary particles with 0 charge and a mass about equal to that of a proton there are, that are electropositive chemical elements characterised by ductility, malleability, luster, and conductance of heat and electricity  and  that are exerting influence or producing an effect" ;
    iop:hasObjectOfInterest sub:Metal ;
    iop:hasProperty sub:Neutrons .

