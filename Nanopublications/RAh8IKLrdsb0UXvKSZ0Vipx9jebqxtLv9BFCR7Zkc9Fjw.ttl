@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAh8IKLrdsb0UXvKSZ0Vipx9jebqxtLv9BFCR7Zkc9Fjw/> .

<https://w3id.org/iadopt/variable/PostnatalMilestones> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Postnatal milestones",
        "postnatal milestones in offspring" ;
    dcterms:description "The time period after birth." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C81317> ;
    iop:hasObjectOfInterest sub:offspring ;
    iop:hasProperty sub:postnatalDevelopmentalMilestoneAchievement .

