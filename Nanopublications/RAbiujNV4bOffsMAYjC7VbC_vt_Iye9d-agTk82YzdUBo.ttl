@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbiujNV4bOffsMAYjC7VbC_vt_Iye9d-agTk82YzdUBo/> .

<https://w3id.org/iadopt/variable/SubcellularLocalisation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Subcellular localisation",
        "subcellular localisation of test substance" ;
    dcterms:description "the distribution of a substance within specific compartments or organelles inside a cell." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:subcellularLocalisation .

