@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAwZn1uqO_2LzTx6vtcvwV25lyRrpRad0xseRGx2n_Hxc/> .

<https://w3id.org/iadopt/variable/NutrientUseEfficiency> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Nutrient use efficiency",
        "nutrient use efficiency of plant" ;
    dcterms:description "the efficiency with which a plant converts absorbed nutrients into biomass." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/201206009633005558> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:NutrientUseEfficiency .

