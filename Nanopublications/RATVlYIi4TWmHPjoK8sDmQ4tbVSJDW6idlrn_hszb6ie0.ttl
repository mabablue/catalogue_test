@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATVlYIi4TWmHPjoK8sDmQ4tbVSJDW6idlrn_hszb6ie0/> .

<https://w3id.org/iadopt/variable/SolutionConcentration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Solution concentration",
        "solution concentration of test substance" ;
    dcterms:description "the mass or molar amount of a substance per volume of solution." ;
    iop:hasObjectOfInterest sub:solution ;
    iop:hasProperty sub:concentration .

