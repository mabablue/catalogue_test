@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RABq3sYReAr4gu20JjGN70CrpndTaQDr_4xGwR70txZYg/> .

<https://w3id.org/iadopt/variable/CrystalliteSizeExperimental> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Crystallite size (experimental, e.g., using XRD data)" ;
    iop:hasObjectOfInterest sub:Crystallite ;
    iop:hasProperty sub:Size .

