@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAAzbMXkAKlTyEhRg7qqlt13MjLXMLxJaugQiZpHvKua4/> .

<https://w3id.org/iadopt/variable/RootTissue> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Root tissue",
        "root tissue of plant" ;
    dcterms:description "the plant material that comprises the underground root system, used for sampling to assess substance uptake or accumulation." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/BTO_0001188> ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:TissueType .

