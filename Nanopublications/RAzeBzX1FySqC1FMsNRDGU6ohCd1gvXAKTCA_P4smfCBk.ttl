@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAzeBzX1FySqC1FMsNRDGU6ohCd1gvXAKTCA_P4smfCBk/> .

<https://w3id.org/iadopt/variable/ExternalServicesCalled> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "External Services Called" ;
    dcterms:description "The external (third-party or separately hosted) services that the software invokes during operation (e.g., authentication providers, payment services, mapping APIs, cloud storage, telemetry/monitoring endpoints), typically including service names and/or endpoints." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:ExternalServicesCalled .

