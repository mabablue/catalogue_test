@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAqkrK2IO_eeThLW3xPlDjEOeidBLGT2XL28ZeEDydcyg/> .

<https://w3id.org/iadopt/variable/SizeSEM> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Nanomaterial size measured with SEM" ;
    iop:hasObjectOfInterest sub:Nanomaterial ;
    iop:hasProperty sub:Size .

