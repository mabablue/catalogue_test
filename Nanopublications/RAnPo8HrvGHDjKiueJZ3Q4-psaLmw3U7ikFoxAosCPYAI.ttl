@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAnPo8HrvGHDjKiueJZ3Q4-psaLmw3U7ikFoxAosCPYAI/> .

<https://w3id.org/iadopt/variable/Diameter> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Diameter",
        "diameter of material" ;
    dcterms:description "The length of a straight line passing through the center of a circle or sphere and connecting two points on the circumference." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C25285> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:diameter .

