@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAh1l58kdodTbWr7YlDsrCEStyMMBe1zoJvWFtlQn5dzc/> .

<https://w3id.org/iadopt/variable/LightIntensity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Light intensity",
        "light intensity of growth environment" ;
    dcterms:description "the quantity of light reaching a surface per unit area." ;
    rdfs:seeAlso <http://purl.dataone.org/odo/ECSO_00002236> ;
    iop:hasObjectOfInterest sub:GrowthEnvironment ;
    iop:hasProperty sub:LightIntensity .

