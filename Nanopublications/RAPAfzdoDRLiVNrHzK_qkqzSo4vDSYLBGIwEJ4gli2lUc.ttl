@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAPAfzdoDRLiVNrHzK_qkqzSo4vDSYLBGIwEJ4gli2lUc/> .

<https://w3id.org/iadopt/variable/miRNAexpression> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "miRNA expression",
        "miRNA expression profile in cells" ;
    dcterms:description "the level of microRNA molecules present in a cell or tissue, reflecting post-transcriptional regulation of gene expression." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:miRNAexpression .

