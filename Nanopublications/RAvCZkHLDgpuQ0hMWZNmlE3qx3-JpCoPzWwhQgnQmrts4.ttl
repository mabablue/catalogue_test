@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAvCZkHLDgpuQ0hMWZNmlE3qx3-JpCoPzWwhQgnQmrts4/> .

<https://w3id.org/iadopt/variable/ProteomicChanges> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Proteomic changes",
        "proteomic changes in cells" ;
    dcterms:description "alterations in the abundance, modification, or composition of proteins in a biological system following exposure to a substance." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:ProteomicChanges .

