sub:assertion {
  <https://w3id.org/iadopt/variable/MorganFingerprints> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "Morgan fingerprints are a type of molecular fingerprint used in cheminformatics and drug discovery to represent molecules as binary vectors (lists of 0s and 1s). These fingerprints encode information about the presence and connectivity of atoms and functional groups within a defined radius around each atom in a molecule";
    rdfs:label "Morgan fingerprints", "Morgan keys";
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:Chemicals;
    <https://w3id.org/iadopt/ont/hasProperty> sub:MorganFingerprints .
}

