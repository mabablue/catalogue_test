@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAnvyyWgusf2y5cNJnl8GaiOMyGqo_y8z0wmMXjFHtqZk/> .

<https://w3id.org/iadopt/variable/TotalBiomass> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Total biomass",
        "total biomass of plant" ;
    dcterms:description "the total mass of a plant, including above- and belowground tissues." ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:biomass .

