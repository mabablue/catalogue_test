@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATd65KS1P4kns2lp6flN3HefpsAEZpvIE0Q1BPzJYH5w/> .

<https://w3id.org/iadopt/variable/Stereochemistry> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Stereochemistry",
        "stereochemistry of substance" ;
    dcterms:description "The study of the spatial groups that affect the properties of atoms within molecules." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C18188> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:stereochemistry .

