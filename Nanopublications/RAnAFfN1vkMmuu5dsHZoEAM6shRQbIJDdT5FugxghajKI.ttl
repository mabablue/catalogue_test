@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAnAFfN1vkMmuu5dsHZoEAM6shRQbIJDdT5FugxghajKI/> .

<https://w3id.org/iadopt/variable/ReactiveOxygenSpecies> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Reactive oxygen species (ROS)",
        "reactive oxygen species in exposed invertebrate organism" ;
    dcterms:description "chemically reactive oxygen molecules produced during oxidative stress." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D017382> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:ReactiveOxygenSpeciesRos .

