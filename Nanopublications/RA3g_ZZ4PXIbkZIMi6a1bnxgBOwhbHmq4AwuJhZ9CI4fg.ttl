@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA3g_ZZ4PXIbkZIMi6a1bnxgBOwhbHmq4AwuJhZ9CI4fg/> .

<https://w3id.org/iadopt/variable/CometAssay> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Comet assay",
        "comet assay (DNA damage) in plant nuclei." ;
    dcterms:description "A genotoxicological technique for measuring DNA damage in an individual cell using single-cell gel electrophoresis." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/MESH_D020552> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:DNAdamage .

