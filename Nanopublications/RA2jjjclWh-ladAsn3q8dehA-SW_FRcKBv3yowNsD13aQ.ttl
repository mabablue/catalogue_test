@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2jjjclWh-ladAsn3q8dehA-SW_FRcKBv3yowNsD13aQ/> .

<https://w3id.org/iadopt/variable/SizeDCS> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Nanomaterial size measured by DCS" ;
    iop:hasObjectOfInterest sub:Nanomaterial ;
    iop:hasProperty sub:Size .

