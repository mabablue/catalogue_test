@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAfE9vSv_wUlM8hG0RMsAHTXGc6bVrcfwZ2-nYAA6w_bA/> .

<https://w3id.org/iadopt/variable/SumNonMetalIonisationPotentialEnergy> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Sum of ionization potential energy of active non-metals" ;
    dcterms:description "The final aggregate amount of the potential energy that binds an electron to an atom or molecule, in this instance pertaining  to electronegative chemical elements not characterised by ductility, malleability, luster, and conductance of heat and electricity  that are exerting influence or producing an effect" ;
    iop:hasObjectOfInterest sub:NonMetal ;
    iop:hasProperty sub:SumIonisationPotentialEnergy .

