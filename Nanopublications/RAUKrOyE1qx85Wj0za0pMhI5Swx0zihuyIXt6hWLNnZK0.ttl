@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAUKrOyE1qx85Wj0za0pMhI5Swx0zihuyIXt6hWLNnZK0/> .

<https://w3id.org/iadopt/variable/WearRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Wear rate",
        "wear rate of material" ;
    dcterms:description "the volume of material lost per unit load and per unit sliding distance during frictional contact." ;
    rdfs:seeAlso <https://www.sciencedirect.com/topics/engineering/specific-wear-rate> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:WearRate .

