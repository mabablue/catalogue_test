@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAoRuBsgozgmES9acyIXVFPz_KylqAF79R_GecmuzVDmM/> .

<https://w3id.org/iadopt/variable/SoftwareDocumentation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Software Documentation" ;
    dcterms:description "A resource that provides access to instructions regarding how software operates or how to use it." ;
    rdfs:seeAlso <http://bioontology.org/ontologies/BiomedicalResourceOntology.owl#Software_Documentation> ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:documentation .

