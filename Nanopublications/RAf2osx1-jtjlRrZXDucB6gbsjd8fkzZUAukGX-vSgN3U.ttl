@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAf2osx1-jtjlRrZXDucB6gbsjd8fkzZUAukGX-vSgN3U/> .

<https://w3id.org/iadopt/variable/SpecificSurfaceArea> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Specific surface area" ;
    dcterms:description "A property of solids which is the total surface area of a material per unit of mass, solid or bulk volume, or cross-sectional area" ;
    iop:hasObjectOfInterest sub:NP ;
    iop:hasProperty <http://semanticscience.org/resource/CHEMINF_000515> .

