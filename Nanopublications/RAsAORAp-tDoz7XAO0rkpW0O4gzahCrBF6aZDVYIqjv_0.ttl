@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAsAORAp-tDoz7XAO0rkpW0O4gzahCrBF6aZDVYIqjv_0/> .

<https://w3id.org/iadopt/variable/NKcellActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "NK cell activity",
        "NK cell activity in exposed animal" ;
    dcterms:description "the cytotoxic activity of natural killer cells." ;
    rdfs:seeAlso <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C19940> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:naturalkillercellactivity .

