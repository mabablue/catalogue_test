@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAFFy5J_s5TT14WjMA4yyarZZRSE03zf6Jr8c2gtRD_nU/> .

<https://w3id.org/iadopt/variable/ImplantationSites> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Implantation sites",
        "implantation sites in exposed animal" ;
    dcterms:description "the site of the uterus at which the early embryo is attached." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C77678> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:implantationSiteNumber .

