@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAkPi54nhzgtmBJeIW-iVpt7BGMYN2BcA1gz0wiDiGFQg/> .

<https://w3id.org/iadopt/variable/ChemicalComposition> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Chemical composition" ;
    dcterms:description "A quality inhering in an object by virtue of the type, quantities or relative ratios of chemical components of the inhering entity" ;
    iop:hasObjectOfInterest sub:Material ;
    iop:hasProperty <http://purl.bioontology.org/ontology/npo#NPO_1344> .

