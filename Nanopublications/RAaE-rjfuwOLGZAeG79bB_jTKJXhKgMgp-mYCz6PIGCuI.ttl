@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAaE-rjfuwOLGZAeG79bB_jTKJXhKgMgp-mYCz6PIGCuI/> .

<https://w3id.org/iadopt/variable/ZetaPotential> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Zeta potential",
        "zeta potential of material" ;
    dcterms:description "The potential difference between the bulk dispersion medium (liquid) and the stationary layer of liquid near the surface of the dispersed particulate." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1302> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:ZetaPotential .

