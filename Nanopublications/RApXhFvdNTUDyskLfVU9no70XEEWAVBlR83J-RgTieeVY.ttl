@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RApXhFvdNTUDyskLfVU9no70XEEWAVBlR83J-RgTieeVY/> .

<https://w3id.org/iadopt/variable/Diameter> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Diameter",
        "length of material" ;
    dcterms:description "The length of a straight line passing through the center of a circle or sphere and connecting two points on the circumference." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:length .

