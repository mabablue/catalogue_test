@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA-yWv5FQsXcRJLtuegMgb3l2_R1FrqaXJZ4JsVOQoQkI/> .

<https://w3id.org/iadopt/variable/CytokineRelease> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Cytokine release (IL-1α, etc.)",
        "cytokine release from skin/cell model" ;
    dcterms:description "the secretion of inflammatory signaling proteins, such as IL-1α, by cells in response to exposure to a substance." ;
    iop:hasObjectOfInterest <https://w3id.org/np/RA-yWv5FQsXcRJLtuegMgb3l2_R1FrqaXJZ4JsVOQoQkI/cell/skinModel> ;
    iop:hasProperty sub:cytokineRelease .

