@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAq20dwetSAqoVpZ9jpMHEQSYsX11oBkxqoFZMf-NP_NA/> .

<https://w3id.org/iadopt/variable/FlexuralModulus> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Flexural modulus",
        "flexural modulus of material" ;
    dcterms:description "the measure of a material’s stiffness in bending, defined as stress divided by strain in the elastic region of a flexural test." ;
    rdfs:seeAlso <http://materialsmine.org/ns/FlexuralModulus> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:FlexuralModulus .

