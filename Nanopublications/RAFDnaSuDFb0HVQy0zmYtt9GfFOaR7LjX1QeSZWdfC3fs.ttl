@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAFDnaSuDFb0HVQy0zmYtt9GfFOaR7LjX1QeSZWdfC3fs/> .

<https://w3id.org/iadopt/variable/TranspirationRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Transpiration rate (E)",
        "transpiration rate of plant" ;
    dcterms:description "the rate at which water vapor is lost from a leaf to the atmosphere through stomata." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/TO_0001018> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:transpirationRate .

