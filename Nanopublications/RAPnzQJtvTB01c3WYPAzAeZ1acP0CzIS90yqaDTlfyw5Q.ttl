@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAPnzQJtvTB01c3WYPAzAeZ1acP0CzIS90yqaDTlfyw5Q/> .

<https://w3id.org/iadopt/variable/MetalMetalloidElectrons> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Total electrons active metals and metalloids" ;
    dcterms:description "Pertaining to an entirety or whole, also constituting the full quantity or extent, of fundamental particles with a negative charge there are, attributable to electropositive chemical elements that are not characterised by ductility, malleability, luster, and conductance of heat and electricity, in addition to chemical elements with properties between a metal and a non-metal , that are exerting influence or producing an effect" ;
    iop:hasObjectOfInterest sub:MetalMetalloid ;
    iop:hasProperty sub:Electrons .

