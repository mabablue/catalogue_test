@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAQmsFRbB3VA6EWastcubo4dqXYdhk_8VSohYFIcG_coU/> .

<https://w3id.org/iadopt/variable/Incompatibilities> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Incompatibilities",
        "incompatibility of substance" ;
    dcterms:description "the chemical or physical interactions between substances that may result in undesirable or hazardous effects" ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:Incompatibility .

