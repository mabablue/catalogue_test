@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA3UyG94IQS81bx6W-khmM3tkJOmfWFe8WxN8RIZbXb-E/> .

<https://w3id.org/iadopt/variable/ATPcontent> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "ATP content",
        "ATP content per cell or culture" ;
    dcterms:description "the amount of adenosine triphosphate present in cells, reflecting mitochondrial energy production and cellular metabolic activity." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/CHEBI_15422> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:ATPcontent .

