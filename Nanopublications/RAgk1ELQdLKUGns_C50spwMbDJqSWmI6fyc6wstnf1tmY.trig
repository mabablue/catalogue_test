sub:assertion {
  <https://w3id.org/iadopt/variable/CationExchangecapacity> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "A physical quality which inheres in an environmental material by virtue of the material's ability to adsorb exchangeable cations. In soils, these materials include clay and organic matter particles. Soil CEC is measured in millequivalents per 100 grams of soil (meq/100g).";
    rdfs:label "Cation exchange capacity (CEC)", "cation exchange capacity of soil";
    rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_06105240>;
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:soil;
    <https://w3id.org/iadopt/ont/hasProperty> sub:CationExchangeCapacity .
}

