@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAyUaUxCGO8zFMeQ7DtUlWMKdA0qei0Qoi-Z2tNvl9L-w/> .

<https://w3id.org/iadopt/variable/γH2AXfoci> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "γH2AX foci",
        "γH2AX foci per cell" ;
    dcterms:description "nuclear markers of DNA double-strand breaks." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:γH2AXfoci .

