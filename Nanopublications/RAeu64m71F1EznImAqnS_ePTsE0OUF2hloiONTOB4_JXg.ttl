@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAeu64m71F1EznImAqnS_ePTsE0OUF2hloiONTOB4_JXg/> .

<https://w3id.org/iadopt/variable/SizeDistributionDCS> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Nanomaterial size distribution measured by DCS" ;
    iop:hasObjectOfInterest sub:Nanomaterial ;
    iop:hasProperty sub:SizeDistribution .

