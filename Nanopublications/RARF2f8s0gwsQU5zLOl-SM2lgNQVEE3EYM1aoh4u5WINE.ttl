@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RARF2f8s0gwsQU5zLOl-SM2lgNQVEE3EYM1aoh4u5WINE/> .

<https://w3id.org/iadopt/variable/GutAccumulation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Gut accumulation",
        "gut accumulation in exposed invertebrate organism gut" ;
    dcterms:description "the retention of particles in digestive tissues." ;
    iop:hasObjectOfInterest sub:invertebrateOrganismGut ;
    iop:hasProperty sub:GutAccumulation .

