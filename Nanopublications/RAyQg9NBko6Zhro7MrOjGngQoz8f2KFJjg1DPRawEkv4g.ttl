@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAyQg9NBko6Zhro7MrOjGngQoz8f2KFJjg1DPRawEkv4g/> .

<https://w3id.org/iadopt/variable/FiltrationRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Filtration rate",
        "filtration rate in exposed invertebrate organism" ;
    dcterms:description "the volume of water filtered by organisms." ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:FiltrationRate .

