@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RApfHC6mH2wO6m26ErQi_3QraLVpxwi1ZEqsiyzKwZe6s/> .

<https://w3id.org/iadopt/variable/Growth> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Growth (plants)",
        "growth in exposed plants" ;
    dcterms:description "The process of increasing in physical size, mass or number, gradually and irreversibly" ;
    rdfs:seeAlso <http://purl.dataone.org/odo/ECSO_00000540> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:growthrate .

