<https://w3id.org/iadopt/variable/NeurotransmitterLevels> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Neurotransmitter levels",
        "neurotransmitter levels in exposed invertebrate organism" ;
    dcterms:description "the concentrations of chemical messengers responsible for nerve communication." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/OBA_0000116> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:NeurotransmitterLevels .

