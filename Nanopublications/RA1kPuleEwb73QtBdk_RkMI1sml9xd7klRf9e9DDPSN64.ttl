@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA1kPuleEwb73QtBdk_RkMI1sml9xd7klRf9e9DDPSN64/> .

<https://w3id.org/iadopt/variable/ExplosiveProperties> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Explosive properties",
        "explosive properties of substance" ;
    dcterms:description "the physicochemical characteristics of a substance or mixture that determine its potential to undergo rapid energy-releasing reactions leading to explosion." ;
    rdfs:seeAlso <https://www.osha.gov/sites/default/files/appendix_b.pdf> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:ExplosiveProperties .

