@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAn-fsvRq2GqmHSQwbSVFD8L1KgUD0vjV9fnPfL1yuDNM/> .

<https://w3id.org/iadopt/variable/Hygroscopicity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Hygroscopicity",
        "hygroscopicity of substance" ;
    dcterms:description "is a quality inhered in a compound by virtue of its ability to readily take up and retain water, especially from the atmosphere." ;
    rdfs:seeAlso <http://purl.allotrope.org/ontologies/quality#AFQ_0000279> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:hygroscopicity .

