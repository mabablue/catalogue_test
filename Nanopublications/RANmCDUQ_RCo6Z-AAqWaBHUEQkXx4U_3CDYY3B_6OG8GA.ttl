@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RANmCDUQ_RCo6Z-AAqWaBHUEQkXx4U_3CDYY3B_6OG8GA/> .

<https://w3id.org/iadopt/variable/SpecificHeatCapacity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Specific Heat Capacity",
        "specific heat capacity of substance" ;
    dcterms:description "the heat capacity per unit mass of a material" ;
    rdfs:seeAlso <http://bhi.washington.edu/OPB#OPB_01509> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:SpecificHeatCapacity .

