@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAEBmrfK1ug_3UE1F9mutZ2S92BchWlqlmbuJTlW3xhic/> .

<https://w3id.org/iadopt/variable/GrowthInhibition> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Growth inhibition",
        "growth inhibition in exposed organisms" ;
    dcterms:description "the reduction in organism growth rate, size, or biomass caused by exposure to a substance." ;
    iop:hasObjectOfInterest sub:testorganism ;
    iop:hasProperty sub:GrowthInhibition .

