@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAzFHuVA6YQzZ1Zi1vrfsj4aLwA-BZjwRsVH_M4o___pE/> .

<https://w3id.org/iadopt/variable/ImpurityProfile> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Impurity profile" ;
    dcterms:description "A set of analytical information describing the identity, amount, and distribution of impurities present in a material" ;
    iop:hasObjectOfInterest sub:Chemicals ;
    iop:hasProperty sub:ImpurityProfile .

