sub:assertion {
  <https://w3id.org/iadopt/variable/EnergyBandGapBibliographic> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "A descriptor that has been retrieved from an existing library and describes the energy range in a solid where no electron states can exist. In graphs of the electron band structure of solids, the band gap generally refers to the energy difference (in electron volts) between the top of the valence band and the bottom of the conduction band in insulators and semiconductors";
    rdfs:label "Energy band gap (bibliographic, i.e., from libraries)";
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:Material;
    <https://w3id.org/iadopt/ont/hasProperty> <http://semanticscience.org/resource/CHEMINF_000487> .
}

