@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAAy9ttOrOpNMgKweMpujHJ5N8f83zt6Djrd4ZnwqtNFI/> .

<https://w3id.org/iadopt/variable/D13> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average ratio of the coordination parameter between core and shell atoms" ;
    dcterms:description "D13: The average ratio of the coordination parameter between the nanoparticle core and shell atoms" ;
    iop:hasObjectOfInterest sub:NPAtomCoordinationRatio ;
    iop:hasProperty sub:Coordination .

