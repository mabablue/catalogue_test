@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAI6Lj4J2x60DLQApAcPwOZZk63504xCJ1iCbRRS_nCuQ/> .

<https://w3id.org/iadopt/variable/ZetaPotential> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Zeta potential",
        "ζ-potential" ;
    dcterms:description "The potential difference between the bulk dispersion medium (liquid) and the stationary layer of liquid near the surface of the dispersed particulate" ;
    iop:hasObjectOfInterest sub:NP ;
    iop:hasProperty <http://purl.bioontology.org/ontology/npo#NPO_1302> .

