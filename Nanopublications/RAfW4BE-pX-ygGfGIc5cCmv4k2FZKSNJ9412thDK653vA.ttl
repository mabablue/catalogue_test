@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAfW4BE-pX-ygGfGIc5cCmv4k2FZKSNJ9412thDK653vA/> .

<https://w3id.org/iadopt/variable/ChlorophyllFluorescence> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Chlorophyll fluorescence",
        "chlorophyll fluorescence (Fv/Fm) of plant" ;
    dcterms:description "The process by which excess light energy absorbed by chlorophyll and not used to drive photosynthesis is re-emitted as light." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GO_0090546> ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:MaximumQuantumYieldOfPSII .

