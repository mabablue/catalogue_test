@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RASiXIpOXabuwlCQj2MkqJxcwAmcAVLNWWdIcZmWrIWYU/> .

<https://w3id.org/iadopt/variable/WaterUptake> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Water uptake",
        "water uptake of material" ;
    dcterms:description "the percentage of water absorbed by a material relative to its dry mass." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:WaterUptake .

