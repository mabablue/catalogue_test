@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RApwpDUQ4VwxJNGTf4Cwx1QzJ5CEeCWgF-40Y-ytBfVB4/> .

<https://w3id.org/iadopt/variable/SeedlingEmergence> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Seedling emergence",
        "seedling emergence of plant" ;
    dcterms:description "the process by which a germinated seedling grows and becomes visible above the soil surface." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/201106066617941061> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:EmergenceRate .

