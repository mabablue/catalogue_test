<https://w3id.org/iadopt/variable/h-CLATactivation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "h-CLAT activation",
        "h-CLAT assay activation" ;
    dcterms:description "the upregulation of CD86 and/or CD54 in human monocytic cells." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/201306032807893538> ;
    iop:hasObjectOfInterest sub:inVitroImmuneAssay ;
    iop:hasProperty sub:h-CLATactivation .

