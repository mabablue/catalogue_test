@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAPt4l2JR2bkclWRTJMOF6DonHnmlk1vLv86pKai5zYR8/> .

<https://w3id.org/iadopt/variable/VapourPressure> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Vapour pressure",
        "vapour pressure of substance" ;
    dcterms:description "A descriptor of the pressure exerted by the vapour phase of a chemical substance on its condensed phase at a given temperature and pressure." ;
    rdfs:seeAlso <http://semanticscience.org/resource/CHEMINF_000419> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:VapourPressure .

