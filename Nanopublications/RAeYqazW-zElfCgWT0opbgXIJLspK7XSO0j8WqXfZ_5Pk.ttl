@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAeYqazW-zElfCgWT0opbgXIJLspK7XSO0j8WqXfZ_5Pk/> .

<https://w3id.org/iadopt/variable/CompressiveStrength> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Compressive strength",
        "compressive strength of material" ;
    dcterms:description "The maximum compression a material can withstand without failure." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D019245> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:CompressiveStrength .

