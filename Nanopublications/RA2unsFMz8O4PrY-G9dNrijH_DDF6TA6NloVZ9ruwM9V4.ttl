@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2unsFMz8O4PrY-G9dNrijH_DDF6TA6NloVZ9ruwM9V4/> .

<https://w3id.org/iadopt/variable/D12> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average difference of the coordination parameter between core and shell atoms" ;
    dcterms:description "D12: The average difference of the coordination parameter between the nanoparticle core and shell atoms" ;
    iop:hasObjectOfInterest sub:NPAtomCoordinationDifference ;
    iop:hasProperty sub:D12 .

