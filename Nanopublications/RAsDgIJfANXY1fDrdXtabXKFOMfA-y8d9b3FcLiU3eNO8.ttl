@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAsDgIJfANXY1fDrdXtabXKFOMfA-y8d9b3FcLiU3eNO8/> .

<https://w3id.org/iadopt/variable/DrySoilConcentration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Dry soil concentration",
        "dry soil concentration of test substance" ;
    dcterms:description "the mass of a substance per mass of dry soil." ;
    iop:hasObjectOfInterest sub:soil ;
    iop:hasProperty sub:concentration .

