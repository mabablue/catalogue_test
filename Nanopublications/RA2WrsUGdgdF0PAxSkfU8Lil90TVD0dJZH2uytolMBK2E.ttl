@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2WrsUGdgdF0PAxSkfU8Lil90TVD0dJZH2uytolMBK2E/> .

<https://w3id.org/iadopt/variable/PeptideDepletion> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Peptide depletion",
        "peptide depletion in test system" ;
    dcterms:description "the reduction in concentration of model peptides caused by covalent binding of a substance, indicating its potential to induce skin sensitization." ;
    iop:hasObjectOfInterest sub:testSystem ;
    iop:hasProperty sub:peptideDepletion .

