@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAfUspt6ODyDdUwwf-E9wq6-ezwCqELVJBgj6lN71vihg/> .

<https://w3id.org/iadopt/variable/MicronucleusFrequency> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "micronucleus frequency",
        "micronucleus frequency in cells" ;
    dcterms:description "the occurrence rate of micronuclei in cells." ;
    rdfs:seeAlso <https://www.sciencedirect.com/science/article/abs/pii/S1383574208000793> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:micronucleusfrequency .

