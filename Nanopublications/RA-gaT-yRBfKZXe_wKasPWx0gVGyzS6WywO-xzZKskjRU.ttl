@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA-gaT-yRBfKZXe_wKasPWx0gVGyzS6WywO-xzZKskjRU/> .

<https://w3id.org/iadopt/variable/SoilTextureClass> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Soil texture class",
        "soil texture class of growing medium" ;
    dcterms:description "the grouping of soils based on the relative proportions of sand, silt, and clay particles." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/ENVO_06105271> ;
    iop:hasObjectOfInterest sub:soil ;
    iop:hasProperty sub:SoilTextureClass .

