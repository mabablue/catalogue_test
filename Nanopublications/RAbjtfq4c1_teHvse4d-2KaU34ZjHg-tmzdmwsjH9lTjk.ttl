@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbjtfq4c1_teHvse4d-2KaU34ZjHg-tmzdmwsjH9lTjk/> .

<https://w3id.org/iadopt/variable/BioconcentrationFactor> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Bioconcentration factor (BCF)",
        "bioconcentration factor (bcf) in exposed invertebrate organism" ;
    dcterms:description "the ratio of the concentration of a substance in an organism to its concentration in the surrounding environmental medium" ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/200906002110085213> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:BioconcentrationFactorBcf .

