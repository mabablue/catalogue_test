@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAjCkiaa4aEw8KrGfTz6p5xd7Txxx1NsXB20Yqv4xQBZU/> .

<https://w3id.org/iadopt/variable/BodyWeightChange> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Body weight change",
        "body weight change in exposed animal" ;
    dcterms:description "Any measurement of the alteration(s) in body weight over time." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/CMO_0002045> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:BodyWeightChange .

