@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAqDWaPpMKWtDMUF8kiuaJSEIKCBTO0F3ufWo-62EzOW4/> .

<https://w3id.org/iadopt/variable/SoftwareComponentType> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Software Component Type" ;
    dcterms:description "The category of a software component based on its role or function within a software system (e.g., library, module, plugin, service, API, UI component, database, workflow step)." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:componenttype .

