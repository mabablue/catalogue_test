sub:assertion {
  <https://w3id.org/iadopt/variable/Hygroscopicity> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "is a quality inhered in a compound by virtue of its ability to readily take up and retain water, especially from the atmosphere.";
