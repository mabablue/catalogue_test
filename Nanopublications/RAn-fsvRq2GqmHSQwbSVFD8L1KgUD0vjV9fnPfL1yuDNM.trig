    rdfs:seeAlso <http://purl.allotrope.org/ontologies/quality#AFQ_0000279>;
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:substance;
    <https://w3id.org/iadopt/ont/hasProperty> sub:hygroscopicity .
}

