@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAX7sEvmmpQ536b85doC7ENrJBuzLUKD6obzM0SoxHoPk/> .

<https://w3id.org/iadopt/variable/EggProductionRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Egg production rate",
        "egg production rate in exposed invertebrate organism" ;
    dcterms:description "the number of eggs produced per organism over time." ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:EggProductionRate .

