@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAWML7WxpscG78Vt-kWtnRyGIvSv7lJrxAetfpVI6LxG0/> .

<https://w3id.org/iadopt/variable/OrganConcentration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Organ concentration",
        "organ concentration of test substance" ;
    dcterms:description "the amount of a substance present per unit mass of a specific organ following exposure." ;
    iop:hasObjectOfInterest <https://w3id.org/np/RAWML7WxpscG78Vt-kWtnRyGIvSv7lJrxAetfpVI6LxG0/organ/tissue> ;
    iop:hasProperty sub:organconcentrationoftestsubstance .

