@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA63iBknmKIE9qXmv_aMeiIZBk3ccWDSEGW-YP4LKJqSo/> .

<https://w3id.org/iadopt/variable/Whole-plantUptake> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Whole-plant uptake",
        "whole-plant uptake of test substance" ;
    dcterms:description "the total absorption of a substance by a plant from its growth medium." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/201406039584489308> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:TestSubstanceUptake .

