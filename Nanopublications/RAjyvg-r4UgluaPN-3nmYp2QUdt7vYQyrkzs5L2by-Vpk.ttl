@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAjyvg-r4UgluaPN-3nmYp2QUdt7vYQyrkzs5L2by-Vpk/> .

<https://w3id.org/iadopt/variable/LeafAreaDose> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Leaf area dose (areic)",
        "leaf area dose of test substance" ;
    dcterms:description "the amount of a substance applied per unit surface area of plant leaves." ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:DosePerLeafArea .

