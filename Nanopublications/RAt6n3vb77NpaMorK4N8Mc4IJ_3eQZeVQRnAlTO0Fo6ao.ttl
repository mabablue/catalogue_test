<https://w3id.org/iadopt/variable/Sodium> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Sodium (Na)" ;
    dcterms:description "An element with atomic symbol Na, atomic number 11, and atomic weight 23." ;
    iop:hasObjectOfInterest sub:ChemicalElement ;
    iop:hasProperty <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C830> .

