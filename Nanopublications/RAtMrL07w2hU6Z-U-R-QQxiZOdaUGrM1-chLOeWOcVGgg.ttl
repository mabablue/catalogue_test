@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAtMrL07w2hU6Z-U-R-QQxiZOdaUGrM1-chLOeWOcVGgg/> .

<https://w3id.org/iadopt/variable/SeedGerminationRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Seed germination rate",
        "seed germination rate of plant" ;
    dcterms:description "the proportion of seeds that successfully germinate over a defined period under specified conditions." ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:GerminationRate .

