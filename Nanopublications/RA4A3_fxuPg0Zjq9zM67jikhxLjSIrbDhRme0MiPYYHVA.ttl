@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/iadopt/variable/RepeatedDoseDermalToxicity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Repeated dose dermal toxicity" ;
    dcterms:description "A toxicity disposition that inheres in a substance that is capable of causing harm to or killing organisms when exposed to the skin multiple times" ;
    iop:hasObjectOfInterest <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#C12470> ;
    iop:hasProperty <http://purl.enanomapper.org/onto/ENM_0000027> .

