@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAFhCalFRE_H4bnFl1TsslHRjJwgjlzmVxRgjClpeN28o/> .

<https://w3id.org/iadopt/variable/Shape> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Shape" ;
    dcterms:description "The spatial arrangement of something as distinct from its substance." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_274> ;
    iop:hasObjectOfInterest sub:Shape ;
    iop:hasProperty <http://purl.bioontology.org/ontology/npo#NPO_274> .

