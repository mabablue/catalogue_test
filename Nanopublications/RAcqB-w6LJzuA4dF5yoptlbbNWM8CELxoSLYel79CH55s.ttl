@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAcqB-w6LJzuA4dF5yoptlbbNWM8CELxoSLYel79CH55s/> .

<https://w3id.org/iadopt/variable/D34> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The diameter of the NP in A" ;
    dcterms:description "D34: The diameter of the nanoparticle in A" ;
    iop:hasObjectOfInterest sub:Nanoparticle ;
    iop:hasProperty sub:Diameter .

