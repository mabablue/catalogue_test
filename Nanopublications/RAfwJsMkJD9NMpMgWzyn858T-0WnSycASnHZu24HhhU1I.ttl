<https://w3id.org/iadopt/variable/ElectronTransportRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Electron transport rate (ETR)",
        "electron transport rate of plant" ;
    dcterms:description "the rate at which electrons are transported through photosystem II during photosynthesis, reflecting photosynthetic activity." ;
    rdfs:seeAlso <https://www.sciencedirect.com/science/article/pii/S0034425720306465#:~:text=Abstract,%2C%20temperature%20and%20soil%20moisture).> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:ElectronTransportRate .

