@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA58u9FGWmQzrhjoVhvpiTWiQljGbPXW3ZiJx6Rfcg9o8/> .

<https://w3id.org/iadopt/variable/SpecificSurfaceArea> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Specific surface area",
        "specific surface area of material" ;
    dcterms:description "A property of solids which is the total surface area of a material per unit of mass, solid or bulk volume, or cross-sectional area." ;
    rdfs:seeAlso <http://semanticscience.org/resource/CHEMINF_000515> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:SpecificSurfaceArea .

