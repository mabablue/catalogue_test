sub:variable16 a iop:Variable ;
    rdfs:label "Standard metabolic rate in mg of Oxygen per hour",
        "standard metabolic rate" ;
    dcterms:description "The measure of an ectotherm animal's baseline metabolic rate (i.e. non-active, non-stressed) measured by the milligrams of oxygen consumed in a period of time of one hour." ;
    iop:hasConstraint <http://purl.obolibrary.org/obo/XCO_0000002> ;
    iop:hasObjectOfInterest <http://purl.jp/bio/4/id/200906094509973882> ;
    iop:hasProperty <http://vocabs.lter-europe.net/EnvThes/21316> .

<http://purl.obolibrary.org/obo/XCO_0000002> a iop:Constraint ;
    iop:constrains <http://vocabs.lter-europe.net/EnvThes/21316> .

