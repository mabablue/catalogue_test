@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATgBAmVQnesq33GMTesz5EHXTtlXbVGtqsEyUo8-1Q54/> .

<https://w3id.org/iadopt/variable/ElectricalConductivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Electrical conductivity",
        "electrical conductivity of material" ;
    dcterms:description "the measure of a material’s ability to conduct electric current." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/PATO_0001757> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:ElectricalConductivity .

