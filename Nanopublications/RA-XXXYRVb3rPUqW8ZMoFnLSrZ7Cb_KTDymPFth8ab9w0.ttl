@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA-XXXYRVb3rPUqW8ZMoFnLSrZ7Cb_KTDymPFth8ab9w0/> .

<https://w3id.org/iadopt/variable/PersistentParticleBurden> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Persistent particle burden",
        "persistent particle burden in exposed organism" ;
    dcterms:description "the amount of particulate material that remains in tissues or organisms over time due to limited clearance or degradation." ;
    iop:hasObjectOfInterest sub:organism ;
    iop:hasProperty sub:persistentParticleLoad .

