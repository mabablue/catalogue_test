<https://w3id.org/iadopt/variable/BulkDensity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Bulk density" ;
    dcterms:description "the mass of a material divided by its bulk volume." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty <http://vocabs.lter-europe.net/EnvThes/22074> .

