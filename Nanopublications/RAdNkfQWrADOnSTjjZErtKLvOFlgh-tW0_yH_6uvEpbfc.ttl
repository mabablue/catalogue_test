@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAdNkfQWrADOnSTjjZErtKLvOFlgh-tW0_yH_6uvEpbfc/> .

<https://w3id.org/iadopt/variable/Survival> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Survival",
        "survival in exposed organisms" ;
    dcterms:description "Continuance of life or existence especially under adverse conditions" ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D013534> ;
    iop:hasObjectOfInterest sub:testorganism ;
    iop:hasProperty sub:survivalRate .

