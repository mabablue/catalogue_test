@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA4NIVnEeL_iKws6Y3OExktsN1HB-lmEDPQzHWkbfrrak/> .

<https://w3id.org/iadopt/variable/pKa> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "pKa",
        "pKa of substance" ;
    dcterms:description "the logarithmic measure of the acid dissociation constant (Ka)" ;
    rdfs:seeAlso <http://semanticscience.org/resource/CHEMINF_000195> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:pKa .

