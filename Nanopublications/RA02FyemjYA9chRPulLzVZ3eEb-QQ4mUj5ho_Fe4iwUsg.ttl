@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA02FyemjYA9chRPulLzVZ3eEb-QQ4mUj5ho_Fe4iwUsg/> .

<https://w3id.org/iadopt/variable/FeedingRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Feeding rate",
        "feeding rate in exposed invertebrate organism" ;
    dcterms:description "the amount of food consumed per organism over time." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/201106006571202444> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:FeedingRate .

