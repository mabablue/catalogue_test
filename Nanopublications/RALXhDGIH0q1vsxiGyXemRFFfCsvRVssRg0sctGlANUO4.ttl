@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RALXhDGIH0q1vsxiGyXemRFFfCsvRVssRg0sctGlANUO4/> .

<https://w3id.org/iadopt/variable/CellularUptakeFraction> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Cellular uptake fraction",
        "cellular uptake fraction of test substance" ;
    dcterms:description "the proportion of an applied substance that is internalized by cells relative to the total amount available." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:cellularUptakeFraction .

