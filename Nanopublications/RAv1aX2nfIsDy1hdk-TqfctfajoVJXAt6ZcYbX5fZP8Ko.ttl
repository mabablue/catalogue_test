<https://w3id.org/iadopt/variable/PlantPart> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Part of plant",
        "Plant part" ;
    dcterms:description "Anatomical part of a plant, such as fruit, seed, pod, leaf, stem or flower as well as the whole plant" ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/FOODON_03420174> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty <http://purl.obolibrary.org/obo/FOODON_03420174> .

