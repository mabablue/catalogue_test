@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAq_V1twALDRmrs3GZSBUnlzTppNh7oZ2ov832lISumWc/> .

<https://w3id.org/iadopt/variable/MoltingInterference> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Molting interference (nano)",
        "molting interference  in exposed invertebrate organism" ;
    dcterms:description "disruption of molting due to nanoparticle exposure." ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:MoltingInterferenceNano .

