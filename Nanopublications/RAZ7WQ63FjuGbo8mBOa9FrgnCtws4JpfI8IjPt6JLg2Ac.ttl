@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAZ7WQ63FjuGbo8mBOa9FrgnCtws4JpfI8IjPt6JLg2Ac/> .

<https://w3id.org/iadopt/variable/InflammationScore> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Inflammation score",
        "inflammation score in tissue" ;
    dcterms:description "a semi-quantitative assessment of the severity and extent of inflammatory cell infiltration and tissue changes observed in histological samples." ;
    iop:hasObjectOfInterest <https://w3id.org/np/RAZ7WQ63FjuGbo8mBOa9FrgnCtws4JpfI8IjPt6JLg2Ac/organ/tissue> ;
    iop:hasProperty sub:inflammationseverity .

