@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAE-QOdlG5z-phmiHAPw8aS8N4lioDqS9bMN1r0Vb2JzQ/> .

<https://w3id.org/iadopt/variable/Fibrosis> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Fibrosis",
        "fibrosis in tissue" ;
    dcterms:description "Any pathological condition where fibrous connective tissue invades any organ, usually as a consequence of inflammation or other injury." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D005355> ;
    iop:hasObjectOfInterest <https://w3id.org/np/RAE-QOdlG5z-phmiHAPw8aS8N4lioDqS9bMN1r0Vb2JzQ/organ/tissue> ;
    iop:hasProperty sub:fibrosisExtent .

