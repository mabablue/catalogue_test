@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAcI8G78QmnwkeHgB4Wm0iVWnhqZkH_JidujupRC9NVe8/> .

<https://w3id.org/iadopt/variable/Purity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Purity" ;
    dcterms:description "A composition quality which is the degree to which an object bearer is free of contaminants or heterogeneous components" ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1345> ;
    iop:hasObjectOfInterest sub:Purity ;
    iop:hasProperty <http://purl.bioontology.org/ontology/npo#NPO_1345> .

