@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RARbcsRpPnsMgfMJsG6Big1XfHS6fqIrFNpI2w7qviLeU/> .

<https://w3id.org/iadopt/variable/SoftwareImageContainer> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Container image reference (identifier/location of a container image)",
        "Software Image Container" ;
    dcterms:description "A reference that identifies where a container image for the software can be retrieved, such as an image name and tag/digest in a registry (e.g., ghcr.io/org/tool:1.2.0 or a Docker Hub image URL)." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:SoftwareImageContainer .

