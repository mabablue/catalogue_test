@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAm8iU-4MQY0HK7NJhVEPz73Gj3WQtqOaVyP3q_4Ua3sc/> .

<https://w3id.org/iadopt/variable/CrystalSystem> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Crystal system" ;
    dcterms:description "Classifications of crystal structures based on their lattice symmetry" ;
    iop:hasObjectOfInterest sub:UnitCell ;
    iop:hasProperty sub:CrystalSystem .

