@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAu2Z0Rna1MJQs6sj3LC_1r_1A_AIwjnTDTP9HwxtMK9U/> .

<https://w3id.org/iadopt/variable/VanderWaalsRadiusNonMetals> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Van der Waals radius of active non-metals" ;
    dcterms:description "Half of the equilibrium distance at the minimum of the van der Waals potential between two isolated atoms of chemical elements that are exerting influence or producing an effect and are not electropositive chemical elements characterised by ductility, malleability, luster, and conductance of heat and electricity" ;
    iop:hasObjectOfInterest sub:NonMetal ;
    iop:hasProperty sub:VanderWaalsRadius .

