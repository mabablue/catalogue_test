@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAxT4mvjIcKMwABwmxFj76NAiEWwr-nUeXu6ZkoFm0GEw/> .

<https://w3id.org/iadopt/variable/SoftwareChangeLog> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Software Changelog" ;
    dcterms:description "A maintained record describing changes made between software versions, such as added features, fixes, security patches, deprecations, and known issues." ;
    iop:hasObjectOfInterest sub:software ;
    iop:hasProperty sub:changelog .

