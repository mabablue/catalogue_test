@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAxDZDWeRlybRs6-Zsvk-MFLDXpIeyfkHbfsKygU4tgh0/> .

<https://w3id.org/iadopt/variable/BioaccumulationFactor> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Bioaccumulation factor",
        "bioaccumulation factor of substance" ;
    dcterms:description "the ratio of the concentration of a substance in an organism to its concentration in the surrounding environment at steady state." ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:BioaccumulationFactor .

