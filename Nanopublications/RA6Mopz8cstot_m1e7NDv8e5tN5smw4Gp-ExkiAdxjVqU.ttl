@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA6Mopz8cstot_m1e7NDv8e5tN5smw4Gp-ExkiAdxjVqU/> .

<https://w3id.org/iadopt/variable/DecompositionTemperature> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Decomposition temperature",
        "decomposition temperature of substance" ;
    dcterms:description "the temperature at which a molecule begins to break up and decompose, and it is influenced by factors such as molecular structure, activation energy, aggregated state, and crosslink density of organic materials." ;
    rdfs:seeAlso <http://purl.jp/bio/4/id/200906005131446800> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:DecompositionTemperature .

