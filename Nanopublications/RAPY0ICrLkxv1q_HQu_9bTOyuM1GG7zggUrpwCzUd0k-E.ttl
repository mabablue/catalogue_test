@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAPY0ICrLkxv1q_HQu_9bTOyuM1GG7zggUrpwCzUd0k-E/> .

<https://w3id.org/iadopt/variable/IRspectrum> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "IR spectrum",
        "IR spectrum of substance" ;
    dcterms:description "A plot of absorbance vs. wavelength/wavenumber/frequency obtained by measuring the absorption or emission of infrared radiation by a sample." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/CHMO_0000818> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:InfraredAbsorbance .

