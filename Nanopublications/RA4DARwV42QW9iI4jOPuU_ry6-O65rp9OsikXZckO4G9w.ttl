@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA4DARwV42QW9iI4jOPuU_ry6-O65rp9OsikXZckO4G9w/> .

<https://w3id.org/iadopt/variable/ExplosiveLimits> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Explosive limits",
        "explosive limits of substance" ;
    dcterms:description "the lower and upper volume concentration boundaries of a flammable gas or vapor in air, expressed in % v/v, within which ignition and flame propagation can occur." ;
    rdfs:seeAlso <https://goldbook.iupac.org/terms/view/E02274/pdf#:~:text=explosivity%20limits%20(explosion%20limits)%20The%20concentration%20limits%2C,air%2C%20between%20which%20combustion%20will%20be%20self%2Dsustaining.> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:ExplosiveLimits .

