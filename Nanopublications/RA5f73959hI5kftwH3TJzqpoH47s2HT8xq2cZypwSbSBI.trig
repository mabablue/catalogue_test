sub:assertion {
  sub:Variable8 a <https://w3id.org/iadopt/ont/Variable>;
    dct:description "CWD abundance per hectare (m2/hectare) is the abundance of CWD measured from all the plots/transects scaled to a hectare (100 x 100 m). They are calculated using the formula (see https://www.sciencedirect.com/science/article/pii/S037811270900783X)";
    rdfs:label "Coarse woody debris abundance per hectare", "Coarse woody debris abundance";
