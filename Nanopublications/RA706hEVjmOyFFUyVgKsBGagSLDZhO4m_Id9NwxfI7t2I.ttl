<https://w3id.org/iadopt/variable/Crystallinity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Crystallinity",
        "Crystallisation" ;
    dcterms:description "The detection and quantification of the amount of amorphous material within a highly crystalline substance" ;
    iop:hasObjectOfInterest sub:UnitCell ;
