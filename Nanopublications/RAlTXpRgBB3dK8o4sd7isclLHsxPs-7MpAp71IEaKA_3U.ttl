@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAlTXpRgBB3dK8o4sd7isclLHsxPs-7MpAp71IEaKA_3U/> .

<https://w3id.org/iadopt/variable/TNF-αSecretion> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "TNF-α secretion",
        "TNF-α secretion from cells" ;
    dcterms:description "the release of the pro-inflammatory cytokine tumor necrosis factor-alpha by cells in response to stimuli or stress." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:TNF-αSecretionRate .

