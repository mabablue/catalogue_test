@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA9U0SSfOGfrPevtjPV9v4NZrx4-1UTl933Dvlq8PC2Bg/> .

<https://w3id.org/iadopt/variable/DissolutionRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Dissolution rate",
        "dissolution rate of material" ;
    dcterms:description "the rate at which a solid material dissolves into a solvent, measured as the change in solute concentration per unit time." ;
    rdfs:seeAlso <http://purl.enanomapper.org/onto/ENM_1200001> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:DissolutionRate .

