@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGZtiKZedMGQgM203GrsKD8bL-Kycp_y_BpDridEVVMg/> .

<https://w3id.org/iadopt/variable/StockConcentration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Stock concentration" ;
    dcterms:description "The quantity of nanomaterials (e.g., nanoparticles) present in a specific volume of solution" ;
    iop:hasObjectOfInterest sub:NP ;
    iop:hasProperty sub:StockConcentration .

