<https://w3id.org/iadopt/variable/LipidPeroxidation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Lipid peroxidation (MDA/TBARS)",
        "lipid peroxidation in plant tissue" ;
    dcterms:description "The degradation of lipids caused by an oxidative attack from free radicals." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/NCIT_C81870> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:LipidPeroxidationLevel .

