@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAgipQbSi6MT7W_JtN-msTah0GohYyTtDvgRpXcR_Gk2k/> .

<https://w3id.org/iadopt/variable/ConditionIndex> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Condition index (molluscs)",
        "condition index (molluscs) in exposed invertebrate organism" ;
    dcterms:description "a measure of organism health based on tissue mass relative to size." ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:ConditionIndexMolluscs .

