@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAmE1DyDBJbC8w24E9VH4a4nnwSUJRVrNkBqF35qnyN4Q#> .

sub:test a iop:Variable ;
    rdfs:label "nights in 3-star hotel" ;
    dcterms:description "nights in 3-star hotel" ;
    iop:hasConstraint sub:3-star ;
    iop:hasMatrix sub:hotel ;
    iop:hasObjectOfInterest sub:nights ;
    iop:hasProperty sub:count .

