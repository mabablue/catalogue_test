<https://w3id.org/iadopt/variable/LeafLitterDecompositionRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Leaf litter decomposition rate",
        "leaf litter decomposition rate in exposed invertebrate organism" ;
    dcterms:description "the breakdown of organic material." ;
    rdfs:seeAlso <http://vocabs.lter-europe.net/EnvThes/msa0594> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:LeafLitterDecompositionRate .

