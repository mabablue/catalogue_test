@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAxYNyMFHzfGsBw6O47sGQ_k4BZDPiSEiCB-k6MsvGUXM#> .

sub:SEIALWASO4T8PIC a iop:Variable ;
    rdfs:label "Soil erosion in arable land with a slope of 4 to 8 percent in catchment" ;
    dcterms:description "Soil erosion in arable land with a slope of 4 to 8 percent in catchment" ;
    iop:hasConstraint sub:arable,
        sub:slope_of_4_to_8_percent ;
    iop:hasMatrix sub:land ;
    iop:hasObjectOfInterest sub:soil ;
    iop:hasProperty sub:erosion_mass_per_area_per_time\) .

