@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAwiXqpQH0nAvhoIeKuB3leKeUcizWEXq5me5Qvh3ogsk/> .

<https://w3id.org/iadopt/variable/HydroponicExposure> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Hydroponic exposure",
        "hydroponic exposure method" ;
    dcterms:description "the exposure of organisms to a test substance via an aqueous nutrient solution." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:ExposureMethod .

