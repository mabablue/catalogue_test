@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2nfVWLr6MkzgN29r8JxyHqXPQAEgvXv3DaFmtGCQMc4/> .

<https://w3id.org/iadopt/variable/Time-to-death> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Time-to-death (LT50)",
        "time-to-death in exposed invertebrate organism" ;
    dcterms:description "Time-to-death is the duration required for 50% of exposed organisms to die after exposure, reflecting the speed and severity of toxic effects" ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:TimeToDeathLt50 .

