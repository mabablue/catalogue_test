sub:assertion {
  <https://w3id.org/iadopt/variable/Normalisation> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "Normalisation is a data transformation process which aims at making data seem roughly normally distributied by applying a mathematical function, which is most of time a continuous function. This is a row operation that is applied to the data from each sample and comprises methods to make the data from all samples directly comparable with each other. A common use is to remove or minimise the effects of variable dilution of the samples";
    rdfs:label "Normalisation";
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:Data;
    <https://w3id.org/iadopt/ont/hasProperty> <http://nmrML.org/nmrCV#NMR:1400064> .
}

