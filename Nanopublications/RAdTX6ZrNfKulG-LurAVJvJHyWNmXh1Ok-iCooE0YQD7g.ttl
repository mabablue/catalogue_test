@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAdTX6ZrNfKulG-LurAVJvJHyWNmXh1Ok-iCooE0YQD7g/> .

<https://w3id.org/iadopt/variable/DecompositionTemperature> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Decomposition temperature" ;
    dcterms:description "the temperature at which a material undergoes irreversible chemical degradation, resulting in the breakdown of its molecular or crystal structure." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:DecompositionTemperature .

