@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAAHdSy1kGVAO3vATkaCflYQcBdtufjq7zkbs3D33hWUU/> .

<https://w3id.org/iadopt/variable/RootDipping> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Root dipping",
        "root dipping method" ;
    dcterms:description "the exposure of plant roots to a substance by immersion in a liquid medium." ;
    rdfs:seeAlso <https://www.researchgate.net/figure/Root-dipping-technique_fig3_342420925> ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:ExposureMethod .

