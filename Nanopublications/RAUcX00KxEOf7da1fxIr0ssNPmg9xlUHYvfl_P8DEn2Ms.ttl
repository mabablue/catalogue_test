@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAUcX00KxEOf7da1fxIr0ssNPmg9xlUHYvfl_P8DEn2Ms/> .

<https://w3id.org/iadopt/variable/GrapheneQD> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Graphene quantum dot" ;
    dcterms:description "A quantum dot composed of graphene." ;
    iop:hasObjectOfInterest sub:Graphene ;
    iop:hasProperty sub:GrapheneQD .

