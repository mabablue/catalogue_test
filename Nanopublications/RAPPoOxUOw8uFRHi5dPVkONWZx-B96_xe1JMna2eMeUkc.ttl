@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAPPoOxUOw8uFRHi5dPVkONWZx-B96_xe1JMna2eMeUkc/> .

<https://w3id.org/iadopt/variable/OxideNo> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Number of oxygen atoms" ;
    dcterms:description "Number of oxygen atoms" ;
    iop:hasObjectOfInterest sub:Oxygen ;
    iop:hasProperty sub:OxygenNo .

