@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATF1XcOrVSb6NSH1ZEvNE37TVr_OtH7HkXUVEM4Kr-MU/> .

<https://w3id.org/iadopt/variable/QuantityMacromolecules> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Quantity of Macromolecules" ;
    dcterms:description "How many molecules there are with high relative molecular mass, the structure of which essentially comprises the multiple repetition of units derived, actually or conceptually, from molecules of low relative molecular mass" ;
    iop:hasObjectOfInterest sub:Macromolecules ;
    iop:hasProperty sub:Quantity .

