@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RARAHz8mj09fpt97nFn9-pfSaX4LesBbDjIS9DO1ZOB4c/> .

<https://w3id.org/iadopt/variable/ComplementActivation> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Complement activation",
        "complement activation level in vitro" ;
    dcterms:description "The sequential activation of serum complement proteins to create the complement membrane attack complex." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D003167> ;
    iop:hasObjectOfInterest sub:complementSystem ;
    iop:hasProperty sub:complementActivation .

