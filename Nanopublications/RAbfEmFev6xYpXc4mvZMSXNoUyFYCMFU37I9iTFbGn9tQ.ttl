@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAbfEmFev6xYpXc4mvZMSXNoUyFYCMFU37I9iTFbGn9tQ/> .

<https://w3id.org/iadopt/variable/Cultivar/LineAccession> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Cultivar / line accession",
        "cultivar/line accession of plant" ;
    dcterms:description "the specific named variety, genetic line, or germplasm accession of a plant used in a study." ;
    iop:hasObjectOfInterest sub:plant ;
    iop:hasProperty sub:geneticIdentity .

