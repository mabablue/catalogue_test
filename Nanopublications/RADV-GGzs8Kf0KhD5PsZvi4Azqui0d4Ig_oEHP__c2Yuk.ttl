sub:IsobutyleneConcentration a iop:Variable ;
    rdfs:label "Mass concentration of isobutylene in chloroform" ;
    dcterms:description "The mass of isobutylene divided by the volume of the mixture of isobutylene and chloroform, expressed as mass per unit volume." ;
