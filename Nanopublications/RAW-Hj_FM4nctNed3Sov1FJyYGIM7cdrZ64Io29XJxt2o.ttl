@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAW-Hj_FM4nctNed3Sov1FJyYGIM7cdrZ64Io29XJxt2o/> .

<https://w3id.org/iadopt/variable/TUNELpositivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "TUNEL positivity",
        "TUNEL-positive cell fraction" ;
    dcterms:description "the presence of DNA strand breaks detected by terminal deoxynucleotidyl transferase dUTP nick end labeling (TUNEL), indicating apoptotic DNA fragmentation." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:TUNELpositivity .

