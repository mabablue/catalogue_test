@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2PCVAM9dvocE37JP9-OxX8FvUVw1LtUCtMunozqkhl0/> .

<https://w3id.org/iadopt/variable/MetaboliteProfiling> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Metabolite profiling",
        "metabolite profile in cells/media" ;
    dcterms:description "a process which aims at detecting and identifying chemical entities resulting from biochemical and cellular metabolism" ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/OBI_0000366> ;
    iop:hasObjectOfInterest <https://w3id.org/np/RA2PCVAM9dvocE37JP9-OxX8FvUVw1LtUCtMunozqkhl0/cell/media> ;
    iop:hasProperty sub:metaboliteProfile .

