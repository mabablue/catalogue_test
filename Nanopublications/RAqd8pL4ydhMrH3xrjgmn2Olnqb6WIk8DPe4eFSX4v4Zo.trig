sub:assertion {
  <https://w3id.org/iadopt/variable/MetalMetalloidNeutrons> a <http://www.w3.org/2002/07/owl#NamedIndividual>,
      <https://w3id.org/iadopt/ont/Variable>;
    dct:description "Pertaining to an entirety or whole, also constituting the full quantity or extent, of elementary particles  with 0 charge and a mass about equal to that of a proton there are, attributable to electropositive chemical elements that are not characterised by ductility, malleability, luster, and conductance of heat and electricity, in addition to chemical elements with properties between a metal and a non-metal , that are exerting influence or producing an effect";
    rdfs:label "Total neutrons of active metals and metalloids";
    <https://w3id.org/iadopt/ont/hasObjectOfInterest> sub:MetalMetalloid;
    <https://w3id.org/iadopt/ont/hasProperty> sub:Neutrons .
}

