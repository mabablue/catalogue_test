@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sub: <https://w3id.org/np/RAAaezm_ikn5ufckdZktsx_qPyA4-tW0vbsXnuz9vQyMg/> .

<https://w3id.org/iadopt/variable/RAAaezm_ikn5ufckdZktsx_qPyA4-tW0vbsXnuz9vQyMg> a owl:NamedIndividual,
        iop:Variable ;
    skos:definition "Dynamic shear viscosity of polystyrene PS042 under the testing conditions of DIN 51810-1" ;
    skos:prefLabel "Dynamic shear viscosity of PS042" ;
    iop:hasConstraint sub:d0 ;
    iop:hasObjectOfInterest <https://www.ebi.ac.uk/chebi/CHEBI:53270> ;
    iop:hasProperty <http://qudt.org/vocab/quantitykind/DynamicViscosity> .

sub:d0 a iop:Constraint ;
    rdfs:label "condition: under the testing conditions of DIN 51810-1" ;
    iop:constrains <http://qudt.org/vocab/quantitykind/DynamicViscosity> .

<https://www.ebi.ac.uk/chebi/CHEBI:53270> a iop:Entity ;
    rdfs:label "polystyrene" .

<http://qudt.org/vocab/quantitykind/DynamicViscosity> a iop:Property ;
    rdfs:label "dynamic viscosity" .

