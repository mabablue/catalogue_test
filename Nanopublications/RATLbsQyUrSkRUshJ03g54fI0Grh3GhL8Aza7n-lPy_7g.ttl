@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RATLbsQyUrSkRUshJ03g54fI0Grh3GhL8Aza7n-lPy_7g/> .

<https://w3id.org/iadopt/variable/SeedTissue> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Fruit tissue",
        "seed/fruit tissue of plant" ;
    dcterms:description "the plant material comprising seeds or fruits, used for sampling to assess substance uptake or accumulation." ;
    rdfs:seeAlso <https://w3id.org/bervo/BERVO_8000120> ;
    iop:hasObjectOfInterest sub:Plants ;
    iop:hasProperty sub:TissueType .

