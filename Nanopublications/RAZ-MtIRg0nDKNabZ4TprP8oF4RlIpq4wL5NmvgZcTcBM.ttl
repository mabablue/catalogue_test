@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAZ-MtIRg0nDKNabZ4TprP8oF4RlIpq4wL5NmvgZcTcBM/> .

<https://w3id.org/iadopt/variable/LocomotorActivity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Locomotor activity",
        "locomotor activity in exposed invertebrate organism" ;
    dcterms:description "the level of spontaneous movement exhibited by organisms." ;
    rdfs:seeAlso <http://bioontology.org/projects/ontologies/birnlex#birnlex_1892> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:LocomotorActivity .

