@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA_8xKixi39v4qXcmeWGQWDpd-iPjajoCjHbBD-aacdck/> .

<https://w3id.org/iadopt/variable/TimeToTumor> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Time to tumor",
        "time to tumor in exposed animal" ;
    dcterms:description "the elapsed time between substance exposure and the first detection of a tumor in an organism." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:timeToTumorOnset .

