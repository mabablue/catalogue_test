@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAcclXgNCq42GCWxPp7tluWXg4Nn8uZjeCX1zqNoYOJbU/> .

<https://w3id.org/iadopt/variable/GeneMutationFrequency> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Gene mutation frequency",
        "gene mutation frequency in cells" ;
    dcterms:description "the rate at which heritable changes in DNA sequence occur in a defined gene or genomic region following exposure to a substance." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/APO_0000198> ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:geneMutationFrequency .

