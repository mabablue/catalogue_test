@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2r8bOuEjC5XhCulETOyAX0nvjN7P1OGhFP-IWVavpiY/> .

<https://w3id.org/iadopt/variable/TranslocationFraction> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Translocation fraction",
        "translocation fraction across barrier" ;
    dcterms:description "the fraction of a substance that crosses a biological barrier." ;
    iop:hasObjectOfInterest sub:BarrierModel ;
    iop:hasProperty sub:translocationFraction .

