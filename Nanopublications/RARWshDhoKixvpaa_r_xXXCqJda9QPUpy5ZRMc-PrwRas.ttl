@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RARWshDhoKixvpaa_r_xXXCqJda9QPUpy5ZRMc-PrwRas/> .

<https://w3id.org/iadopt/variable/TumorMultiplicity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Tumor multiplicity",
        "tumor multiplicity in exposed animal" ;
    dcterms:description "the number of tumors observed per organism or per organ following exposure to a substance." ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:tumorMultiplicity .

