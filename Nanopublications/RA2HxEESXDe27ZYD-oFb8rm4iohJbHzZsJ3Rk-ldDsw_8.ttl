@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA2HxEESXDe27ZYD-oFb8rm4iohJbHzZsJ3Rk-ldDsw_8/> .

<https://w3id.org/iadopt/variable/CarryingCapacity> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Carrying capacity (K)",
        "carrying capacity in exposed invertebrate population" ;
    dcterms:description "the maximum population size an environment can sustain." ;
    rdfs:seeAlso <http://sbmi.uth.tmc.edu/ontology/ochv#2492> ;
    iop:hasObjectOfInterest sub:invertebratePopulation ;
    iop:hasProperty sub:CarryingCapacityK .

