@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA4vyZRNWis5cxBwxPr7DPbjT-rKC-e7OKS3kitVHrvCY/> .

<https://w3id.org/iadopt/variable/FlexuralStrength> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Flexural strength",
        "flexural strength of material" ;
    dcterms:description "The maximum mechanical stress that a material, subject to a bending load or flexure, can withstand before fracturing." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D000077298> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:FlexuralStrength .

