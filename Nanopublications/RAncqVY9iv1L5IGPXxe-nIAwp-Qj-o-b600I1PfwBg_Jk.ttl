@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAncqVY9iv1L5IGPXxe-nIAwp-Qj-o-b600I1PfwBg_Jk/> .

<https://w3id.org/iadopt/variable/ReproductionRate> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Reproduction rate (offspring per female)",
        "reproduction rate in exposed invertebrate organism" ;
    dcterms:description "the number of offspring produced per female over a defined period." ;
    rdfs:seeAlso <http://purl.obolibrary.org/obo/GSSO_006828> ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:ReproductionRate .

