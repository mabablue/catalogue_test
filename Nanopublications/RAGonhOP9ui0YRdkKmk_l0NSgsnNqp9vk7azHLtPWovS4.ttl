@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAGonhOP9ui0YRdkKmk_l0NSgsnNqp9vk7azHLtPWovS4#> .

sub:variable9 a iop:Variable ;
    rdfs:label "Foliage projective cover" ;
    dcterms:description "The proportion of the ground area covered by foliage (or photosynthetic tissue) held in a vertical plane. Foliage Projective Cover is usually expressed as the percentage of ground covered by foliage and can be separated according to vegetation strata." ;
    iop:hasMatrix <https://agroportal.lirmm.fr/ontologies/CGO/Ground> ;
    iop:hasObjectOfInterest <https://agroportal.lirmm.fr/ontologies/AGROVOC/c_36752> ;
    iop:hasProperty <https://agroportal.lirmm.fr/ontologies/CGO/Coverage> .

