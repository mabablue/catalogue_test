@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAA3fjlZtYshkPxL43_VoZA8-DB1gBU2a9z3p2bo92rwQ/> .

<https://w3id.org/iadopt/variable/DopingLevel> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Doping level",
        "doping level of material" ;
    dcterms:description "the concentration or fraction of intentionally introduced impurity atoms or ions (dopants) incorporated into a host material to modify its properties." ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:DopingConcentration .

