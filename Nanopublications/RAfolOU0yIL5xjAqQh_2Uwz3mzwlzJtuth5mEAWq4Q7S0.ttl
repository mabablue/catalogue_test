@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAfolOU0yIL5xjAqQh_2Uwz3mzwlzJtuth5mEAWq4Q7S0/> .

<https://w3id.org/iadopt/variable/Neuropathology> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Neuropathology",
        "neuropathology in exposed animal" ;
    dcterms:description "morphological and other aspects of diseases of the nervous system." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/CSP/4007-0086> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:neuropathologicalFindings .

