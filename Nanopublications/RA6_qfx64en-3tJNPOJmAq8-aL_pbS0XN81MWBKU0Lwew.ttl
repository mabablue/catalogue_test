<https://w3id.org/iadopt/variable/D14> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "The average coordination parameter (3Ang) of all atoms" ;
    dcterms:description "D14: The average coordination parameter (3Ang) of all nanoparticle atoms" ;
    iop:hasObjectOfInterest sub:NPAtomAverageCoordination ;
    iop:hasProperty sub:Coordination .

