@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RA5rgYMT0KmttwziDDbtBJQtQ3aJ-x4BWJhGHlmLMOIaA/> .

<https://w3id.org/iadopt/variable/LarvalAbnormalities> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Larval abnormalities",
        "larval abnormalities in exposed invertebrate organism larva" ;
    dcterms:description "structural or functional defects observed in larval organisms following exposure." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/Q000002> ;
    iop:hasObjectOfInterest sub:invertebrateOrganismLarva ;
    iop:hasProperty sub:LarvalAbnormalities .

