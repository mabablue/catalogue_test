@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAKqt1f9DpR0R7hOsPMau08d02wcFOeaOILxg7H-oIw6M/> .

<https://w3id.org/iadopt/variable/Bilirubin> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Bilirubin",
        "bilirubin concentration in blood" ;
    dcterms:description "A bile pigment that is a degradation product of HEME." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D001663> ;
    iop:hasObjectOfInterest sub:testanimal ;
    iop:hasProperty sub:bilirubinLevel .

