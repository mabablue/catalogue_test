@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RADi2yzrIF085My9dF_DR8EbLFvBn30axqRQ2sVmfExrQ/> .

<https://w3id.org/iadopt/variable/Matrix> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Background matrix",
        "Matrix" ;
    dcterms:description "The medium in which the actual Object Of Interest is mixed, embedded, suspended, or entailed in some way - such that a process is required to extract or separate it before an observation can be made" ;
    iop:hasObjectOfInterest sub:Medium ;
    iop:hasProperty <http://vocabs.lter-europe.net/EnvThes/10003> .

