@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAhNtKUmeHsfwI7ozYC0PTBfScxWjxDPDkYYbT-TKbKE4/> .

<https://w3id.org/iadopt/variable/AtomicWeightActiveMetalloid> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Atomic weight of Active Metalloid" ;
    dcterms:description "The relative atomic mass (of elements from natural, stable, terrestrial sources that are exerting influence or producing an effect that are attributed to materials that are exerting influence or are producing an effect and are from elements with properties between a metal and a non-metal" ;
    iop:hasObjectOfInterest sub:Metalloid ;
    iop:hasProperty sub:AtomicWeight .

