@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAfxFXDECMcaXk5Kole4nrcZeNqHr8NSogfujAE3MEcjI/> .

<https://w3id.org/iadopt/variable/ROSgeneration> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "ROS generation",
        "ROS generation in cells" ;
    dcterms:description "the production of reactive oxygen species within cells following exposure to a substance." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:ROSlevel .

