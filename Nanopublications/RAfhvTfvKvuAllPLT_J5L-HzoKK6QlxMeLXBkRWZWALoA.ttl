@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAfhvTfvKvuAllPLT_J5L-HzoKK6QlxMeLXBkRWZWALoA/> .

<https://w3id.org/iadopt/variable/Activity/locomotion> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Activity/locomotion",
        "activity/locomotion in exposed organism" ;
    dcterms:description "the measurement of spontaneous movement and general activity levels of organisms, used to assess behavioral and welfare status." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/MESH/D008124> ;
    iop:hasObjectOfInterest sub:testorganism ;
    iop:hasProperty <https://w3id.org/np/RAfhvTfvKvuAllPLT_J5L-HzoKK6QlxMeLXBkRWZWALoA/activity/locomotionLevel> .

