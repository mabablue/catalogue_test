@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAgm01WsCnI01E0fmy2QaK6gCP2l4WAcuwlO_0Z4emYZ0/> .

<https://w3id.org/iadopt/variable/SurfaceCoating> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Surface coating",
        "surface coating of material" ;
    dcterms:description "a layer of material applied to a surface to modify its properties." ;
    rdfs:seeAlso <http://purl.bioontology.org/ontology/npo#NPO_1962> ;
    iop:hasObjectOfInterest sub:Materials ;
    iop:hasProperty sub:SurfaceCoatingType .

