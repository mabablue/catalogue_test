@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RASJpb6RrsTQhN2Lp-L5BH--dGwvE4xtwqHfTTz2W_FFs/> .

<https://w3id.org/iadopt/variable/ChromatographicRetentionIndex> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Chromatographic retention index",
        "chromatographic retention index of substance" ;
    dcterms:description "a dimensionless numerical index that describes the relative retention of a chemical compound on a chromatographic column under defined conditions, referenced to the retention of a homologous series of standard compounds." ;
    rdfs:seeAlso <https://www.sciencedirect.com/science/article/abs/pii/S0003267020312368> ;
    iop:hasObjectOfInterest sub:substance ;
    iop:hasProperty sub:ChromatographicRetentionIndex .

