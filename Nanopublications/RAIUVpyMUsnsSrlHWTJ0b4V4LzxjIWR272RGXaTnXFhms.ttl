@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAIUVpyMUsnsSrlHWTJ0b4V4LzxjIWR272RGXaTnXFhms/> .

<https://w3id.org/iadopt/variable/CYPinhibition> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "CYP inhibition",
        "CYP inhibition level in cells" ;
    dcterms:description "the reduction in activity of cytochrome P450 enzymes caused by exposure to a substance." ;
    iop:hasObjectOfInterest sub:cell ;
    iop:hasProperty sub:CYPinhibition .

