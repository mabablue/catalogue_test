@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RARAgtZxqcvBg18j64syoS7hvXeKQCXbqhvhqs6Po-KtQ/> .

<https://w3id.org/iadopt/variable/Odour> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Odour" ;
    dcterms:description "the property of a substance that gives it a characteristic scent or smell." ;
    iop:hasObjectOfInterest sub:Chemicals ;
    iop:hasProperty <http://www.co-ode.org/ontologies/galen#Odour> .

