@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RAfwt6H_yDznZEZziOr2GCZzhQ6vJB-lOelEQuEavDVgo/> .

<https://w3id.org/iadopt/variable/MoltingInhibition> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Molting inhibition",
        "molting inhibition in exposed invertebrate organism" ;
    dcterms:description "the reduction or disruption of normal molting processes due to toxic exposure." ;
    iop:hasObjectOfInterest sub:invertebrateOrganism ;
    iop:hasProperty sub:MoltingInhibition .

