<https://w3id.org/iadopt/variable/Granuloma/foreignBodyReaction> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Granuloma / foreign body reaction",
        "granuloma/foreign body reaction in tissue" ;
    dcterms:description "Histiocytic, inflammatory response to a foreign body. It consists of modified macrophages with multinucleated giant cells, in this case foreign-body giant cells" ;
