@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix iop: <https://w3id.org/iadopt/ont/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sub: <https://w3id.org/np/RABSPBCZvcsvWVRGGxvwPcYYCG7GKXzIC2hxv-Ao2tvCY/> .

<https://w3id.org/iadopt/variable/RootArchitectureTraits> a owl:NamedIndividual,
        iop:Variable ;
    rdfs:label "Root architecture traits",
        "root architecture traits of plant" ;
    dcterms:description "characteristics describing the spatial configuration and structural organization of a plant’s root system." ;
    iop:hasObjectOfInterest sub:Plant ;
    iop:hasProperty sub:RootSystemArchitecture .

